  state {
    id			    108
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    107
    treeNode		    [107 0 0 0]
    superState		    SUBCHART
    subviewer		    107
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [position, task_status, robot_enabled]  = fcn(use_dom_hand, kinarm_data, run_status, sca"
      "ling)\n%\n% get current hand position and robot enabled status\n%\n% May 2009\n%\n\nhpx_index = 23;\nhpy_index ="
      " 24;\nrobot_disabled_index = 37;\n\n%determine which arm to apply the load to\ndominant_hand=kinarm_data(3,1);		"
      "				%kinarm_data(3,1) tells which arm is the dominant arm\nif use_dom_hand == 1\n	feedback_arm = dominant_hand;\n"
      "else\n	feedback_arm = 3 - dominant_hand;\nend\n\nhpx = kinarm_data( feedback_arm, hpx_index );\nhpy = kinarm_dat"
      "a( feedback_arm, hpy_index );\nposition = [hpx hpy];\n\nif kinarm_data( feedback_arm, robot_disabled_index ) == "
      "0;\n    robot_enabled = 1;\nelse\n    robot_enabled = 0;\nend\n\n% if the task has stopped/paused (i.e. run_stat"
      "us == 0) AND the torques outputs\n% have scaled down to 0, then set the task_status = 0.\nif run_status == 0 && "
      "scaling(feedback_arm) == 0\n    task_status = 0;\nelse\n    task_status = 1;\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
