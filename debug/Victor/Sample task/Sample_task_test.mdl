  chart {
    id			    154
    name		    "Draw_Hand_Endpoint/MATLAB Function"
    windowPosition	    [357.331 483.407 167 391]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1280 1024 1.041050272174191]
    treeNode		    [0 155 0 0]
    firstTransition	    170
    firstJunction	    169
    viewObj		    154
    machine		    1
    ssIdHighWaterMark	    20
    decomposition	    CLUSTER_CHART
