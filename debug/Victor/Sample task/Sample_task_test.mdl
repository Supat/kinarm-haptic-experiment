  chart {
    id			    127
    name		    "Trajectory subsystem/KINARM_EP_Position_Controller/FF_FB_Position_Controller"
    windowPosition	    [602 368.75 213 385]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1920 1080 1.333333333333333]
    treeNode		    [0 128 0 0]
    firstTransition	    142
    firstJunction	    141
    viewObj		    127
    machine		    1
    ssIdHighWaterMark	    45
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
