  chart {
    id			    144
    name		    "Trajectory subsystem/KINARM_EP_Position_Controller/Get_kinematics_EP/xy_to_segment_angles_EP"
    windowPosition	    [610 368.75 213 385]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1920 1080 1.333333333333333]
    treeNode		    [0 145 0 0]
    firstTransition	    152
    firstJunction	    151
    viewObj		    144
    machine		    1
    toolbarMode		    LIBRARY_TOOLBAR
    ssIdHighWaterMark	    8
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    firstData		    146
    chartFileNumber	    10
