	      xPCTaskExecutionProfile off
	      xPCRL32EventNumber      "5000"
	      RL32IRQSourceModifier   "Timer"
	      xPCIRQSourceBoard	      "None/Other"
	      xPCIOIRQSlot	      "-1"
	      xpcDblBuff	      off
	      xpcObjCom		      off
	      xPCGenerateASAP2	      off
	      xPCGenerateXML	      off
	      RL32ObjectName	      "tg"
	      xPCisDownloadable	      off
	      xPCisDefaultEnv	      on
	      xPCisModelTimeout	      on
	      xPCModelTimeoutSecs     "5"
	      xPCLoadParamSetFile     off
	      xPCConcurrentTasks      off
	      xPCEnableSFAnimation    off
	    }
	    PropName		    "Components"
	  }
	}
	PropName		"Components"
      }
