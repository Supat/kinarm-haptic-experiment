  state {
    id			    79
    labelString		    "on_ramp/\nentry: tick = 0;    // initialize the tick counter\nreset_controller = 0;\nfinal_pos ="
    " target_pos;   // set the final position of the trajectory\nstart_pos = virt_pos;   // set the start position of t"
    "he trajectory\nduration = input_duration;   // store the duration of the trajectory\ntraj_status = 1;   // indicat"
    "e an ongoing trajectory\n\nduring:\non e_clk: tick++;\n// the trajectory velocity will have a bell shaped profile\n"
    "trajectory_shape = tick/duration-sin(2*pi*tick/duration)/(2*pi);\nvirt_pos[1] = start_pos[1] + (final_pos[1] - sta"
    "rt_pos[1]) * trajectory_shape;\nvirt_pos[2] = start_pos[2] + (final_pos[2] - start_pos[2]) * trajectory_shape;"
    position		    [445.4443 479.4773 676.2563 306.5752]
    fontSize		    12
    chart		    77
    treeNode		    [80 0 83 0]
    subviewer		    77
