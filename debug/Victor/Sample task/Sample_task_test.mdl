  state {
    id			    128
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    127
    treeNode		    [127 0 0 0]
    superState		    SUBCHART
    subviewer		    127
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [Force_FB, Force_FF] = fcn(use_dom_hand, kinarm_data, setpoint_angles, setpoint_vel, set"
      "point_acc, Secondary_Encoders_Used, inertia_option_for_FF, primary_encoder_data, gain_choice, ForceOn)\n% This b"
      "lock supports the Embedded MATLAB subset.\n% See the help menu for details. \n% set point is joint angles in glo"
      "bal coordinates\n\n% inertia_option_for_FF sets the options for which inertias to include for \n% the feed-forwa"
      "rd model\n%	0 - none\n%	1 - KINARM robot only\n\n% gain_choice sets the options for which proportional gains to "
      "use for the\n% controller (does not affect the gains when secondary encoders are used)\n%	1 - Standard Movement "
      " == Highest stiffness. For primary encoders only, this is quite underdamped.\n%	2 - Step Response == Reduced ove"
      "rshoot for primary encoders only, and lower stiffness.  Same as above for secondary encoders.\n\n%{\nL1_index = "
      "1;				% L1 (m)\nL2_index = 2;				% L2(m)\nORIENT_index = 6;			% 1=right	2=left\nL1Ang_index = 17;			% L1 angle\n"
      "L2Ang_index = 18;			% L2 Angle\nL1Vel_index = 19;			% L1 angle\nL2Vel_index = 20;			% L2 Angle\n\nForce_FF = [0 "
      "0 0 0];\nForce_FB = [0 0 0 0];\n%}\n\n%determine which arm to apply the load to\ndominant_hand=kinarm_data(3,1);"
      "						%kinarm_data(3,1) tells which arm is the dominant arm\nif use_dom_hand==1\n	arm=dominant_hand;\nelse\n	arm"
      "=3-dominant_hand;\nend\n\n%{\n\nL1 = kinarm_data( arm, L1_index );\nL2 = kinarm_data( arm, L2_index );\nL1Ang = "
      "kinarm_data( arm, L1Ang_index );\nL2Ang = kinarm_data( arm, L2Ang_index );\nL1Vel = kinarm_data( arm, L1Vel_inde"
      "x );\nL2Vel = kinarm_data( arm, L2Vel_index );\ntheta=[L1Ang; L2Ang];\nthetavel=[L1Vel; L2Vel];\ntheta_primary ="
      " primary_encoder_data(arm, 1:2)';\nthetavel_primary = primary_encoder_data(arm, 3:4)';\n\n% Proportional Gain\ni"
      "f gain_choice == 1         %If the \"standard movement\" gain choice is selected:\n    Kp = [200 0; 0 200];	%pro"
      "portional gain for KINARM EP robot, primary encoders only - high stiffness\nelse\n    Kp = [85 0; 0 85];		%propo"
      "rtional gain for KINARM EP robot, primary encoders only - reduced overshoot\nend\nKp_1 = [0 0; 0 0];			%proporti"
      "onal gain for KINARM EP robot, primary encoders if used in conjunction with secondary\nKp_2 = [1 0; 0 1];		%prop"
      "ortional gain for KINARM EP robot, secondary encoders if used in conjunction with primary\n\n% Derivative gain\n"
      "Kv = [3.5 0; 0 3.5];		% Derivative gain for KINARM EP robot, primary encoders only				\nKv_1 = [2.5 0; 0 2.5];		"
      "% Derivative gain for KINARM EP robot, primary encoders if used in conjunction with secondary\nKv_2 = [6 0; 0 6]"
      ";          % Derivative gain for KINARM EP robot, secondary encoders if used in conjunction with primary	\n\n\n\n"
      "error = setpoint_angles - theta;\nerror_vel = setpoint_vel - thetavel;\n\nerror_primary = setpoint_angles - thet"
      "a_primary;\nerror_vel_primary = setpoint_vel - thetavel_primary;\n\n% THE FOLLOWING ARE TYPICAL VALUES FOR THE K"
      "INARM End Point robot (Rev1)\nI1_prox		= 0.018;			%inertia of KINARM segment 1, kg-m^2 at shoulder\nI2_5_prox	= "
      "0.034;			%inertia of KINARM segments 2&5, kg-m^2 at elbow\nI3_prox		= 0.014;			%inertia of KINARM segment 3, kg-"
      "m^2 at elbow\nI4_prox		= 0.022;			%inertia of KINARM segment 4, kg-m^2 at shoulder\nIm1 = 0.0047;			%inertia of "
      "motor 1, after 6x gear ratio, kg-m^2\nIm2 = 0.0047;			%inertia of motor 2, after 6x gear ratio, kg-m^2\nM2 = 0.6"
      "2;				%mass of KINARM segment2 and 5 (kg)\nM4 = 0.80;				%mass of segment 4 (kg)\nL3 = 0.187;				%crank length ("
      "m)\ndelta = 0;				%0 degrees, angle between segments 2 and 5\nx2 = 0.20;				%center of mass of segments 2+5 (m)\n"
      "x4 = 0.12;				%center of mass of segment 4 (m)\n\n\n\ntheta2_1 = setpoint_angles(2) - setpoint_angles(1);\nsin21"
      " = sin(theta2_1);\ncos21 = cos(theta2_1);\nsin51 = sin(theta2_1 - delta);\ncos51 = cos(theta2_1 - delta);\n\n% T"
      "he following equations implement the equations of motion for the KINARM robot\n% For simplicity, we have ignored"
      " the off-axis components of inertia due to their\n% negligible contributions\nA = I1_prox + I4_prox + Im1 + M2*L"
      "1^2;\nB = M2*L1*(x2*cos21) + M4*L3*(x4*cos51);\nD = I2_5_prox + I3_prox + Im2 + M4*L3^2;\nC = M2*L1*(x2*sin21) +"
      " M4*L3*(x4*sin51);\n\nM = [A B; B D];	%inertial matrix\nCC = [0 -C; C 0] * diag(setpoint_vel);	%coriolis and cen"
      "tripetal forces\n\nif inertia_option_for_FF == 0;			%no feed-forward control\n	TRQ_FF = [0; 0];\nelse\n	TRQ_FF ="
      " M*setpoint_acc + CC*setpoint_vel;\nend\n\nif Secondary_Encoders_Used(arm) == 0\n	% Only use primary encoder fee"
      "dback\n	TRQ_FB = Kp*error + Kv*error_vel;\nelse\n	% Use both primary and secondary encoders - note: secondary en"
      "coder information under these conditions is contained error and error_vel\n	TRQ_FB = Kp_2*error + Kv_2*error_vel"
      " + Kp_1*error_primary + Kv_1*error_vel_primary;\nend\n\n%convert torques (applied to links) to forces (applied a"
      "t end-point);\nA1 = -L1*sin(L1Ang);\nA2 = L1*cos(L1Ang);\nA3 = -L2*sin(L2Ang);\nA4 = L2*cos(L2Ang);\n\nF_FF = [A"
      "1 A2; A3 A4] \\ TRQ_FF;\nF_FB = [A1 A2; A3 A4] \\ TRQ_FB;\n%}\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
      "%%%%%%%%%%%%%%%%%%%%%%%%%%%%\nxPos = kinarm_data(arm,23);\nyPos = kinarm_data(arm,24);\nxVel = kinarm_data(arm,2"
      "5);\nyVel = kinarm_data(arm,26);\n\n\n\n% FINAL FORCE CHECK\nif ForceOn==1\n    % Send force\n    F_FB = [0; 0];"
      " % SET WHEN EVERYTHING IS OKAY\n    %F_FB = [0; 0]; % do not send force yet\nelse\n    % No force\n    F_FB = [0"
      "; 0];\nend\nF_FF = [0; 0];\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n\n\n%"
      " Flatten any bad values to 0.\nif F_FF(1) ~= F_FF(1)\n    F_FF(1) = 0;\nend\n\nif F_FF(2) ~= F_FF(2)\n    F_FF(2"
      ") = 0;\nend\n\nif F_FB(1) ~= F_FB(1)\n    F_FB(1) = 0;\nend\n\nif F_FB(2) ~= F_FB(2)\n    F_FB(2) = 0;\nend\n\n%"
      "apply the forces to the correct arm \nif arm==1\n	Force_FF = [F_FF' 0 0];\n	Force_FB = [F_FB' 0 0];\nelse\n	Forc"
      "e_FF = [0 0 F_FF'];\n	Force_FB = [0 0 F_FB'];\nend\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
