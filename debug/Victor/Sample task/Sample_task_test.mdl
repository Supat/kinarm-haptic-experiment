	    Annotation {
	      SID		      "174"
	      Name		      "The Virtual_Trajectory block creates bell-shaped profile virtual trajectory.  \nThe output is a ti"
	      "me-varying (x,y) position ('virtual_position').  \n\nThe trajectory position starts at the current virtual_posi"
	      "tion output and ends at the target_position.  \nThe trajectory is initiated with the e_start input and lasts fo"
	      "r a duration specified by the duration input.\n\nTo change the current virtual position to the reset_position i"
	      "nput, a rising-edge event needs to be sent to the e_reset_vp input \n(i.e. this can be useful for position cont"
	      "rol, with the Run_Status wired into the e_reset input).  \nIf such an event occurs during a virtual trajectory,"
	      " the trajectory is halted immediately."
	      Position		      [534, 93]
	      HorizontalAlignment     "left"
	      ZOrder		      -1
	    }
