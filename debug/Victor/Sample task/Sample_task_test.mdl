	Annotation {
	  SID			  "243:22"
	  Name			  "The state index matrix needs to get padded because \nsome target types are bigger than others (i.e. longe"
	  "r row)\nand the Embedded Matlab function does not like it when you\n 'might' reference indices that are larger than"
	  " the matrix.\n\nThe number of columns of padding is changed based on target\ntype, because Simulink requires all in"
	  "stances of the embedded\nMatlab function to have the same size input to 'stateindices'."
	  Position		  [28, 75]
	  HorizontalAlignment	  "left"
