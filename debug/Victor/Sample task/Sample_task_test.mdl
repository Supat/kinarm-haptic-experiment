    eml {
      isEML		      1
      script		      "function [HandAtStart,xStart,yStart,xEnd,yEnd,HandVelX,HandVelY] = Hand_at_start(SET_EXP_PARAMS1,"
      " KINdata)\n\n% Position of robot during whole task\nxStart = SET_EXP_PARAMS1(1);\nyStart = SET_EXP_PARAMS1(2);\n"
      "\nxEnd = SET_EXP_PARAMS1(3);\nyEnd = SET_EXP_PARAMS1(4);\n\n% Start and end radius of movement\nStartRadius = SE"
      "T_EXP_PARAMS1(5);\n\n% Check to see if hand or tool endpoint is in target\nHandPosX = KINdata(1,23);\nHandPosY ="
      " KINdata(1,24);\nHandVelX = KINdata(1,25);\nHandVelY = KINdata(1,26);\n\n% Is hand inside (xInit,yInit)?\nHandAt"
      "Start = double(sqrt((HandPosX-xStart)^2+(HandPosY-yStart)^2)<StartRadius);\n\n\n\n\n\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
