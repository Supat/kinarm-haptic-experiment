	    Callback		    "% Show or hide the opacity input on the mask dialog\nsourceStr=get_param(gcb,'source');\nvis=get_p"
	    "aram(gcb,'MaskVisibilities');\n\nif strmatch(sourceStr, 'dialog')\n	vis{10}='on';\nelse\n	vis{10}='off';\nend\n\n"
	    "set_param(gcb,'MaskVisibilities',vis);\n"
