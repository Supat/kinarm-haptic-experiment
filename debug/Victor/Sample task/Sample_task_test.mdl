  state {
    id			    53
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    52
    treeNode		    [52 0 0 0]
    superState		    SUBCHART
    subviewer		    52
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [CursorOpacity,TrialTimeOut] = calculate_stuff(trial_state,OpacityGradient)\n\ndt = 0.00"
      "05;\n\npersistent trial_state_record; persistent TrialTime;\nif isempty(trial_state_record), trial_state_record="
      "0; TrialTime=0; end\n\nif trial_state~=1\n    % Timer is zero besides during task\n    TrialTime = 0;\nend\nif t"
      "rial_state_record==0 && trial_state==1\n    % Reset time after trial begins\n    TrialTime = 0;\nend\n\n% Calcul"
      "ate opacity\nCursorOpacity = max(0,100*(1-TrialTime/OpacityGradient));\n\n% Increment timer\nTrialTime = TrialTi"
      "me+dt;\n\n% Output variables\nTrialTimeOut = TrialTime;\n\n% Record variable\ntrial_state_record = trial_state;\n"
      "\n\n\n\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
