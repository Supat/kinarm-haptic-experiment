  state {
    id			    155
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    154
    treeNode		    [154 0 0 0]
    superState		    SUBCHART
    subviewer		    154
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function VCODE = fcn(target, state_in, target_type, opacity_in, target_display, x_index, y_index,"
      " num_states, stateindices, target_labels, KINData, CursorOpacity)\n\n% stateindices should follow this order (de"
      "pending on target-type):\n% 1: length of tool (m)\n% 2: stroke colour\n% 3: stroke width\n% 4: major radius / ra"
      "dius / start point (line)\n% 5: minor radius / end point (line)\n% 6: orientation angle\n\n\n\n% VCODEs are leng"
      "th 70. All units in a VCODE should be SI, e.g. (m) and (rad). Elements in a VCODE are defined as follows:\n%\n% "
      "For all target types:\n%  1: target type\n%       1 - circle\n%       2 - ellipse\n%       3 - rectangle\n%     "
      "  4 - line\n%       5 - triangle\n%       11 - circle with label\n%       12 - ellipse with label\n%       13 - "
      "rectangle with label\n%       14 - line with label\n%       15 - triangle with label\n%  2: target on/off status"
      " and target display (which display target will appear on)\n%		0 - off\n%		1 - on, appearing on both subject and "
      "operator displays\n%       2 - on, appearing on subject display only\n%       3 - on, appearing on operator disp"
      "lay only\n%  3: x position (m)\n%  4: y position (m)\n%  5: fill colour (RRGGBB) or texture index\n%  6: stroke "
      "colour (RRGGBB) or texture index\n%  7: stroke width\n%  8: reserved for target background ID\n%  9: opacity\n%\n"
      "% For circles:\n%  10: radius (m)\n%\n% For ellipses:\n%  10: major radius (m)\n%  11: minor radius (m)\n%  12: "
      "orientation of major axis (rad)\n%\n% For rectangles:\n%  10: length (m)\n%  11: height (m)\n%  12: orientation "
      "(rad) (relative to x, y already shown)\n%\n% For lines:\n%  10: endpoint x-axis coordinate relative to start poi"
      "nt (m)\n%  11: endpoint y-axis coordinate relative to start point (m)\n%\n% For triangles:\n%  10: length (m)\n%"
      "  11: height (m)\n%  12: offset of peak from midpoint of length (m)\n%  13: orientation (rad)\n%\n% For all labe"
      "lled target types:\n%  14: reserved\n%  15-64: label characters (indexes in ISO 8859-1 character set)\n%  65: la"
      "bel colour (0xRRGGBB), opacity is set by the vcode's opacity (9).\n%  66: label height (m)\n%  67: reserved\n%  "
      "68: reserved\n%  69: reserved\n%  70: reserved\n\nnum_targets = size(target, 1);\n\n% NOTE: we assume that the S"
      "TATE and/or OPACITY inputs are vectors. \n\n% If the length of the input STATE is not the same as the number of "
      "targets then make STATE a column vector of the same length as \n% the TARGET input, using the first STATE (i.e. "
      "all targets get the same state) \nif num_targets == length(state_in)\n	state = reshape(state_in, num_targets, 1)"
      ";\nelse\n	state = state_in(1) * ones(num_targets, 1);\nend\n\n\n% If the length of the input OPACITY is not the "
      "same as the number of targets then make OPACITY a column vector of the same length as\n% the TARGET input, using"
      " the first OPACITY (i.e. all targets get the same opacity) \nif num_targets == length(opacity_in)\n	opacity = re"
      "shape(opacity_in, num_targets, 1);\nelse\n	opacity = opacity_in(1) * ones(num_targets, 1);\nend\n\n\n% Clamping "
      "the opacity to [0, 100].\nopacity = min(opacity, 100);\nopacity = max(opacity, 0);\n\nVCODE = zeros(num_targets,"
      " 70);\n\n% Set the target type. Targets with labels have type codes 10 greater than their unlabelled counterpart"
      "s.\nVCODE(:, 1) = target_type + 10;\n\n% Set the hand position.\nVCODE(:, 3) = KINData(1,23);  % x position (m)\n"
      "VCODE(:, 4) = KINData(1,24);  % y position (m)\n\nfor ii = 1:num_targets\n	% Set the target on/off state. If the"
      " state input is 0, the target is off. Users of the VCODE should respect this\n	% as an indication that the rest "
      "of the VCODE will be uninitialized.\n	if (state(ii) <= 0) || (state(ii) > num_states)\n		VCODE(ii, 2) = 0;  % ta"
      "rget is off\n	else\n		VCODE(ii, 2) = target_display;  % Default is that target is on; target displays as specifi"
      "ed by block mask\n	end\n\n	fill_colour_col = stateindices(state(ii), 1);\n	stroke_colour_col = stateindices(stat"
      "e(ii), 2);\n	stroke_width_col = stateindices(state(ii), 3);\n	\n	% Set the fill colour. Fill colour currently co"
      "mes from the GUI in RRRGGGBBB format.\n	if fill_colour_col == 0\n		VCODE(ii, 5) = -2^31;\n	elseif target(fill_co"
      "lour_col) < 0\n		VCODE(ii, 5) = target(ii, fill_colour_col);\n	else\n		VCODE(ii, 5) = colourshift(target(ii, fil"
      "l_colour_col));\n	end\n	\n	% Set the stroke colour. Stroke colour currently comes from the GUI in RRRGGGBBB form"
      "at.\n	if stroke_colour_col == 0\n		VCODE(ii, 6) = -2^31;\n	elseif target(stroke_colour_col) < 0\n		VCODE(ii, 6) "
      "= target(ii, stroke_colour_col);\n	else\n		VCODE(ii, 6) = colourshift( target(ii, stroke_colour_col) );\n	end\n\n"
      "	% Set the stroke width. if target table index for stroke width is zero, then the stroke width is undefined\n	if"
      " stroke_width_col == 0\n		VCODE(ii, 7) = 0;                   % if stroke width column is 0, then stroke width i"
      "s 0\n	elseif stroke_width_col < 0\n		VCODE(ii, 7) = 0.001;               % if stroke width column is -ve, then a"
      " 1mm default is chosen\n	else\n		VCODE(ii, 7) = target(ii, stroke_width_col) * 0.01;  % if stroke width column i"
      "s +ve, convert width from (cm) in target table to (m)\n	end\n\n	% Set the opacity value\n	VCODE(ii, 9) = CursorO"
      "pacity;\n\n	% Set attributes specific to each target type. In the process, note the first state vector column us"
      "ed for label information.\n	label_index = 1;\n\n	% Set attributes specific to each target type.\n	if target_type"
      " == 1\n\n		% Handle circle target:\n		radius_col = stateindices(state(ii), 4);\n		VCODE(ii, 10)=target(ii, radiu"
      "s_col);  % radius (convert from (cm) in target table to (m))\n	    label_index = 5;\n\n	elseif target_type == 2 "
      "|| target_type == 3\n\n	    % Handle ellipse or rectangle target:\n		major_col = stateindices(state(ii), 4);\n		"
      "minor_col = stateindices(state(ii), 5);\n		orientation_col = stateindices(state(ii), 6);\n		\n		VCODE(ii, 10) = "
      "target(ii, major_col) * 0.01;  % major radius (convert from (cm) in target table to (m))\n		VCODE(ii, 11) = targ"
      "et(ii, minor_col) * 0.01;  % minor radius (convert from (cm) in target table to (m))\n		if orientation_col == 0\n"
      "			VCODE(ii, 12) = 0;  % if orientation column is 0, set orientation to 0 rad\n		else\n			VCODE(ii, 12) = mod(ta"
      "rget(ii, orientation_col), 360) * pi / 180.0;  % orientation (convert from (degrees) in target table to (rad))\n"
      "		end\n	    label_index = 7;\n	\n	elseif target_type == 4\n\n		% Handle line target:\n		%xendpoint_col = statein"
      "dices(state(ii), 4);\n		%yendpoint_col = stateindices(state(ii), 5);\n		VCODE(ii, 10) = 0;  % line endpoint in x"
      " axis, relative to start (m)\n		VCODE(ii, 11) = stateindices(state(ii), 1);  % line endpoint in y axis, relative"
      " to start (taken from Target Table)\n	    label_index = 6;\n\n	elseif target_type == 5\n\n		% Handle triangle ta"
      "rget:\n		length_col = stateindices(state(ii), 4);\n		height_col = stateindices(state(ii), 5);\n		offset_col = st"
      "ateindices(state(ii), 6);\n		orientation_col = stateindices(state(ii), 7);\n\n		VCODE(ii, 10) = target(ii, lengt"
      "h_col) * 0.01;  % length (convert from (cm) in target table to (m))\n\n		% If the height column is set to 0 then"
      " the triangle is automatically made equilateral, with the base length used as length\n		% for all sides. If the "
      "height column is non-zero, separate values for height and peak offset are taken from the target table.\n		if hei"
      "ght_col == 0\n			VCODE(ii, 11) = sin(pi / 3.0) * VCODE(ii, 10);  % height for equilateral triangle\n			VCODE(ii,"
      " 12) = 0;                          % peak offset for equilateral triangle\n		else\n			VCODE(ii, 11) = target(ii,"
      " height_col) * 0.01;  % height (convert from (cm) in target table to (m))\n			VCODE(ii, 12) = target(ii, offset_"
      "col) * 0.01;  % peak offset (convert from (cm) in target table to (m))\n		end\n\n		if orientation_col == 0\n			V"
      "CODE(ii, 13) = 0;  % if orientation column is 0, set orientation to 0 rad\n		else\n			VCODE(ii, 13) = mod(target"
      "(ii, orientation_col), 360) * pi / 180.0;  % orientation (convert from (degrees) in target table to (rad))\n		en"
      "d\n	    label_index = 8;\n		\n	end\n	\n	% Copy the label characters to the VCODE.\n	for jj = 1:50\n		VCODE(ii, j"
      "j + 14) = target_labels( target( ii, stateindices(state(ii), label_index) ), jj );\n	end\n\n	% Set the label col"
      "our. Like other colours, label colour comes from the GUI in RRRGGGBBB format and is converted to a 32-bit\n	% 0x"
      "RRGGBB value here. If the target column table index for the colour is 0, the label is transparent.\n	if stateind"
      "ices(state(ii), label_index + 1) == 0\n		VCODE(ii, 65) = -2^31;\n	elseif target( ii, stateindices(state(ii), lab"
      "el_index + 1) ) < 0\n		VCODE(ii, 65) = target( ii, stateindices(state(ii), label_index + 1) );\n	else\n		VCODE(i"
      "i, 65) = colourshift( target( ii, stateindices(state(ii), label_index + 1) ) );\n	end\n\n	% Set the label height"
      ". Label height is converted from (cm) in the target table to (m).\n	VCODE(ii, 66) = target( ii, stateindices(sta"
      "te, label_index + 2) ) * 0.01;\n\n\n	\nend\n\n% The colourshift function converts an \"RRRGGGBBB\" colour value "
      "to RRGBB (as an uint32).\nfunction RRGGBBAA = colourshift(RRRGGGBBB)\n\n%this is \"no fill\"\nif RRRGGGBBB == 10"
      "00000000\n    RRGGBBAA = cast(16777216, 'uint32'); %hex 0x1000000\n    return; \nend\n\nblue = cast(mod(RRRGGGBB"
      "B, 1000), 'uint32');\ngreen = cast(mod(RRRGGGBBB - blue, 1000000) / 1000, 'uint32');\nred = cast((RRRGGGBBB - (g"
      "reen * 1000) - blue) / 1000000, 'uint32');\n\nRRGGBBAA = bitshift(red, 16) + bitshift(green, 8) + blue;\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
