  state {
    id			    145
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    144
    treeNode		    [144 0 0 0]
    superState		    SUBCHART
    subviewer		    144
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function SEGMENT_ANG  = fcn(use_dom_hand, kinarm_data, u, robot_calib)\n\n% This function convert"
      "s an endpoint finger-tip position or local joint angle (shoulder, elbow) \n% to (L1Ang, L2Ang) angles for a KINA"
      "RM robot where L1Ang and L2Ang are the global angles of L1 and L2  \n% Note: these equations were taken from a s"
      "ource which defined theta1 as the global angle of L1 (i.e. theta1 = L1Ang\n% and L2_L1Ang = local angle of L2 WR"
      "T L1 (but always in a R.H. coordinate frame).  So L2_L1Ang = L2Ang - L1Ang.\n% Also note that we need to correct"
      " for L2_ptr\n\n% angles_or_XY sets the options for which coordinate system to use\n%	1 - (x, y) coordinates\n%	2"
      " - local coordinate joint angles (shoulder, elbow)\n\n% NEED TO GET SHOULDER AND ELBOW ANGLE OFFSETS FROM CALIBR"
      "ATION WHEN THESE BECOME AVAILABLE.\n% For the KINARM End-Point robot I have assumed certain values, which will h"
      "old unless the robot\n% is mounted at an angle relative to global.\n% Need to decide how to deal with this for t"
      "he Exoskeleton lab.\n\nL1_index = 1;				% L1 (m)\nL2_index = 2;				% L2(m)\nL2ptr_index = 3;			% L2ptr(m)\nSHO_O"
      "RIGIN_X_index = 4;		% shoulder origin, x position\nSHO_ORIGIN_Y_index = 5;		% shoulder origin, y position\nORIEN"
      "T_index = 6;			% 1=right	2=left\n\n\n%determine which arm to apply the load to\ndominant_hand=kinarm_data(3,1);	"
      "					%kinarm_data(3,1) tells which arm is the dominant arm\nif use_dom_hand==1\n	arm=dominant_hand;\nelse\n	arm="
      "3-dominant_hand;\nend\n\nORIENTATION = kinarm_data( arm, ORIENT_index);\n\n% To be consistent with the Exoskelet"
      "on, the shoulder and elbow angles are stored in a \n% 'local' coordinate frame from the robot's perspective.  Th"
      "e right End-Point robot is \n% constructed the same a left KINARM Exoskeleton and vice-versa.  So the 'local' co"
      "ordinate\n% frame for a R.H. KINARM EP robot is actually a left-handed coordinate frame.\nSho_offset = robot_cal"
      "ib(1, arm);		% value stored in calibration in a 'local' coordinate frame.\n\nposition=[0,0];	%initialization\nif"
      " length(u)==2	%input is assumed to be (x,y) position, global coordinates, (m)\n    if size(u,1) == 1;\n        p"
      "osition=u;\n    else\n        position=u';\n    end\nelse			%input is assumed to be a VCODE\n    position(1)=u(3"
      ");\n    position(2)=u(4);\nend\n\n\n% calculate theta from (x,y)\nL1 = kinarm_data( arm, L1_index );\nL2 = kinar"
      "m_data( arm, L2_index );\nL2ptr = kinarm_data( arm, L2ptr_index );\nSHO_ORIGIN_X = kinarm_data( arm, SHO_ORIGIN_"
      "X_index );\nSHO_ORIGIN_Y = kinarm_data( arm, SHO_ORIGIN_Y_index );\n\nx = position(1) - SHO_ORIGIN_X;\ny = posit"
      "ion(2) - SHO_ORIGIN_Y;\n\nL2_temp = sqrt(L2^2 + L2ptr^2);\nL2_ptr_angle_shift = atan2(L2ptr, L2);			%\n\n% The f"
      "ollowing calculation assumes that the (local) elbow angle is \n% never less than 0 (i.e. L2_L1Ang > 0 for right-"
      "handed Exoskeleton, or LEFT-HANDED End-Point, and \n% L2_L1Ang < 0 for  left-handed Exoskelton or RIGHT-HANDED E"
      "nd-Point).  These are always true if L2ptr > 0.  \n% If L2ptr < 0, then two solutions exist, however, the one wi"
      "th (local) \n% elbow_angle > 0 is chosen.  \n% In addition, temp is limited to +-1 to avoid an error using acos."
      "  \n% Originally this was simple clipping, but the infinite slope at acos(1)\n% created instability problems, so"
      " tanh(temp + temp^3/3...) was added to \n% smooth out the transition.  The difference in angle is < 1 degree wit"
      "h \n% elbow angle > 30 degrees.  As the elbow extends further, the 'error' \n% is <20 degrees when full extensio"
      "n should theoretically happen.  For \n% L1 = 0.3m and L2 = 0.4m, the end-point error with an input point\n% that"
      " in theory requires full extension is <1cm.  This end-point error\n% is < 1mm when the desired endpoint is >66cm"
      " out.\n% Note: tanh(temp + temp^3/3...) provides a sharper transition than \n% tanh(temp), which in turn provide"
      "s a shaper one than atan(temp)\n% The more terms in the tanh(temp...) series, the greater the cutoff\ntemp = (x^"
      "2 + y^2 - L1^2 - L2_temp^2) / (2*L1*L2_temp);\n% 	temp = sign(temp) * min(abs(temp), 1);          %Not used to a"
      "void infinite slope issue for subsequent acos\ntemp = tanh(temp + temp^3/3 + temp^5/5 + temp^7/7 + temp^9/9 + te"
      "mp^11/11);\nL2_L1Ang = acos( temp );\n\n% if ORIENTATION == 2 %left-handed KINARM Exoskeleton \nif ORIENTATION ="
      "= 1 %right-handed KINARM End-Point robot\n    L2_L1Ang = -L2_L1Ang;\n    L2_ptr_angle_shift = -L2_ptr_angle_shif"
      "t;\nend\nsint = sin(L2_L1Ang);\ncost = cos(L2_L1Ang);\nL1Ang = atan2( ( -x*L2_temp*sint + y *(L1 + L2_temp*cost)"
      " ) , ( y*L2_temp*sint + x *(L1 + L2_temp*cost) ) );\n\n% Likewise, there are multiple solutions for the inverse "
      "kinematics for \n% L1Ang as well. We know (based on possible arm configurations) which is \n% the correct soluti"
      "on for right-handed versus left-handed KINARMs.\n% Sho_offset is in local coordinates.  It is translated to glob"
      "al as  \n% L1_offset.  For \"left\" robots (i.e. left Exo and right EP), \n% L1Ang = -ShoAng + pi.  \n% For the "
      "KINARM End-Point robot, working from the calibration \n% position (i.e. when L1Ang = L1_Offset), we know that th"
      "e L1 link cannot \n% point directly backwards into the K-box.  Which for the left KINARM EP is \n% a rotation of"
      " -3/4pi or +5/4pi and for the right it is -5/4pi or +3/4pi.\n\nif ORIENTATION == 2 \n	% left-handed KINARM End_p"
      "oint\n    L1_offset = Sho_offset;\n    if L1Ang < (L1_offset - 3/4*pi) \n        L1Ang = L1Ang + 2*pi;\n    else"
      "if L1Ang > (L1_offset + 5/4*pi)\n        L1Ang = L1Ang - 2*pi;\n    end\nelse\n    L1_offset = -Sho_offset + pi;"
      "\n    if L1Ang < (L1_offset - 5/4*pi) \n        L1Ang = L1Ang + 2*pi;\n    elseif L1Ang > (L1_offset + 3/4*pi)\n"
      "        L1Ang = L1Ang - 2*pi;\n    end\n\nend\n\nL2Ang = L1Ang + L2_L1Ang - L2_ptr_angle_shift;\n\nSEGMENT_ANG ="
      " [L1Ang; L2Ang];\n\n"
      editorLayout	      "100 M4x1[523 56 1209 934]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
