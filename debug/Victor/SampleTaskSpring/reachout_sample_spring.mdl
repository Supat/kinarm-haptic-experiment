  state {
    id			    38
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    37
    treeNode		    [37 0 0 0]
    superState		    SUBCHART
    subviewer		    37
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function hand_forces  = hand_pos_loads(use_dom_hand, inter_arm, stability, load_tbl, kinarm_data,"
      " load_col, load_row, load_scaling, robot1_motor_parameters, robot2_motor_parameters)\n%\n% HAND-SPACE VELOCITY D"
      "EPENDENT FORCE FIELD \n%\n% revision 3\n%\n\n\n% Maximum velocity feedback gains\nmax_gain_secondary = 40;   %fo"
      "r secondary encoders\nmax_gain_primary = 20;     %for primary encoders\n\n\n\n% kinarm_data indicies\nL1_index ="
      " 1;				% L1\nL2_index = 2;				% L2\nL2ptr_index=3;				% L2 pointer (finger tip offset)\nORIENT_index = 6;			% 1="
      "right	2=left\nSHOANG_index = 7;			% Shoulder angle\nELBANG_index = 8;			% Elbow angle\nHXPOS_index = 23;			% Han"
      "d x position\nHYPOS_index = 24;			% Hand y position\nSHOVEL_FILT_index = 35;		% filtered velocities\nELBVEL_FILT"
      "_index = 36;\n\n\n\n% by default, all loads are zeroed\nhand_forces = [0,0,0,0];\n\n\n%determine which arm to ap"
      "ply the load to\ndominant_hand=kinarm_data(3,1);						%kinarm_data(3,1) tells which arm is the dominant arm\nif "
      "use_dom_hand==1\n	loading_arm=dominant_hand;\nelse\n	loading_arm=3-dominant_hand;\nend\n\n%if inter_arm==0, then"
      " loading and feedback occur on same arm.  \n%if inter_arm==1, then feedback comes from other arm (i.e. loading o"
      "ccurs\n%on hand specified in Mask)\nif inter_arm==0\n    feedback_arm=loading_arm\nelse\n    feedback_arm=3-load"
      "ing_arm\nend\n\n% check to see which type of encoder is present on the feedback arm\n% if the feedback arm is ar"
      "m 1, then set the secondary encoder flag for robot 1\n% if the feedback arm is arm 2, then set the secondary enc"
      "oder flag for robot 2\n% if sec_enc_feedbackarm==0, then primary encoders are used on the feedback arm\n% if sec"
      "_enc_feedbackarm==1, then secondary encoders are used on the feedback arm\nif feedback_arm==1\n    sec_enc_feedb"
      "ackarm = robot1_motor_parameters(6);\nelse\n    sec_enc_feedbackarm = robot2_motor_parameters(6);\nend\n\n\nif l"
      "oad_row > 0 && load_row <= size(load_tbl,1)\n	CA=0;	CB=0;	CC=0;	CD=0;		%default values\n	% global frame force fi"
      "eld coefficients    \n	if load_col(1)>0\n		CA = load_tbl( load_row, load_col(1));\n	end\n	if load_col(2)>0\n		CB"
      " = load_tbl( load_row, load_col(2));\n	end\n	if load_col(3)>0\n		CC = load_tbl( load_row, load_col(3));\n	end\n	"
      "if load_col(4)>0\n		CD = load_tbl( load_row, load_col(4));\n	end\n	if stability==1		%force stability for viscous"
      " loads\n		CA=min(CA,0);\n		CD=min(CD,0);\n    end\n    \n    xk_center = load_tbl( load_row,load_col(5));\n    y"
      "k_center = load_tbl( load_row,load_col(6));\n\n    % limit the velocity feedback gains\n    % if the feedback ar"
      "m has secondary encoders, then limit the gain to the maximum secondary encoder gain\n    % if the feedback arm h"
      "as primary encoders, then limit the gain to the maximum primary encoder gain   \n    if sec_enc_feedbackarm == 1"
      "\n        if CA<-max_gain_secondary\n            CA=-max_gain_secondary\n        end\n        if CB<-max_gain_se"
      "condary\n            CB=-max_gain_secondary\n        end\n        if CC<-max_gain_secondary\n            CC=-max"
      "_gain_secondary\n        end\n        if CD<-max_gain_secondary\n            CD=-max_gain_secondary\n        end"
      "\n        if CA>max_gain_secondary\n            CA=max_gain_secondary\n        end\n        if CB>max_gain_secon"
      "dary\n            CB=max_gain_secondary\n        end\n        if CC>max_gain_secondary\n            CC=max_gain_"
      "secondary\n        end\n        if CD>max_gain_secondary\n            CD=max_gain_secondary\n        end\n    el"
      "se\n        if CA<-max_gain_primary\n            CA=-max_gain_primary\n        end\n        if CB<-max_gain_prim"
      "ary\n            CB=-max_gain_primary\n        end\n        if CC<-max_gain_primary\n            CC=-max_gain_pr"
      "imary\n        end\n        if CD<-max_gain_primary\n            CD=-max_gain_primary\n        end\n        if C"
      "A>max_gain_primary\n            CA=max_gain_primary\n        end\n        if CB>max_gain_primary\n            CB"
      "=max_gain_primary\n        end\n        if CC>max_gain_primary\n            CC=max_gain_primary\n        end\n  "
      "      if CD>max_gain_primary\n            CD=max_gain_primary\n        end\n    end\n        \n\n    % Build rot"
      "ation matrix\n    R_mat = [load_tbl( load_row,load_col(7)) load_tbl( load_row,load_col(8));\n             load_t"
      "bl( load_row,load_col(9)) load_tbl( load_row,load_col(10))];\n    \n    \n	%------------------------------------"
      "---------------------------\n	% define the x and y velocities\n	HXPOS = kinarm_data( feedback_arm, HXPOS_index )"
      ";\n	HYPOS = kinarm_data( feedback_arm, HYPOS_index );\n\n	%-----------------------------------------------------"
      "------------\n	% calculate force field force components\n    hf = [CA*(HXPOS + xk_center) + CB*(HYPOS + yk_cente"
      "r);\n          CC*(HXPOS + xk_center) + CD*(HYPOS + yk_center)];\n    hf = R_mat * hf;\n    \n    hand_forces(1+"
      "2*(loading_arm-1)) = hf(1);\n    hand_forces(2+2*(loading_arm-1)) = hf(2);\n    \n% 	hand_forces(1+2*(loading_ar"
      "m-1))=CA*(HXPOS + xk_center) + CB*(HYPOS + yk_center);			%FX\n% 	hand_forces(2+2*(loading_arm-1))=CC*(HXPOS + xk"
      "_center) + CD*(HYPOS + yk_center);			%FY\n    \n\n\nend\nhand_forces=hand_forces*load_scaling;\n"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
