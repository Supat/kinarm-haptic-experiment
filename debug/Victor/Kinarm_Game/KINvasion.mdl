    Block {
      BlockType		      SubSystem
      Name		      "Process_Video_CMD"
      SID		      45
      Ports		      [1]
      Position		      [925, 521, 1090, 579]
      BackgroundColor	      "green"
      AncestorBlock	      "Video/Process_Video_CMD"
      LibraryVersion	      "*1.899"
      LoadFcn		      "set_param(gcs, 'MaxIdLength', 63);"
      MinAlgLoopOccurrences   off
      PropExecContextOutsideSubsystem off
      RTWSystemCode	      "Auto"
      FunctionWithSeparateData off
      Opaque		      off
      RequestExecContextInheritance off
      MaskHideContents	      off
      MaskType		      "Process_Video_CMD"
      MaskDescription	      "<b>Do not rename this block, it must be called 'Process_Video_CMD'.</b>\n<p>\nThis block "
      "takes a matrix of video commands (VCODES) as inputs (one VCODE per row) and processes them to display the approp"
      "riate video output."
      MaskHelp		      "Processes VCODES and sends a composite command over UDP to the GUI computer.\n\n<H2>Library </H"
      "2>\nVideo\n\n<H2>Description </H2>\n<b>Do not rename this block, it must be called 'Process_Video_CMD'.</b>\n<p>"
      "\nThe Process_Video_CMD block takes a matrix of video commands (VCODES) as inputs and processes them to display "
      "the appropriate video output.  The processed video command format is designed for use with GUI application.  The"
      "re can be only one VCODE per row in the input.  To concatenate VCODEs properly prior to connecting a VCODE matri"
      "x to this block, the Matrix Concatenation block in the Simulink Math library should be used, with the concatenat"
      "ion method set to \"Vertical\".   For more information on the details of a VCODE, right click on the Show_Target"
      " block in the video library, click \"Look Under Mask\" and open the Embedded Matlab function. \n<P>\nThe output "
      "command from this block is sent via UDP to an external computer for processing (note: this output is sent intern"
      "ally to the block - there is no output from the block that needs wiring to another block). \n<P>\n<B><I> There c"
      "an be only one Process_Video_CMD block in a Task Program.</I></B>\n\n<H2>Related Blocks </H2>\nShow_Target<BR>\n"
      "Show_Target_With_Label<BR>\nHand_Feedback<BR>"
      MaskInitialization      "block_path = gcb;  % store block path, as gcb may change with block operations\n\nidxs "
      "= findstr(block_path, '/Process_Video_CMD');\n[idxCount, n] = size(idxs);\n[m, strlen] = size(block_path);\nbCol"
      "orSet = 0;\n\nif idxCount == 0 || idxs(1) ~= strlen - 17\n    fprintf('=========ERROR====================\\n');\n"
      "    fprintf('%s should be called Process_Video_CMD, attempting to rename.\\n', block_path);\n    try\n        se"
      "t_param(block_path, 'Name', 'Process_Video_CMD');\n        block_path = gcb;  % store block path, as gcb may cha"
      "nge with block operations\n        fprintf('Rename successful\\n');\n    catch err\n        fprintf('Rename fail"
      "ed. You may have 2 Process_Video_CMD blocks or another improperly named block.\\n');\n       	set_param(block_pa"
      "th, 'BackgroundColor', '[0.9, 0, 0]');\n        bColorSet = 1;\n    end\n    fprintf('=========================="
      "===\\n');\nend\n\n\n% Handle background colours if link status changes.  If the link is resolved, \n% make the b"
      "lock back to the library colour.  If the link is not resolved, \n% change the colour to something other than the"
      " library block colour (but \n% only change it if it is the library colour, that way end-users can choose\n% thei"
      "r own colour.\nlink_status = get_param(block_path, 'LinkStatus');\nblock_parent = get_param(block_path, 'Parent'"
      ");\nif bColorSet == 0 && (strcmp(link_status, 'resolved') || strcmp(block_parent, 'Video'))\n	set_param(block_pa"
      "th, 'BackgroundColor', '[0.85882, 0.69019, 0.3098]');\nelse\n 	current_bgcolor = str2num( get_param(block_path, "
      "'BackgroundColor') ) ;\n	%if the BackgroundColor is 'green', then after the str2num, current_bgcolor is empty\n	"
      "if ~isempty(current_bgcolor) \n		if (round(current_bgcolor * 255) == [219 176 79])\n	 		set_param(block_path, 'B"
      "ackgroundColor', 'green');\n		end\n	end\nend"
      MaskIconFrame	      on
      MaskIconOpaque	      on
      MaskIconRotate	      "none"
      MaskPortRotate	      "default"
      MaskIconUnits	      "autoscale"
      System {
	Name			"Process_Video_CMD"
	Location		[36, 333, 1474, 787]
	Open			off
	ModelBrowserVisibility	off
