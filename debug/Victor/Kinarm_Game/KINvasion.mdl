  state {
    id			    17
    labelString		    "RRGGBBAA = colourshift(RRRGGGBBB)"
    position		    [1186.4059 611.3205 258.2061 46.7951]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 18 0]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    130
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    firstData		    32
    eml {
      isEML		      1
      script		      "function RRGGBBAA = colourshift(RRRGGGBBB)\n% This function takes an RGB color and transforms it "
      "into VCODE\n% color values.\n    blue = cast(mod(RRRGGGBBB, 1000), 'uint32');\n    green = cast(mod(RRRGGGBBB - "
      "blue, 1000000) / 1000, 'uint32');\n    red = cast((RRRGGGBBB - (green * 1000) - blue) / 1000000, 'uint32');\n\n "
      "   RRGGBBAA = bitshift(red, 16) + bitshift(green, 8) + blue;\nend"
      editorLayout	      "100 M4x1[148 75 825 627]"
    }
  }
  state {
    id			    18
    labelString		    "out=numberText2(in)"
    position		    [1185.8 560.251 125.745 38.178]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 19 17]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    134
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    firstData		    34
    eml {
      isEML		      1
      script		      "function out=numberText2(in)\n% This function takes a number (in) and converts it to\n% a two-dig"
      "it character output. Useful for VCODES.\n    o=floor(mod(in,10));\n    t=floor(mod(in,100)/10);\n    out=[t+48,o"
      "+48];\nend\n"
      editorLayout	      "100 M4x1[148 75 825 627]"
    }
  }
  state {
    id			    19
    labelString		    "out=numberText3(in)"
    position		    [1187.7316 506.8661 122.109 41.814]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 16 18]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    137
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    firstData		    36
    eml {
      isEML		      1
      script		      "function out=numberText3(in)\n% This function takes a number (in) and converts it to\n% a three-d"
      "igit character output. Useful for VCODES.\n    o=floor(mod(in,10));\n    t=floor(mod(in,100)/10);\n    h=floor(i"
      "n/100);\n\n    out=[h+48,t+48,o+48];\nend\n"
      editorLayout	      "100 M4x1[148 75 825 627]"
    }
  }
