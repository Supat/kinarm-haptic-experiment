    eml {
      isEML		      1
      script		      "function [VCODEs_out,num_used_VCODEs] = fcn(USER_VCODES, GUI_VCODES)\n\n% set the maximum number "
      "of user VCODEs allowed (although the actual number displayed may be cropped by the UDP packet size)\nmax_num_USE"
      "R_VCODES = 80;			\n\nnum_USER_VCODEs = size(USER_VCODES, 1);\nnum_GUI_VCODEs = size(GUI_VCODES, 1);\n\nUSER_VCOD"
      "E_length = size(USER_VCODES, 2);\nGUI_VCODE_length = size(GUI_VCODES, 2);\n\nif USER_VCODE_length == 1\n	% this "
      "situation will happen if there are no USER_VCODEs\n	VCODEs_out = [GUI_VCODES; zeros(max_num_USER_VCODES, GUI_VCO"
      "DE_length)];\n	num_USER_VCODEs = 0;\nelseif	num_USER_VCODEs > max_num_USER_VCODES\n	% limit the number of user V"
      "CODEs to ensure that the total number does not exceed the max_num_USER_VCODES\n	VCODEs_out = [USER_VCODES(1:max_"
      "num_USER_VCODES, :); GUI_VCODES];\n	num_USER_VCODEs = max_num_USER_VCODES;\nelse\n	% use all of the USER_VCODEs\n"
      "	VCODEs_out = [USER_VCODES; GUI_VCODES; zeros(max_num_USER_VCODES - num_USER_VCODEs, USER_VCODE_length)];\nend\n"
      "\nnum_used_VCODEs = num_USER_VCODEs + num_GUI_VCODEs;\n"
      editorLayout	      "100 M4x1[385 62 1428 912]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
