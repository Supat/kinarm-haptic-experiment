  state {
    id			    11
    labelString		    "StoreLoop"
    position		    [1181.6028 83.9864 95.727 63.818]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 0 4]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    100
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function StoreLoop\n% This function shows and regulates the game's behaviour while the player\n% "
      "is buying and selling upgrades.\n%\n% Upgrades is a 1x5 vector that tracks how many of each upgrade the player\n"
      "% has purchased.\n%\n\n    persistent SelectTimer; % Used to limit time between purchases\n    \n    Forces=zero"
      "s(1,4); % Don't need forces here\n    \n    if isempty(SelectTimer)\n        SelectTimer=0;\n    end\n    \n    "
      "VCODES=zeros(100,70);\n    \n    % increments of vertical space for display\n    increment=(TWP(WindowMaxY)-TWP("
      "WindowMinY))/8; \n    \n    for i=1:2\n        if i==1\n            active_arm=KINARMdata(3,1);			%choose domina"
      "nt arm first\n        else\n            active_arm=3-KINARMdata(3,1);		%choose non-dominant arm 2nd\n        end"
      "\n        \n        VCODES(i,1)=1;							%target_type of circle\n        VCODES(i,2)=1;                         "
      " %show target\n        VCODES(i,5)=colourshift(100255);        %fill colour\n        VCODES(i,6)=colourshift(100"
      "255);		%stroke colour\n        VCODES(i,7)=0;							%no stroke width\n        VCODES(i,9)=100;                  "
      "      %100% opacity\n        VCODES(i,10)=0.005;                     %radius (m)\n        feedfwd=KINARMdata(3,2"
      ");\n        VCODES(i,3)=KINARMdata(active_arm,23) + KINARMdata(active_arm,25)*feedfwd;\n        VCODES(i,4)=KINA"
      "RMdata(active_arm,24) + KINARMdata(active_arm,26)*feedfwd;\n        \n        if SelectTimer==0\n            % I"
      "f using the right hand, buy things\n            if ((sum(KINARMdata(active_arm,47:48).^2)>TWP(FireTorque)^2)&& i"
      "==1)\n                SelectTimer=600;\n                if (IsOver(VCODES(i,4))==2 && Money>=10)\n              "
      "      Money=Money-10;\n                    Upgrades(1)=Upgrades(1)+1;\n                elseif (IsOver(VCODES(i,4"
      "))==3 && Money>=15)\n                    Money=Money-15;\n                    Upgrades(2)=Upgrades(2)+1;\n      "
      "          elseif (IsOver(VCODES(i,4))==4 && Money>=25)\n                    Money=Money-25;\n                   "
      " Upgrades(4)=Upgrades(4)+1;\n                elseif (IsOver(VCODES(i,4))==5 && Money>=50)\n                    M"
      "oney=Money-50;\n                    Upgrades(3)=Upgrades(3)+1;\n                elseif IsOver(VCODES(i,4))==7\n "
      "                   game_state=1;\n                end\n                    \n            % If using the left han"
      "d, sell things\n            elseif ((sum(KINARMdata(active_arm,47:48).^2)>TWP(FireTorque)^2)&& i==2)\n          "
      "      SelectTimer=600;\n                if (IsOver(VCODES(i,4))==2 && Upgrades(1)>=1)\n                    Money"
      "=Money+10;\n                    Upgrades(1)=Upgrades(1)-1;\n                elseif (IsOver(VCODES(i,4))==3 && Up"
      "grades(2)>=1)\n                    Money=Money+15;\n                    Upgrades(2)=Upgrades(2)-1;\n            "
      "    elseif (IsOver(VCODES(i,4))==4 && Upgrades(4)>=1)\n                    Money=Money+25;\n                    "
      "Upgrades(4)=Upgrades(4)-1;\n                elseif (IsOver(VCODES(i,4))==5 && Upgrades(3)>=1)\n                 "
      "   Money=Money+50;\n                    Upgrades(3)=Upgrades(3)-1;\n                elseif IsOver(VCODES(i,4))=="
      "7\n                    game_state=1;\n                end\n            end\n        else\n            SelectTime"
      "r=SelectTimer-1;\n        end\n        \n    end\n    \n    % Show score and money\n    VCODES(3,:)=titleCode(.."
      ".\n        ['SCORE ',numberText3(Score),' $',numberText3(Money)],...\n        [TWP(WindowMaxX),TWP(WindowMaxY)],"
      "0.05);\n    \n    % Show buying options\n    VCODES(4,:)=titleCode(['Shields          $10 / ',(48+floor(Upgrades"
      "(1)/10)), 48+mod(Upgrades(1),10)],...\n        [(TWP(WindowMaxX)+TWP(WindowMinX))/2,(TWP(WindowMaxY)-increment*2"
      ")],0.04);\n    VCODES(5,:)=titleCode(['Charge Rate     $15 / ',(48+floor(Upgrades(2)/10)), 48+mod(Upgrades(2),10"
      ")],...\n        [(TWP(WindowMaxX)+TWP(WindowMinX))/2,(TWP(WindowMaxY)-increment*3)],0.04);\n    VCODES(6,:)=titl"
      "eCode(['Bombs          $25 / ',(48+floor(Upgrades(4)/10)), 48+mod(Upgrades(4),10)],...\n        [(TWP(WindowMaxX"
      ")+TWP(WindowMinX))/2,(TWP(WindowMaxY)-increment*4)],0.04);\n    VCODES(7,:)=titleCode(['AutoCannon  $50 / ',(48+"
      "floor(Upgrades(3)/10)), 48+mod(Upgrades(3),10)],...\n        [(TWP(WindowMaxX)+TWP(WindowMinX))/2,(TWP(WindowMax"
      "Y)-increment*5)],0.04);\n    \n    % Show option to continue to the play stage\n    VCODES(8,:)=titleCode('DONE'"
      ",...\n        [(TWP(WindowMaxX)+TWP(WindowMinX))/2,(TWP(WindowMaxY)-increment*7)],0.04);\n\nend\n\n%%%%%%%%%%%%%"
      "  ADDITIONAL FUNCTIONS %%%%%%%%%%%%%%%\n\nfunction VC = titleCode(str,loc,size)\n% This function creates a VCODE"
      " with some text at a certain\n% size and global location.\n\n    VC=zeros(1,70);\n    VC(1,1)=11;               "
      "              %target_type of labelled circle\n    VC(1,2)=1;                              %show target\n    VC("
      "1,3) = loc(1);\n    VC(1,4) = loc(2);\n    VC(1,5)=colourshift(255);               %fill colour\n    VC(1,6)=col"
      "ourshift(255);               %stroke colour\n    VC(1,7)=0.00;                           %no stroke width\n    V"
      "C(1,9)=100;                            %100% opacity\n    VC(1,10)=0.0;                           %radius (m)\n "
      "   VC(1,15:(length(str)+14))=uint16(str);  %str in letters\n    VC(1,65)=colourshift(254254254);        %text co"
      "lor\n    VC(1,66)=size;                          %text height (m)\n    \nend\n\nfunction inc=IsOver(locy)\n% Thi"
      "s function finds the increment of vertical space that the location\n% is in. To allow for discrimination of choi"
      "ces\n\n    inc=TWP(WindowMaxY)-locy;\n    inc=inc/((TWP(WindowMaxY)-TWP(WindowMinY))/8);\n    inc=floor(inc+0.5)"
      ";\n\nend"
      editorLayout	      "100 M4x1[693 138 925 614]"
    }
  }
  state {
    id			    12
    labelString		    "GameLoop(Initialize)"
    position		    [1183.5745 153.0837 95.727 63.818]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 3 13]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    101
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    firstData		    31
    eml {
      isEML		      1
      script		      "function GameLoop(Initialize)\n% This function is iterated every millisecond of game time. It sho"
      "ws all\n% the graphics by creating VCODEs, and updates the location and state of\n% all game elements.\n\n    % "
      "Some persistent variables that are needed between game loop iterations\n    persistent Power Health Shields Enem"
      "ies Bosses Shots firstrun startcounter forcedata Bombs Moneys;\n    \n    MaxShips=50;\n    MaxShots=70;\n    Ma"
      "xMoneys=50;\n    MaxBosses=15;\n    \n    % Instantiate random seed.\n    if isempty(firstrun)\n        rand('tw"
      "ister',seed);\n        firstrun=1;\n    end\n\n    Forces=zeros(1,4);\n    T=[0,0];\n    temp=0;\n    \n    VCOD"
      "ES=zeros(100,70);\n    \n    if (isempty(forcedata) || Initialize==1)\n        forcedata=[ForcePlatedata(10),For"
      "cePlatedata(3),0,0];\n    end\n    forcedata(3:4)=abs([ForcePlatedata(10),ForcePlatedata(3)]-forcedata(1:2));\n "
      "   forcedata(1:2)=[ForcePlatedata(10),ForcePlatedata(3)];\n    \n    if (isempty(Bombs) || Initialize==1)\n     "
      "   Bombs=[0,0,0,0,0,0];\n    end\n    \n    \n    if (isempty(Power) || Initialize==1)\n        Power=[100,100,1"
      "00];\n    end\n    \n    if (isempty(Health) || Initialize==1)\n        Health=0;\n    end\n    \n     if (isemp"
      "ty(Shields) || Initialize==1)\n        Shields=0;\n    end\n    \n    if (isempty(startcounter) || Initialize==1"
      ")\n        startcounter=1;\n    end\n    \n    if (isempty(Shots) || Initialize==1)\n        Shots=zeros(MaxShot"
      "s,6);\n    end\n    \n    if isempty(Enemies)\n        Enemies=zeros(MaxShips,9);\n    end\n    \n    if isempty"
      "(Bosses)\n        Bosses=zeros(MaxBosses,9);\n    end\n    \n    if isempty(Moneys)\n        Moneys=zeros(MaxMon"
      "eys,3);\n    end\n    \n    % Function to set up enemies, bosses, and money drops at the start of\n    % each le"
      "vel.\n    if (Initialize==1)\n        Enemies=zeros(MaxShips,9);\n        for i=1:EnemyNum\n            Enemies("
      "i,:)=[  100,...                 % Health\n                            30*rand(),...           % Power\n         "
      "                   rand()*(TWP(WindowMaxX)-TWP(WindowMinX))+TWP(WindowMinX),...     % X\n                       "
      "     (rand()*0.5+0.5+5.0*i/EnemyNum)*(TWP(WindowMaxY)-TWP(WindowMinY))+TWP(WindowMinY),...     % Y\n            "
      "                (rand()*0.02-0.01)*Difficulty,...       % dX\n                            0,...                 "
      "                  % dY\n                            0,...                                   % ddX\n             "
      "               0,...                                   % ddY\n                            rand()*50+10];        "
      "                  % frequency\n        end\n        \n        Bosses=zeros(MaxBosses,9);\n        for i=1:BossNu"
      "m\n            Bosses(i,:)=[   200*Difficulty+500+500*i,...  % Health\n                            floor(1000*ra"
      "nd()),...        % WeaponCounter\n                            rand()*(TWP(WindowMaxX)-TWP(WindowMinX))+TWP(Windo"
      "wMinX),...     % X\n                            (1+1.0*i/BossNum)*(TWP(WindowMaxY)-TWP(WindowMinY))+TWP(WindowMi"
      "nY),...     % Y\n                            (rand()*0.02-0.01)*Difficulty,...     % dX\n                       "
      "     0,...                                 % dY\n                            0,...                              "
      "   % ddX\n                            0,...                                 % ddY\n                            0"
      "];                                   % unused\n        end\n        \n        Moneys=zeros(MaxMoneys,3);\n      "
      "  for i=1:MoneyNum\n            Moneys(i,:)=[  max(1,floor((rand()+rand())*3-2)),...  % money in this drop\n    "
      "                       rand()*(TWP(WindowMaxX)-TWP(WindowMinX))+TWP(WindowMinX),...  % X\n                      "
      "     (rand()*0.5+0.5+10.0*i/MoneyNum)*(TWP(WindowMaxY)-TWP(WindowMinY))+TWP(WindowMinY)]; % Y\n        end\n    "
      "                       \n    end\n    \n\n    %Setup Ship Vcodes\n    for i=1:2\n        \n        % Show a circ"
      "le at each hand whose radius shows power level.\n        if i==1\n            active_arm=KINARMdata(3,1);			%cho"
      "ose dominant arm first\n        else\n            active_arm=3-KINARMdata(3,1);		%choose non-dominant arm 2nd\n "
      "       end\n        T(i)=sqrt(KINARMdata(active_arm,47)^2+KINARMdata(active_arm,48)^2);\n        VCODES(i,1)=1;	"
      "						%target_type of circle\n        VCODES(i,2)=1;                          %show target\n        VCODES(i,5)="
      "colourshift(255);			%fill colour\n        VCODES(i,6)=colourshift(255);			%stroke colour\n        VCODES(i,7)=0;"
      "							%no stroke width\n        VCODES(i,9)=100;                        %100% opacity\n        VCODES(i,10)=0.0"
      "0015*Power(i);          %radius (m)\n        feedfwd=KINARMdata(3,2);\n        VCODES(i,3)=KINARMdata(active_arm"
      ",23) + KINARMdata(active_arm,25)*feedfwd;\n        VCODES(i,4)=KINARMdata(active_arm,24) + KINARMdata(active_arm"
      ",26)*feedfwd;\n        \n    end\n    \n    % Show a bar between the hands that represents health.\n    VCODES(3"
      ",1)=4;						%target_type of line\n    VCODES(3,2)=1;                      %show target\n    VCODES(3,5)=-4;     "
      "                %fill colour\n    VCODES(3,6)=-4;                     %stroke colour\n    VCODES(3,7)=0.00025*He"
      "alth;         %stroke width\n    VCODES(3,9)=100;                    %100% opacity\n    VCODES(3,3) = VCODES(1,3"
      ");          %one end X\n    VCODES(3,4) = VCODES(1,4);          %one end Y\n    VCODES(3,10) = VCODES(2,3)-VCODE"
      "S(1,3); % X vector to other end\n    VCODES(3,11) = VCODES(2,4)-VCODES(1,4); % Y vector to other end\n    \n    "
      "% Show the score and money\n    VCODES(4,:)=titleCode(...\n        ['SCORE ',numberText3(Score),' $',numberText3"
      "(Money)],...\n        [TWP(WindowMaxX),TWP(WindowMaxY)],0.04);\n    \n    C=4;\n    \n    % If the player has a "
      "shield, show it as an elipse between the hands\n    if ((Shields>0) && (VCODES(3,10)^2+VCODES(3,11)^2)<0.1)\n   "
      "     C=C+1;\n        VCODES(C,1)=2;                              %target_type of elipse\n        VCODES(C,2)=1; "
      "                             %show target\n        VCODES(C,5)=colourshift(255);               %fill colour\n   "
      "     VCODES(C,6)=colourshift(255);               %stroke colour\n        VCODES(C,7)=0;                         "
      "     %no stroke width\n        VCODES(C,9)=max(min(Shields*0.5,70),10);    %opacity is strength\n        VCODES("
      "C,3) = VCODES(1,3)+VCODES(3,10)/2;\n        VCODES(C,4) = VCODES(1,4)+VCODES(3,11)/2;\n        VCODES(C,10) = sq"
      "rt(VCODES(3,10)^2+VCODES(3,11)^2)/2+0.02;\n        VCODES(C,11) = 0.03;\n        VCODES(C,12) = atan2(VCODES(3,1"
      "1),VCODES(3,10));\n    end\n    \n    % If the player has an autocannon, show it as a circle between the hands\n"
      "    if (Upgrades(3)>0)\n        C=C+1;\n        VCODES(C,1)=1;							%target_type of circle\n        VCODES(C,2)"
      "=1;                          %show target\n        VCODES(C,5)=colourshift(255);           %fill colour\n       "
      " VCODES(C,6)=colourshift(200200000);		%stroke colour\n        VCODES(C,7)=0.003;                      %stroke wi"
      "dth\n        VCODES(C,9)=100;                        %100% opacity\n        VCODES(C,10)=0.010;                 "
      "    %radius (m)\n        VCODES(C,3)=VCODES(1,3)+VCODES(3,10)/2;\n        VCODES(C,4)=VCODES(1,4)+VCODES(3,11)/2"
      ";\n        \n    end\n    \n    % If the player has bombs, list them at the top of the screen\n    if (Upgrades("
      "4)>0)\n        C=C+1;\n        VCODES(C,:)=titleCode('B ',[TWP(WindowMinX),TWP(WindowMaxY)],0.05);\n        for "
      "i=1:min(Upgrades(4),10)\n            VCODES(C,16+i)=48;\n        end\n    end\n    \n    % If within 3000ms of s"
      "tart, show the life bar and shields grow, do not process\n    % any game updates afterwards. Show a title with t"
      "he level.\n    if (startcounter < 3000)\n        C=C+1;\n        VCODES(C,:)=titleCode(['LEVEL ',(48+floor(Level"
      "/10)),48+mod(Level,10)],[(TWP(WindowMaxX)+TWP(WindowMinX))/2,(TWP(WindowMaxY)+TWP(WindowMinY))/2],0.05);\n      "
      "  startcounter=startcounter+1;\n        Health=min(Health+0.05,100);\n        \n        if (startcounter<Upgrade"
      "s(1)*150)\n            Shields=Shields+0.07;\n        end\n        \n        return;\n    end\n    \n    % Check"
      " for manipulator torque and if power level is high enough, fire\n    % a shot perpendicular to life bar.\n    fo"
      "r i=1:2\n        if Power(i)>25\n            if T(i)>TWP(FireTorque)\n                F=firstzero(Shots(:,1));\n"
      "                if (F>0)\n                    \n                    fv=fireVector([VCODES(1,3)-VCODES(2,3),VCODE"
      "S(1,4)-VCODES(2,4)]);\n                    Shots(F,1)=Power(i);\n                    Shots(F,2)=VCODES(i,3)+fv(1"
      ")*0.04;\n                    Shots(F,3)=VCODES(i,4)+fv(2)*0.04;\n                    Shots(F,4)=fv(1)*0.3;\n    "
      "                Shots(F,5)=fv(2)*0.3;\n                    Shots(F,6)=1;\n                    Power(i)=0;\n     "
      "           end\n            end\n        end\n    end\n    \n    % Add more power each loop, as given by Upgrade"
      "(2)\n    temp=sqrt(sum(VCODES(3,10:11).^2));\n    Power(1)=min(Power(1)+temp*0.1*(Upgrades(2)+5)/5,100);\n    Po"
      "wer(2)=min(Power(2)+temp*0.1*(Upgrades(2)+5)/5,100);\n    Power(3)=min(Power(3)+temp*0.1,100);\n    \n    % Chec"
      "k for change in forceplate pressure for bomb use\n    for i=1:2\n        if (Bombs(i*3)==0 && Upgrades(4)>0)\n  "
      "          if (forcedata(2+i)>TWP(StompForce))\n                if TWP(DemoMode)==0\n                    Upgrades"
      "(4)=Upgrades(4)-1;\n                end\n                Bombs(3*i-2)=VCODES(i,3);\n                Bombs(3*i-1)"
      "=VCODES(i,4);\n                Bombs(3*i)=1;\n            end\n        end\n    end\n    \n    \n    % Check thr"
      "ough all shots to see if any are within the shields or the\n    % life bar. If they are, cause damage to the pla"
      "yer accordingly.\n    for j=1:size(Shots,1)\n        if (Shots(j,1)>0 && Shots(j,6)==0)\n            if (Shields"
      ">0 && (VCODES(3,10)^2+VCODES(3,11)^2)<0.1 && isInsideLine(  Shots(j,2:3) , VCODES(3,[3,4,10,11]) , 0.04  ))\n   "
      "             temp=min(Shields,Shots(j,1));\n                Shields=max(0,Shields-temp);\n                Shots("
      "j,1)=max(Shots(j,1)-temp,0);\n            end\n                \n            if isInsideLine(  Shots(j,2:3) , VC"
      "ODES(3,[3,4,10,11]) , VCODES(3,7)  )\n                Health= max(Health-Shots(j,1),0);\n                Forces="
      "Forces+[Shots(j,4:5),Shots(j,4:5)]/sqrt(sum(Shots(j,4:5).^2))*Shots(j,1)*0.01*TWP(ForceSize);\n                %"
      " DO FORCE OUTPUT HERE\n                Shots(j,1)=0;\n            end\n        end\n    end\n    \n    % Update "
      "each money drop, show its VCODE and check to see if the player\n    % is over it for collection.\n    for i=1:Ma"
      "xMoneys\n        \n        Moneys(i,3)=Moneys(i,3)-0.0001;\n        \n        if Moneys(i,1)<=0\n            con"
      "tinue;\n        end\n        \n        if ((Moneys(i,3)>TWP(WindowMaxY)) || (Moneys(i,3)<TWP(WindowMinY)))\n    "
      "        continue;\n        end\n        \n        C=C+1;\n        \n        VCODES(C,1)=11;							%target_type o"
      "f circle\n        VCODES(C,2)=1;                          %show target\n        VCODES(C,3)=Moneys(i,2);        "
      "   % X\n        VCODES(C,4)=Moneys(i,3);           % Y\n        VCODES(C,5)=colourshift(253253000);		%fill colou"
      "r as specified by GUI\n        VCODES(C,6)=colourshift(200128000);		%stroke colour same as fill colour\n        "
      "VCODES(C,7)=0.002;						%no stroke width\n        VCODES(C,9)=100;                    %100% opacity\n        VCO"
      "DES(C,10)=(0.005+Moneys(i,1)*0.003);                  %radius (m)\n        for j=1:Moneys(i,1)\n            VCOD"
      "ES(C,14+j)=36;\n        end\n        VCODES(C,65)=colourshift(200128000);\n        VCODES(C,66)=0.01;\n        \n"
      "        if isInsideLine(  Moneys(i,2:3) , VCODES(3,[3,4,10,11]) , VCODES(3,7)  )\n                Money=Money+Mo"
      "neys(i,1);\n                Moneys(i,1)=0;\n        end\n        \n    end\n    \n    \n    \n    wincondition=1"
      "; % Used for ending the level if everything is dead\n    closestloc=[0,0]; % Used for autocannon targetting\n   "
      " closestrange=1000; % Used for autocannon targetting\n    bossactive=0; % variable to track if a boss is onscree"
      "n\n\n    %% UPDATE EACH BOSS %%\n    for i=1:MaxBosses\n        \n        % Move the bosses\n        if (Bosses("
      "i,4)>(TWP(WindowMinY)+(TWP(WindowMaxY)-TWP(WindowMinY))*(2+bossactive)/(3+bossactive)))\n            if (Bosses("
      "i,4)>(TWP(WindowMaxY)) && bossactive )\n                Bosses(i,4)=Bosses(i,4)-0.000002;\n            else\n   "
      "             Bosses(i,4)=Bosses(i,4)-0.00001;\n            end\n        end\n        \n        Bosses(i,3:4)=Bos"
      "ses(i,3:4)+Bosses(i,5:6)/1000;\n        \n        if ((Bosses(i,3)>TWP(WindowMaxX)) && Bosses(i,5)>0)\n         "
      "   Bosses(i,5)=-Bosses(i,5);\n        elseif ((Bosses(i,3)<TWP(WindowMinX)) && Bosses(i,5)<0)\n            Bosse"
      "s(i,5)=-Bosses(i,5);\n        end\n        \n        \n        if Bosses(i,1)<=0\n            continue;\n       "
      " else\n            wincondition=0;\n        end\n        \n        if ((Bosses(i,4)>TWP(WindowMaxY)) || (Bosses("
      "i,4)<TWP(WindowMinY)))\n            continue;\n        end\n        \n        % Check if boss is closest target "
      "for autocannon\n        temp=sum((Bosses(i,3:4)-[VCODES(1,3)+VCODES(3,10)/2,VCODES(1,4)+VCODES(3,11)/2]).^2);\n "
      "       if (temp<closestrange)\n            closestloc=Bosses(i,3:4);\n            closestrange=temp;\n        en"
      "d\n        \n        bossactive=bossactive+1;\n        \n        C=C+1;\n        \n        VCODES(C,1)=3;							"
      "%target_type of line\n        VCODES(C,2)=1;                          %show target\n        VCODES(C,3)=Bosses(i"
      ",3);           % X\n        VCODES(C,4)=Bosses(i,4);           % Y\n        VCODES(C,5)=-5;		%fill colour as spe"
      "cified by GUI\n        VCODES(C,6)=-5;		%stroke colour same as fill colour\n        VCODES(C,7)=0;						%no stro"
      "ke width\n        VCODES(C,9)=Bosses(i,1)*0.1+50;                    %100% opacity\n        VCODES(C,10)=0.20;  "
      "                %radius (m)\n        VCODES(C,11)=0.07;                  %radius (m)\n        \n        % See if"
      " the boss is hit by any shots\n        for j=1:MaxShots\n            if (Shots(j,1)>0 && Shots(j,6)==1 && isInsi"
      "deLine(Shots(j,2:3),[Bosses(i,3)-VCODES(C,10)/2,Bosses(i,4),VCODES(C,10),0.0],VCODES(C,11)))\n                Bo"
      "sses(i,1)= max(Bosses(i,1)-Shots(j,1),0);\n                Bosses(i,5:6)= Bosses(i,5:6)+Shots(j,4:5)*0.0; %impac"
      "t force\n                Shots(j,1)=0;\n            end\n        end\n        \n        % See if the boss is wit"
      "hin the radius of any exploding bombs\n        if (Bombs(3)>0 && isInsideCircle(Bosses(i,3:4),Bombs(1:2),Bombs(3"
      ")/1000))\n            Bosses(i,1)= max(Bosses(i,1)-1,0);\n        end\n        if (Bombs(6)>0 && isInsideCircle("
      "Bosses(i,3:4),Bombs(4:5),Bombs(6)/1000))\n            Bosses(i,1)= max(Bosses(i,1)-1,0);\n        end\n         "
      "   \n        % See if the boss is within the shields or lifebar of the player (collision)\n        if (Shields>0"
      " && (VCODES(3,10)^2+VCODES(3,11)^2)<0.1 && isInsideLine(  Bosses(i,3:4) , VCODES(3,[3,4,10,11]) , 0.04  ))\n    "
      "        temp=min(Shields,Bosses(i,1)*0.5);\n            Shields=max(0,Shields-temp);\n            Bosses(i,1)=ma"
      "x(Bosses(i,1)-temp*2,0);\n        end\n        \n        if (isInsideLine(  Bosses(i,3:4) , VCODES(3,[3,4,10,11]"
      ") , VCODES(3,7)  ))\n            Health= max(Health-Bosses(i,1)*0.5,0);\n            Forces=Forces+[0,-TWP(Force"
      "Size)*min(Bosses(i,1),100)*0.01,0,-TWP(ForceSize)*min(Bosses(i,1),100)*0.01];\n            Bosses(i,1)=0;\n     "
      "   end\n        \n        % Check the bosses timer and apply various weaponry\n        if mod(Bosses(i,2),2000/D"
      "ifficulty)==0\n            F=firstzero(Shots(:,1));\n            if (F>0)\n                temploc=[Bosses(i,3)+"
      "VCODES(C,10)/2*(rand()-0.5),Bosses(i,4)];\n                v=vectorTo(temploc,(VCODES(3,3:4)+VCODES(3,10:11)./2)"
      ",(1/(Difficulty*1.5)));\n                Shots(F,1)=9+Difficulty*2;\n                Shots(F,2)=temploc(1)+v(1)*"
      "(0.021+0.02/Difficulty);\n                Shots(F,3)=temploc(2)+v(2)*(0.021+0.02/Difficulty);\n                S"
      "hots(F,4)=v(1)*(0.03*Difficulty+0.07);\n                Shots(F,5)=v(2)*(0.03*Difficulty+0.07);\n               "
      " Shots(F,6)=0;\n            end\n        end\n        \n        if mod(Bosses(i,2),10000/Difficulty)==0\n       "
      "     F=firstzero(Shots(:,1));\n            if (F>0)\n                v=vectorTo(Bosses(i,3:4),(VCODES(3,3:4)+VCO"
      "DES(3,10:11)./2),(1/(Difficulty*1.5)));\n                Shots(F,1)=100;\n                Shots(F,2)=Bosses(i,3)"
      "+v(1)*(0.021+0.02/Difficulty);\n                Shots(F,3)=Bosses(i,4)+v(2)*(0.021+0.02/Difficulty);\n          "
      "      Shots(F,4)=v(1)*(0.01*Difficulty+0.04);\n                Shots(F,5)=v(2)*(0.01*Difficulty+0.04);\n        "
      "        Shots(F,6)=0;\n            end\n        end\n        \n        if mod(Bosses(i,2),30000/Difficulty)==0\n"
      "            for j=1:12\n                angle=j/6*3.1415;\n                F=firstzero(Shots(:,1));\n           "
      "     if (F>0)\n                    v=[cos(angle),sin(angle)];\n                    Shots(F,1)=50;\n             "
      "       Shots(F,2)=Bosses(i,3)+v(1)*(0.021+0.02/Difficulty);\n                    Shots(F,3)=Bosses(i,4)+v(2)*(0."
      "021+0.02/Difficulty);\n                    Shots(F,4)=v(1)*(0.01*Difficulty+0.04);\n                    Shots(F,"
      "5)=v(2)*(0.01*Difficulty+0.04);\n                    Shots(F,6)=0;\n                end\n            end\n      "
      "  end\n        \n        Bosses(i,2)=mod(Bosses(i,2)+1,30001);\n        \n        % If the boss is dead, add som"
      "e score and money to the player\n        if Bosses(i,1)==0\n            Money=Money+TWP(MoneyPerShip)*5;\n      "
      "      Score=Score+5;\n        end\n        \n    end\n    \n    %% UPDATE EACH ENEMY %%\n    for i=1:MaxShips\n "
      "       \n        % Move the enemy\n        if (bossactive==0 || Enemies(i,4)<TWP(WindowMaxY))\n            Enemi"
      "es(i,4)=Enemies(i,4)-0.00005;\n        else\n            Enemies(i,4)=Enemies(i,4)-0.00001;\n        end\n      "
      "  \n        if ((Enemies(i,3)>TWP(WindowMaxX)) && Enemies(i,5)>0)\n            Enemies(i,5)=-Enemies(i,5);\n    "
      "    elseif ((Enemies(i,3)<TWP(WindowMinX)) && Enemies(i,5)<0)\n            Enemies(i,5)=-Enemies(i,5);\n        "
      "end\n        \n        if Enemies(i,1)<=0\n            continue;\n        end\n        \n        if (Enemies(i,4"
      ")>TWP(WindowMinY))\n            wincondition=0;\n        end\n        \n        if ((Enemies(i,4)>TWP(WindowMaxY"
      ")) || (Enemies(i,4)<TWP(WindowMinY)))\n            continue;\n        end\n        \n        % Check if enemy is"
      " closest target for autocannon\n        temp=sum((Enemies(i,3:4)-[VCODES(1,3)+VCODES(3,10)/2,VCODES(1,4)+VCODES("
      "3,11)/2]).^2);\n        if (temp<closestrange)\n            closestloc=Enemies(i,3:4);\n            closestrange"
      "=temp;\n        end\n        \n        C=C+1;\n        \n        VCODES(C,1)=1;							%target_type of circle\n  "
      "      VCODES(C,2)=1;                          %show target\n        VCODES(C,3)=Enemies(i,3);           % X\n   "
      "     VCODES(C,4)=Enemies(i,4);           % Y\n        VCODES(C,5)=-1;		%fill colour as specified by GUI\n       "
      " VCODES(C,6)=-1;		%stroke colour same as fill colour\n        VCODES(C,7)=0;						%no stroke width\n        VCOD"
      "ES(C,9)=Enemies(i,1)*0.5+50;                    %100% opacity\n        VCODES(C,10)=0.02+0.02*(Enemies(i,2)*0.01"
      ");                  %radius (m)\n        \n        % See if the enemy is hit by any shots\n        for j=1:MaxSh"
      "ots\n            if (Shots(j,1)>0 && Shots(j,6)==1 && isInsideCircle(Shots(j,2:3),Enemies(i,3:4),(0.02/Difficult"
      "y)+0.01))\n                Enemies(i,1)= max(Enemies(i,1)-Shots(j,1),0);\n                Enemies(i,5:6)= Enemie"
      "s(i,5:6)+Shots(j,4:5)*0.0; %impact force\n                Shots(j,1)=0;\n            end\n        end\n        \n"
      "        % See if the enemy is within the radius of any exploding bombs\n        if (Bombs(3)>0 && isInsideCircle"
      "(Enemies(i,3:4),Bombs(1:2),Bombs(3)/1000))\n            Enemies(i,1)= max(Enemies(i,1)-1,0);\n        end\n     "
      "   if (Bombs(6)>0 && isInsideCircle(Enemies(i,3:4),Bombs(4:5),Bombs(6)/1000))\n            Enemies(i,1)= max(Ene"
      "mies(i,1)-1,0);\n        end\n            \n        % See if the enemy is within the shields or lifebar of the p"
      "layer (collision)\n        if (Shields>0 && (VCODES(3,10)^2+VCODES(3,11)^2)<0.1 && isInsideLine(  Enemies(i,3:4)"
      " , VCODES(3,[3,4,10,11]) , 0.04  ))\n            temp=min(Shields,Enemies(i,1)*0.5);\n            Shields=max(0,"
      "Shields-temp);\n            Enemies(i,1)=max(Enemies(i,1)-temp*2,0);\n        end\n        \n        if (isInsid"
      "eLine(  Enemies(i,3:4) , VCODES(3,[3,4,10,11]) , VCODES(3,7)  ))\n            Health= max(Health-Enemies(i,1)*0."
      "5,0);\n            Forces=Forces+[0,-TWP(ForceSize)*Enemies(i,1)*0.01,0,-TWP(ForceSize)*Enemies(i,1)*0.01];\n   "
      "         Enemies(i,1)=0;\n        end\n        \n        % Check to see if the enemy's power level is high enoug"
      "h, an fire a shot\n        if Enemies(i,2)>Enemies(i,9)\n            F=firstzero(Shots(:,1));\n            if (F"
      ">0)\n                v=vectorTo(Enemies(i,3:4),(VCODES(3,3:4)+VCODES(3,10:11)./2),(1/(Difficulty*1.5)));\n      "
      "          Shots(F,1)=Enemies(i,2);\n                Shots(F,2)=Enemies(i,3)+v(1)*(0.021+0.02/Difficulty);\n     "
      "           Shots(F,3)=Enemies(i,4)+v(2)*(0.021+0.02/Difficulty);\n                Shots(F,4)=v(1)*(0.03*Difficul"
      "ty+0.07);\n                Shots(F,5)=v(2)*(0.03*Difficulty+0.07);\n                Shots(F,6)=0;\n             "
      "   Enemies(i,2)=0;\n            end\n        end\n        \n        % regen some power\n        Enemies(i,2)=Ene"
      "mies(i,2)+TWP(BaseRegen)*0.001*(Difficulty+2)/3;\n        \n         % If the enemy is dead, add some score and "
      "money to the player\n        if Enemies(i,1)==0\n            Money=Money+TWP(MoneyPerShip);\n            Score=S"
      "core+1;\n        end\n\n    end\n    \n    \n    \n    % AutoCannon firing if we have a target\n    if (Upgrades"
      "(3)>0 && closestrange<1000)\n        if (Power(3)>=25)\n            F=firstzero(Shots(:,1));\n            if (F>"
      "0)\n                fv=autoVector([VCODES(1,3)+VCODES(3,10)/2,VCODES(1,4)+VCODES(3,11)/2],closestloc);\n        "
      "        Shots(F,1)=Upgrades(3)*20;\n                Shots(F,2)=VCODES(1,3)+VCODES(3,10)/2+fv(1)*0.04;\n         "
      "       Shots(F,3)=VCODES(1,4)+VCODES(3,11)/2+fv(2)*0.04;\n                Shots(F,4)=fv(1)*0.3;\n               "
      " Shots(F,5)=fv(2)*0.3;\n                Shots(F,6)=1;\n                Power(3)=0;\n            end\n        end"
      "\n    end\n    \n    % If either hand's bomb is active, show it and update its radius\n    for i=1:2\n        if"
      " Bombs(3*i)>0\n            Bombs(3*i)=Bombs(3*i)+1;\n            C=C+1;\n            VCODES(C,1)=1;							%targe"
      "t_type of circle\n            VCODES(C,2)=1;                          %show target\n            VCODES(C,3)=Bomb"
      "s(3*i-2);           % X\n            VCODES(C,4)=Bombs(3*i-1);           % Y\n            VCODES(C,5)=colourshif"
      "t(255255000);		%fill colour as specified by GUI\n            VCODES(C,6)=colourshift(255255000);		%stroke colour"
      " same as fill colour\n            VCODES(C,7)=0;						%no stroke width\n            VCODES(C,9)=70-Bombs(3*i)/10"
      ";                    %100% opacity\n            VCODES(C,10)=Bombs(3*i)/1000;                  %radius (m)\n    "
      "        \n            if Bombs(3*i)>TWP(BombSize)\n                Bombs(3*i)=0;\n            end\n        end\n"
      "    end\n    \n    % Update the trajectory of each shot\n    for j=1:MaxShots\n        if Shots(j,1)>0\n        "
      "    C=C+1;\n            VCODES(C,1)=3;							%target_type of circle\n            VCODES(C,2)=1;                 "
      "         %show target\n            VCODES(C,3)=Shots(j,2);           % X\n            VCODES(C,4)=Shots(j,3);   "
      "        % Y\n            VCODES(C,5)=-3+Shots(j,6);		%fill colour as specified by GUI\n            VCODES(C,6)=-"
      "3+Shots(j,6);		%stroke colour same as fill colour\n            VCODES(C,7)=0;						%no stroke width\n           "
      " VCODES(C,9)=100;                    %100% opacity\n            VCODES(C,10)=(0.004+0.00005*Shots(j,1))*4;      "
      "            %radius (m)\n            VCODES(C,11)=0.004+0.00005*Shots(j,1);\n            VCODES(C,12)=atan2(Shot"
      "s(j,5),Shots(j,4));\n            \n            % If the shot is offscreen, delete it\n            Shots(j,2:3)=S"
      "hots(j,2:3)+Shots(j,4:5)*0.001;\n            if (...\n                       Shots(j,2)<(TWP(WindowMinX)-0.1)..."
      "\n                    || Shots(j,2)>(TWP(WindowMaxX)+0.1)...\n                    || Shots(j,3)<(TWP(WindowMinY)"
      "-0.1)...\n                    || Shots(j,3)>(TWP(WindowMaxY)+0.1))\n                Shots(j,1)=0;\n            e"
      "nd\n            \n            % If the shot is within a bomb, degrade it.\n            if (Bombs(3)>0 && isInsid"
      "eCircle(Bombs(1:2),Shots(j,2:3),Bombs(3)/1000))\n                Shots(j,1)= max(Shots(j,1)-1,0);\n            e"
      "nd\n            if (Bombs(6)>0 && isInsideCircle(Bombs(4:5),Shots(j,2:3),Bombs(6)/1000))\n                Shots("
      "j,1)= max(Shots(j,1)-1,0);\n            end\n            \n        end\n    end\n    \n    % If the player's hea"
      "lth is zero, lose.\n    % If everything is dead or passed, win.\n    if Health<=0\n            game_state=3;\n  "
      "  elseif (((sum(Enemies(:,1))<1) && (sum(Bosses(:,1))<1)) || wincondition)\n            game_state=2;\n    end\n"
      "        \nend\n\n\n%%%%%%%% IN TARGET CALCULATIONS %%%%%%%%%%%\n\nfunction intarget = isInsideCircle(pos,Cpos,Cr"
      "ad)\n    delta=pos-Cpos;\n	intarget = ((delta(1)^2 + delta(2)^2) <= Crad.^2);\nend\n\nfunction v = vectorTo(pos,"
      "pos2,err)\n    v=pos2-pos+rand(1,2)*err-err/2;\n    v=v./sqrt(v(1)^2+v(2)^2);\nend\n\nfunction v = fireVector(po"
      "s)\n    v=[-pos(2),pos(1)];\n    v=v./sqrt(v(1)^2+v(2)^2);\nend\n\nfunction v = autoVector(pos,pos2)\n    v=pos2"
      "-pos;\n    offset=sqrt(sum(v.^2))/0.3*0.05;\n    v=v-[0,offset];\n    v=v./sqrt(v(1)^2+v(2)^2);\nend\n\n\nfuncti"
      "on intarget = isInsideLine( pos, Lpos, height1 )\n    \n    delta=pos-Lpos(1:2);\n    \n    w = sqrt(Lpos(3)^2 +"
      " Lpos(4)^2);                          %width (cm)\n    \n    % determine the vector from the line's midpoint to "
      "the hand position\n    handx = delta(1) - Lpos(3)/2;\n    handy = delta(2) - Lpos(4)/2;\n    \n    t = atan2(Lpo"
      "s(4), Lpos(3));                                %calculate angle of the line (rads)\n    sint = sin(t);\n    cost"
      " = cos(t);\n    \n    xrotate = handx.*cost + handy.*sint;   %location of x point in rectangle's coordinate fram"
      "e\n    yrotate = -handx.*sint + handy.*cost;  %location of y point in rectangle's coordinate frame\n    \n    in"
      "target = abs(xrotate) <= w/2 & abs(yrotate) <= max(height1,0.001)/2;\n    \n\nend\n\n\n%%%%%%%%%%%%%%%%% ADDITIO"
      "NAL FUNCTIONS %%%%%%%%%%%%%%%%%%%\n\nfunction VC = titleCode(str,loc,size)\n% This function creates a VCODE with"
      " some text at a certain\n% size and global location.\n\n    VC=zeros(1,70);\n    VC(1,1)=11;                    "
      "         %target_type of labelled circle\n    VC(1,2)=1;                              %show target\n    VC(1,3) "
      "= loc(1);\n    VC(1,4) = loc(2);\n    VC(1,5)=colourshift(255);               %fill colour\n    VC(1,6)=coloursh"
      "ift(255);               %stroke colour\n    VC(1,7)=0.00;                           %no stroke width\n    VC(1,9"
      ")=100;                            %100% opacity\n    VC(1,10)=0.0;                           %radius (m)\n    VC"
      "(1,15:(length(str)+14))=uint16(str);  %str in letters\n    VC(1,65)=colourshift(254254254);        %text color\n"
      "    VC(1,66)=size;                          %text height (m)\n    \nend\n\nfunction ret=firstzero(vector)\n    r"
      "et=0;\n    for i=1:length(vector)\n        if vector(i)==0\n            ret=i;\n            return;\n        end"
      "\n    end\nend\n\n% The colourshift function converts an \"RRRGGGBBB\" colour value to RRGBB (as an uint32).\nfu"
      "nction RRGGBBAA = colourshift(RRRGGGBBB)\n\nblue = cast(mod(RRRGGGBBB, 1000), 'uint32');\ngreen = cast(mod(RRRGG"
      "GBBB - blue, 1000000) / 1000, 'uint32');\nred = cast((RRRGGGBBB - (green * 1000) - blue) / 1000000, 'uint32');\n"
      "\nRRGGBBAA = bitshift(red, 16) + bitshift(green, 8) + blue;\nend\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n\n"
      "\n\n    \n% VCODEs are length 70. All units in a VCODE should be SI, e.g. (m) and (rad). Elements in a VCODE are"
      " defined as follows:\n%\n% For all target types:\n%  1: target type\n%       1 - circle\n%       2 - ellipse\n% "
      "      3 - rectangle\n%       4 - line\n%       5 - triangle\n%       11 - circle with label\n%       12 - ellips"
      "e with label\n%       13 - rectangle with label\n%       14 - line with label\n%       15 - triangle with label\n"
      "%  2: target on/off status and target display (which display target will appear on)\n%		0 - off\n%		1 - on, appe"
      "aring on both subject and operator displays\n%       2 - on, appearing on subject display only\n%       3 - on, "
      "appearing on operator display only\n%  3: x position (m)\n%  4: y position (m)\n%  5: fill colour (RRGGBB) or te"
      "xture index\n%  6: stroke colour (RRGGBB) or texture index\n%  7: stroke width\n%  8: reserved for target backgr"
      "ound ID\n%  9: opacity\n%\n% For circles:\n%  10: radius (m)\n%\n% For ellipses:\n%  10: major radius (m)\n%  11"
      ": minor radius (m)\n%  12: orientation of major axis (rad)\n%\n% For rectangles:\n%  10: length (m)\n%  11: heig"
      "ht (m)\n%  12: orientation (rad) (relative to x, y already shown)\n%\n% For lines:\n%  10: endpoint x-axis coord"
      "inate relative to start point (m)\n%  11: endpoint y-axis coordinate relative to start point (m)\n%\n% For trian"
      "gles:\n%  10: length (m)\n%  11: height (m)\n%  12: offset of peak from midpoint of length (m)\n%  13: orientati"
      "on (rad)\n%\n% For all labelled target types:\n%  14: reserved\n%  15-64: label characters (indexes in ISO 8859-"
      "1 character set)\n%  65: label colour (0xRRGBBAA)\n%  66: label height (m)\n%  67: reserved\n%  68: reserved\n% "
      " 69: reserved\n%  70: reserved"
      editorLayout	      "100 M4x1[693 138 925 614]"
    }
  }
  state {
    id			    13
    labelString		    "TitleText"
    position		    [1184.7394 222.7029 95.727 63.818]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 12 14]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    122
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function TitleText\n% This function simply shows title text in the center of the screen\n\n    Fo"
      "rces=zeros(1,4);\n    T=[0,0];\n    \n    VCODES=zeros(100,70);\n\n    locx=(TWP(WindowMaxX)+TWP(WindowMinX))/2;"
      "\n    locy=(TWP(WindowMaxY)+TWP(WindowMinY))/2;\n    \n    if game_state==2\n        VCODES(1,:)=titleCode('LEVE"
      "L COMPLETE',[locx,locy],0.05);\n    elseif game_state==3\n        VCODES(1,:)=titleCode('GAME OVER',[locx,locy*1"
      ".3],0.05);\n        VCODES(2,:)=titleCode('FINAL SCORE',[locx,locy],0.05);\n        VCODES(3,:)=titleCode(number"
      "Text3(Score),[locx,locy*0.7],0.05);\n    else\n        VCODES(1,:)=titleCode('READY',[locx,locy],0.05);\n    end"
      "\n    \nend\n\n%%%%%%%%%% ADDITIONAL FUNCTIONS %%%%%%%%%%%%%\n\nfunction VC = titleCode(str,loc,size)\n% This fu"
      "nction creates a VCODE with some text at a certain\n% size and global location.\n\n    VC=zeros(1,70);\n    VC(1"
      ",1)=11;                             %target_type of labelled circle\n    VC(1,2)=1;                             "
      " %show target\n    VC(1,3) = loc(1);\n    VC(1,4) = loc(2);\n    VC(1,5)=colourshift(255);               %fill c"
      "olour\n    VC(1,6)=colourshift(255);               %stroke colour\n    VC(1,7)=0.00;                           %"
      "no stroke width\n    VC(1,9)=100;                            %100% opacity\n    VC(1,10)=0.0;                   "
      "        %radius (m)\n    VC(1,15:(length(str)+14))=uint16(str);  %str in letters\n    VC(1,65)=colourshift(25425"
      "4254);        %text color\n    VC(1,66)=size;                          %text height (m)\n    \nend\n\n\n"
      editorLayout	      "100 M4x1[148 75 825 627]"
    }
  }
