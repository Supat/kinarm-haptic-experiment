  state {
    id			    90
    labelString		    "Two indexes into the array of frame numbers (and also that of timestamps) are kept: i and j. The"
    " former is always the index of the frame number most\nrecently stored in the array (i.e. the number of the frame m"
    "ost recently sent out), while the latter is used to iterate over the array.\n\nWhen an acknowledged frame number i"
    "s received, the chart's outputs are updated and the index of that frame in the array is stored so that it cannot b"
    "e\n\"acknowledged\" again. Searches for subsequent frame numbers begin at one beyond that index, and continue only"
    " up to the most recent unacknowledged\nnumber. If an acknowledgement for a number that is not in the array is rece"
    "ived (i.e. either a legitimate but late acknowledgement, for which the frame\nnumber has already been cycled out o"
    "f the array, or an illegitimate / erroneous acknowledgement) the chart's outputs are not changed."
    position		    [391.4062 54.8438 611.895 84.9678]
    chart		    88
    treeNode		    [88 0 0 89]
    superState		    GROUPED
    isNoteBox		    1
    noteBox		    [0 0 0 1]
    subviewer		    88
    ssIdNumber		    2
    type		    GROUP_STATE
    decomposition	    CLUSTER_STATE
    eml {
