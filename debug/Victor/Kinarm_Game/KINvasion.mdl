  state {
    id			    69
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    68
    treeNode		    [68 0 0 0]
    superState		    SUBCHART
    subviewer		    68
    ssIdNumber		    1
    type		    FUNC_STATE
