      isEML		      1
      script		      "function Fout = loads(perturb)\n\n    persistent force ramp;\n    \n    if isempty(ramp)\n       "
      " ramp=zeros(150,1);\n        ramp(1:50)=1:50;\n        ramp(51:100)=50;\n        ramp(101:150)=50:-1:1;\n       "
      " ramp=ramp/max(ramp);\n    end\n    \n    if isempty(force)\n        force=zeros(150,4);\n    end\n    \n    for"
      "ce=force+ramp*perturb;\n    \n    force(1:149,:)=force(2:150,:);force(end,:)=0;\n    \n    Fout=force(1,:);\n   "
      " \nend"
      editorLayout	      "100 M4x1[192 182 1080 733]"
    }
