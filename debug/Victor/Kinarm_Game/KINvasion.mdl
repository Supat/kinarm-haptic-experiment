  state {
    id			    78
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    77
    treeNode		    [77 0 0 0]
    superState		    SUBCHART
    subviewer		    77
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [vis_cmd_out, vis_cmd_cropped, frame_sent_trigger, frame_number] = fcn(VCODE, num_used_V"
      "CODEs)\n\n% Increment a counter on each execution, which corresponds to one increment per packet. This counter i"
      "s used \n% as a tracking number / \"timestamp\". Video command acknowledgements refer to this counter.\npersiste"
      "nt frame_count\npersistent frame_trigger\n\n% maximum size of the vis_cmd_length is limited to 2 MTUs to avoid s"
      "wamping the UDP system.  Each MTU is ~1500, but\n% there is header info in there, so we need to limit total to 2"
      "900 bytes.\nmax_vis_cmd_length = round(2900 / 4);		% vis_cmd is composed of int32, which are 4 bytes each\n% max"
      "_vis_cmd_length = round(100 / 4);		% FOR TESTING ONLY - Should limit the output to ~2 VCODEs.\n\nif isempty(fram"
      "e_count)\n   frame_count = uint32(0);\nend\n\nframe_count = frame_count + 1;\nframe_number = frame_count;\n\nif "
      "isempty(frame_trigger)\n    frame_trigger = 1;\nelse\n    frame_trigger = mod(frame_trigger + 1, 2);\nend\n\nfra"
      "me_sent_trigger = frame_trigger;\n\n% vis_cmd must be a fixed length, so it is initialized to the maximum possib"
      "le length required.\n%  (number of VCODEs * max_single_vis_cmd_length) + 3 int32 for message header, frame count"
      ", and \"end-of-command\" marker\n%\n% Note: max_single_vis_cmd_length refers to the maximum possible length of a"
      " single target (i.e. the number of int32 elements \n% required to define it) within the vis_cmd vector. Currentl"
      "y a triangle with a label is potentially the longest, with\n% the following elements (each an int32):\n%   1: ta"
      "rget type + target on/off status \n%   2: x position\n%   3: y position\n%   4: fill colour\n%   5: stroke colou"
      "r\n%   6: stroke width\n%   7: opacity\n%   8: base width\n%   9: height\n%  10: peak offset\n%  11: rotation\n%"
      "  12-24:  maximum length label (up to 50 characters, 4 1-byte characters per int32, with one byte for a null ter"
      "minator)\n%  25: label colour\n%  26: label height\n%  27: target id when in background\n\nmax_single_vis_cmd_le"
      "ngth = 27;\nnum_VCODEs = size(VCODE, 1);\nvis_cmd = cast(zeros(max_single_vis_cmd_length * num_VCODEs + 3, 1), '"
      "int32');\n\nindex = 1;  % index into vis_cmd\n\n% Create a 4-byte message header.\n%   byte 1: version\n%     0x"
      "20 = Version 2.0\n%     0x23 = Version 2.3\n%       etc.\n%   bytes 2-4: currently unused\nheader = bitshift(cas"
      "t(23, 'uint32'), 24);\nvis_cmd(index) = cast_int32(header);\nindex = index + 1;\n\n% Insert the timestamp for th"
      "is video frame.\nvis_cmd(index) = cast_int32(frame_count);\nindex = index + 1;\n\n% Create target commands from "
      "VCODEs.\n%\n% Note: Because all values are communicated via UDP as int32, distances and orientations are convert"
      "ed from (m) and (rad).\n%   - in Dexterit-E 2.0 and later, these values are converted to from (m) to (um) and fr"
      "om (rad) to (urad)\n%   - in KINARM-UI 1.4, these values were are converted from (m) to (10 * um) and from (rad)"
      " to (degrees)\nlast_ok_index = 1;		% initialize\nfor i = 1:num_used_VCODEs\n\n    % #1: Add information common t"
      "o all targets.\n    add_target_id = 0;\n\n    if VCODE(i, 1) == 0  % don't include anything for targets with typ"
      "e 0, i.e. VCODEs that have not been set properly\n        continue;\n    end\n    \n    % Target type and on/off"
      " status are packed into one int32. The two high bytes are used for the type,\n    % and the two low bytes are us"
      "ed for the status.\n    status = bitshift(cast(VCODE(i, 1), 'uint32'), 16) + VCODE(i, 2);\n    vis_cmd(index) = "
      "cast_int32(status);\n\n    vis_cmd(index + 1) = VCODE(i, 3) * 1000000;  % target x position (convert from (m) in"
      " VCODE to (um))\n    vis_cmd(index + 2) = VCODE(i, 4) * 1000000;  % target y position (convert from (m) in VCODE"
      " to (um))\n\n	vis_cmd(index + 3) = cast_int32(VCODE(i, 5));  % fill colour\n	vis_cmd(index + 4) = cast_int32(VCO"
      "DE(i, 6));  % stroke colour\n\n    vis_cmd(index + 5) = VCODE(i, 7) * 1000000;  % stroke width (convert from (m)"
      " in VCODE to (um))\n    \n    vis_cmd(index + 6) = VCODE(i, 9);  % opacity\n\n    % #2: Add target type-specific"
      " information.\n    target_type = VCODE(i, 1);\n    \n    if target_type >= 100\n        add_target_id = 1;\n    "
      "    target_type = target_type - 100;\n    end\n\n    if target_type == 1 || target_type == 11\n        \n       "
      " % Handle circle target:\n        vis_cmd(index + 7) = VCODE(i, 10) * 1000000;  % radius (convert from (m) in VC"
      "ODE to (um))\n\n        index = index + 8;\n\n    elseif target_type == 2 || target_type == 12\n\n        % Hand"
      "le ellipse target:\n        vis_cmd(index + 7) = VCODE(i, 10) * 1000000;  % major radius (convert from (m) in VC"
      "ODE to (um))\n        vis_cmd(index + 8) = VCODE(i, 11) * 1000000;  % minor radius (convert from (m) in VCODE to"
      " (um))\n        vis_cmd(index + 9) = VCODE(i, 12) * 1000000;  % orientation (convert from (rad) in VCODE to (ura"
      "d))\n\n        index = index + 10;\n\n    elseif target_type == 3 || target_type == 13\n\n        % Handle recta"
      "ngle target:\n        vis_cmd(index + 7) = VCODE(i, 10) * 1000000;  % length (convert from (m) in VCODE to (um))"
      "\n        vis_cmd(index + 8) = VCODE(i, 11) * 1000000;  % height (convert from (m) in VCODE to (um))\n        vi"
      "s_cmd(index + 9) = VCODE(i, 12) * 1000000;  % orientation (convert from (rad) in VCODE to (um))\n\n        index"
      " = index + 10;\n\n    elseif target_type == 4 || target_type == 14\n\n        % Handle line target:\n        vis"
      "_cmd(index + 7) = VCODE(i, 10) * 1000000;  % endpoint x position, relative to start point (convert from (m) in V"
      "CODE to (um))\n        vis_cmd(index + 8) = VCODE(i, 11) * 1000000;  % endpoint y position, relative to start po"
      "int (convert from (m) in VCODE to (um))\n\n        index = index + 9;\n\n    elseif target_type == 5 || target_t"
      "ype == 15\n\n        % Handle triangle target:\n        vis_cmd(index + 7) = VCODE(i, 10) * 1000000;  % base wid"
      "th (convert from (m) in VCODE to (um))\n        vis_cmd(index + 8) = VCODE(i, 11) * 1000000;  % height (convert "
      "from (m) in VCODE to (um))\n        vis_cmd(index + 9) = VCODE(i, 12) * 1000000;  % peak offset (convert from (m"
      ") in VCODE to (um))\n        vis_cmd(index + 10) = VCODE(i, 13) * 1000000;  % orientation (convert from (rad) in"
      " VCODE to (urad))\n\n        index = index + 11;\n\n    else\n        index = index + 7;\n    end\n    \n    % #"
      "3: Add the label information (if the target is of a labelled type).\n    if (target_type >= 11 && target_type <="
      " 15) || (target_type >= 111 && target_type <= 115)\n        j = 0;\n        \n        while j < 13\n            "
      "c1 = cast(VCODE(i, 15 + j * 4), 'uint32');\n            c2 = cast(VCODE(i, 15 + j * 4 + 1), 'uint32');\n        "
      "    \n            if j < 12\n                c3 = cast(VCODE(i, 15 + j * 4 + 2), 'uint32');\n                c4 "
      "= cast(VCODE(i, 15 + j * 4 + 3), 'uint32');\n            else\n                c3 = uint32(0);\n                "
      "c4 = uint32(0);\n            end\n\n            vis_cmd(index + j) = bitshift(c1, 24) + bitshift(c2, 16) + bitsh"
      "ift(c3, 8) + c4;\n            \n            if c1 == 0 || c2 == 0 || c3 == 0 || c4 == 0\n                break;\n"
      "            end\n            \n            j = j + 1;\n        end\n        \n        j = j + 1;\n        \n    "
      "    vis_cmd(index + j) = cast_int32(VCODE(i, 65));    % label colour\n        vis_cmd(index + j + 1) = VCODE(i, "
      "66) * 1000000;  % label height (convert from (m) in VCODE to (um))\n        \n        index = index + j + 2;\n  "
      "  end\n    \n    % #4: Add the target ID if the target is being placed in the background.\n	if add_target_id > 0"
      "\n        vis_cmd(index) = cast_int32(VCODE(i, 8));\n        index = index + 1;\n	end\n	\n	% if the current inde"
      "x < max_vis_cmd_length, then the VCODEs just added will fit in the vis_cmd_out \n	if index < max_vis_cmd_length\n"
      "		last_ok_index = index;\n	end\nend\n\n% only output full VCODEs so as to not confuse DexDisplay\nvis_cmd_out = "
      "cast(zeros(max_vis_cmd_length, 1), 'int32');\nfor ii = 1:(last_ok_index - 1)\n	vis_cmd_out(ii) = vis_cmd(ii);\ne"
      "nd\n\nif last_ok_index == index\n	vis_cmd_cropped = 0;\nelse\n	vis_cmd_cropped = 1;\nend\n\n% Set the \"end-of-c"
      "ommand\" marker: 0xFFFF0000 instead of a target type indicates end of target commands within the vis_cmd vector."
      "\nvis_cmd_out(last_ok_index) = cast_int32(bitshift(cast(65535, 'uint32'), 16));\n				\n% The typecast function i"
      "s not yet available for Embedded Matlab. This function implements a cast from uint32 to int32.\nfunction output_"
      "int32 = cast_int32(input_uint32)\n\nif input_uint32 > 2^31\n	temp = cast(input_uint32 - 2^31, 'int32');	% remove"
      " MSB and cast to int32\n	output_int32 = temp - 2^30 - 2^30;			% subtract 2^31 (because 2^31 is not int32, subtra"
      "ct 2^30 twice)\nelse\n	output_int32 = cast(input_uint32, 'int32');\nend\n"
      editorLayout	      "100 M4x1[26 36 1428 968]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
