  chart {
    id			    77
    name		    "Process_Video_CMD/PVC_core/Embedded\nMATLAB Function"
    windowPosition	    [877.426 38.063 200.25 189.75]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1440 900 1.333333333333333]
    treeNode		    [0 78 0 0]
    firstTransition	    80
    firstJunction	    79
    viewObj		    77
    machine		    1
    ssIdHighWaterMark	    9
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    firstData		    81
    chartFileNumber	    14
    disableImplicitCasting  1
