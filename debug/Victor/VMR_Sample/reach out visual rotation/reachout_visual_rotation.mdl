      DstBlock		      "Process_Video_CMD"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Hand_Feedback"
      SrcPort		      1
      DstBlock		      "Visual_Rotation"
      DstPort		      2
    }
    Line {
      SrcBlock		      "Visual_Rotation"
      SrcPort		      2
      Points		      [20, 0; 0, 90; -795, 0]
      DstBlock		      "KINARM_HandFeedbackInTarget"
      DstPort		      1
    }
    Line {
      SrcBlock		      "KINARM_HandFeedbackInTarget"
      SrcPort		      1
      DstBlock		      "Trial_Control"
      DstPort		      2
    }
    Line {
      SrcBlock		      "Trial_Control"
      SrcPort		      7
      DstBlock		      "Visual_Rotation"
      DstPort		      1
    }
    Line {
      SrcBlock		      "Visual_Rotation"
      SrcPort		      1
      Points		      [20, 0; 0, -140]
      DstBlock		      "Matrix\nConcatenation"
      DstPort		      3
    }
    Line {
      SrcBlock		      "Trial_Control"
      SrcPort		      1
      DstBlock		      "DataLogging"
      DstPort		      1
    }
    Annotation {
      SID		      "31"
      Name		      "The purpose of this task is to apply a rotation to the visual handfeedback so that the visual handf"
      "eedback is no longer spatially aligned with the actual hand position.\nThis type of task is sometimes call a vis"
      "uomotor rotation task.\nThe task program is coded up such that the amount of visuomotor rotation can be specifie"
      "d explicitly, or as an increment compared to the previous rotation.\nAll rotations are about a target specified "
      "in the target table.\n\nThe KINARM_HandInTarget block was unlinked from the TDK and customized to use the cursor"
      " position as hand feedback input, rather than the KINARM robot's actual location."
      Position		      [646, 54]
      HorizontalAlignment     "left"
      ZOrder		      -1
    }
  }
}
