	Annotation {
	  SID			  "30"
	  Name			  "This sub-system implements a visual rotation about a target defined in the target table.\n\nRotation of c"
	  "ursor feedback is implemented at every time step by the Rotation function.\nThe amount of rotation is remembered fr"
	  "om one time step to the next, and is only changed/updated\nupon reciept of a e_ApplyNewRotation event, which trigge"
	  "rs the Triggered Subsystem to execute.\n\nThe memory blocks on the inputs to this block prevent a loop from occurin"
	  "g (i.e. if the output from here goes to \nanother block which then feeds back into this block, which forms a loop, "
	  "which needs to be broken by the Memory block)."
	  Position		  [74, 58]
	  HorizontalAlignment	  "left"
	  ZOrder		  -1
	}
      }
    }
