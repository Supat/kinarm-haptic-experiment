  state {
    id			    3
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    2
    treeNode		    [2 0 0 0]
    superState		    SUBCHART
    subviewer		    2
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [VCODE_out, fingerTipSpeed]= velocityVCode(VCODE, KINData)\n\narm = KINData(3,1);\n\nhan"
      "dVelX = KINData(arm,25);\nhandVelY = KINData(arm,26);\n\nfingerTipSpeed = (sqrt(handVelX^2 + handVelY^2)) * 100;"
      "\n\n%don't show a zero, show a blank in the 100's position\nif fingerTipSpeed < 100\n	VCODE(15) = 32; %' ' space"
      "\nelse\n	VCODE(15) = getChar(fingerTipSpeed, 100);\nend\n\n%don't show a zero, show a blank in the 10's position"
      "\nif fingerTipSpeed < 10\n	VCODE(16) = 32; %' ' space\nelse\n	VCODE(16) = getChar(fingerTipSpeed, 10);\nend\n\nV"
      "CODE(17) = getChar(fingerTipSpeed, 1);\nVCODE(18) = 32;  %' ' space\nVCODE(19) = 99;  % c\nVCODE(20) = 109; % m\n"
      "VCODE(21) = 47;  % \\\nVCODE(22) = 115; % s\nVCODE(23) = 0;	 %terminate the new string\n\nVCODE_out=VCODE;\nend\n"
      "\nfunction cc = getChar(number, dec)\n	%in simulink there is no nice way to convert a number to s string\n	%so w"
      "hat we are doing here is converting a single digit to a character.\n	%48 is ascii for '0', so this gets the leas"
      "t significant digit before \n	%the decimal and converts to ascii.\n    cc = floor(mod(number / dec, 10)) + 48;\n"
      "end\n"
      editorLayout	      "100 M4x1[489 99 966 899]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
