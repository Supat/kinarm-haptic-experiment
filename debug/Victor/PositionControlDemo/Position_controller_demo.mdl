    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function scaling = fcn(robot_type, exo_scaling, ep_scaling)\n%#codegen\n\nscaling = [0, 0];\n\n%0"
      " = EXO, 1 = EP, 2 = NHP\nfor n=1:2\n    if robot_type(n) == 1\n        scaling(n) = ep_scaling(n);\n    else\n  "
      "      scaling(n) = exo_scaling(n);\n    end\nend"
      editorLayout	      "100 M4x1[10 5 700 500]"
    }
  }
