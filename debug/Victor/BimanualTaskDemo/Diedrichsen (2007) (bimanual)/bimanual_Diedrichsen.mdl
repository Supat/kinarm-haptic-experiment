  state {
    id			    87
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    86
    treeNode		    [86 0 0 0]
    superState		    SUBCHART
    subviewer		    86
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [Mirror_Target_Table,Midline_Target_Table]= FMirror_TT(shoulderXpos, Target_Table)\n% th"
      "is function creates a Mirror_Target_Table that is the mirror image of \n% the Target Table, flipped in the X-dir"
      "ection around the subject's midline\n% The subject's midline is assumed to be halfway between the two shoulders."
      "\n\n% It also creates a midline Target Table with all targets on the midline.\n\n% all dimensions in m unless ot"
      "herwise stated\n% arguments:\n% shoulderXpos: x positions of shoulders (m)\n% Target_Table: the complete Target_"
      "Table (cm in v1.4)\n\n\ntarget_col_x = 1;\ncenter_x = mean(shoulderXpos)*100;				%calculate the subject's midlin"
      "e position (cm)\nMirror_Target_Table = Target_Table;\nMidline_Target_Table = Target_Table;\n\nMirror_Target_Tabl"
      "e(:,target_col_x) = 2*center_x-Target_Table(:,target_col_x);\nMidline_Target_Table(:,target_col_x) = center_x;\n"
      "\n\n\n"
      editorLayout	      "100 M4x1[98 254 1055 584]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
