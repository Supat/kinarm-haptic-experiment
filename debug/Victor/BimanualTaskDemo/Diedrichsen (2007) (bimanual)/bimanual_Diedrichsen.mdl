      "in;     %default\n\nif num_cursors == 1;\n    %show ONLY dominant hand feedback, but show mean hand position\n	V"
      "CODES_out(1,2)=1;\n	VCODES_out(2,2)=0;\n\n	VCODES_out(1,3)=mean_hand_position(1);		%target position in m \n	VCOD"
      "ES_out(1,4)=mean_hand_position(2);		%target position in m \nend\n% ***************************************\n\n"
      editorLayout	      "100 M4x1[85 146 1160 800]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
