	    Annotation {
	      SID		      "3:424"
	      Name		      "The hand feedback settings here may or may not be used by the hand\nfeedback block, depending on i"
	      "ts block mask settings. They are \ntransferred to the hand feedback block via the KINdata data structure."
	      Position		      [1742, 954]
	      HorizontalAlignment     "left"
	      ZOrder		      -5
	    }
	    Annotation {
	      SID		      "3:423"
	      Name		      "The force sensor subsystem controls and collects \ndata from any force sensors in the system setup"
	      "."
	      Position		      [1542, 224]
	      HorizontalAlignment     "left"
	      ZOrder		      -6
	    }
	    Annotation {
	      SID		      "3:422"
	      Name		      "The zero torque vectors are replaced with Gotos \nfrom the Exo and/or EP KINARMs according to \nwh"
	      "ether their respective Apply_Loads blocks are \npresent in the model."
	      Position		      [1477, 764]
	      HorizontalAlignment     "left"
	      ZOrder		      -7
	    }
	    Annotation {
	      SID		      "3:421"
	      Name		      "1) replaced the variable 'orientation' with two variables: 'robot_orientation' and 'arm_orientatio"
	      "n'.  Add comments to better explain.\n2) replaced the variables 'uncorrected_shoulder_angle' and 'uncorrected_e"
	      "lbow_angle' with 'relative_shoulder_angle' and 'relative_elbow_angle'\n3) replaced the variables corrected_shou"
	      "lder_angle and corrected_elbow_angle with shoulder_angle and elbow_angle\n4) primary encoder data was not being"
	      " corrected properly (for errors in non-perfect parallelogram structure) in the original.  This has now been fix"
	      "ed.\n5) replaced \"if (robot_type < 1.0 && orientation == 2) || (robot_type > 0.0 && orientation == 1)\" \n    "
	      "        with \"(robot_orientation == -1)\""
	      Position		      [833, 56]
	      HorizontalAlignment     "left"
	      ZOrder		      -8
	    }
	    Annotation {
	      SID		      "3:420"
	      Name		      "This is read in the GUI to determine is the PLC is working"
	      Position		      [1792, 539]
	      HorizontalAlignment     "left"
	      ZOrder		      -9
	    }
	  }
	}
