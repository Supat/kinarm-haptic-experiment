	      SrcPort		      1
	      DstBlock		      "Data Type Conversion"
	      DstPort		      1
	    }
	    Line {
	      SrcBlock		      "Data Packing Subsystem"
	      SrcPort		      2
	      DstBlock		      "Send Control Machine"
	      DstPort		      1
	    }
	    Line {
	      SrcBlock		      "data_frame"
	      SrcPort		      1
	      DstBlock		      "Data Packing Subsystem"
	      DstPort		      1
	    }
	    Line {
	      SrcBlock		      "UDP Send Subsystem"
	      SrcPort		      1
	      DstBlock		      "Total Packets Sent"
	      DstPort		      1
	    }
	    Line {
	      SrcBlock		      "Total Timeouts"
	      SrcPort		      1
	      DstBlock		      "Terminator2"
	      DstPort		      1
	    }
	    Line {
	      SrcBlock		      "max_packet_id"
	      SrcPort		      1
	      DstBlock		      "Send Control Machine"
	      DstPort		      5
	    }
	    Annotation {
	      SID		      "3:145"
	      Name		      "This subsystem controls the assembly, buffering, and sending of data packets, as well as the recei"
	      "pt of acknowledgements (ACKs). The data packing subsystem packs \ntogether multiple data frames, and when its s"
	      "trobe output is set high the send control machine uses this data to create a new packet in its internal ring bu"
	      "ffer. Each \npacket consists of a tracking number, one or more data frames, and a trailing 0. The latter guaran"
	      "tees that the end of the data can be determined by a 0 found in \nplace of a data frame timestamp. \n\nThe send"
	      " control machine will send the next packet in its buffer after an ACK for the previous one is received. If it  "
	      "will resend a packet if it has not received an ACK\nafter a fixed time, and repeat the send for every elapse of"
	      " that time. Currently up to 5000 packets - a minimum of 5 seconds and a maximum of 30 seconds of data,\ndependi"
	      "ng on frame size - are buffered."
	      Position		      [23, 61]
	      HorizontalAlignment     "left"
	      ZOrder		      -1
	    }
	  }
	}
