  data {
    id			    181
    ssIdNumber		    12
    name		    "torque_command"
    linkNode		    [171 180 182]
    scope		    INPUT_DATA
    machine		    1
    props {
      array {
	size			"-1"
      }
      type {
	method			SF_INHERITED_TYPE
