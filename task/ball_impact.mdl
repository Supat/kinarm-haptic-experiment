	Annotation {
	  SID			  "3:477"
	  Name			  "Section 5: User-specified data."
	  Position		  [17, 539]
	  HorizontalAlignment	  "left"
	  ZOrder		  -1
	}
	Annotation {
	  SID			  "3:476"
	  Name			  "Note: for data which is at the user's option to include, e.g. event codes, some extra work is done to ens"
	  "ure that the user \ndoes not have to observe warnings about unconnected inputs during a build if they turn off thos"
	  "e inputs in the mask. When \none of these inputs is turned off, the corresponding inport is replaced with a Constan"
	  "t that gives the frame's number-of-items \ncount (e.g. \"Number of Event Codes\" in the event code subsystem) a val"
	  "ue of 0, even though the frame will still contain a \nsingle \"dummy\" value because the signal still exists and mu"
	  "st have at least one element by definition. Clients examining the \ndata frames must be aware of this and ignore th"
	  "e dummy value.\n\nIf a user opts to keep the inport available but connects nothing to it, Simulink resolves that as"
	  " a single signal with value 0."
	  Position		  [14, 160]
	  HorizontalAlignment	  "left"
	  ZOrder		  -2
	}
	Annotation {
	  SID			  "3:475"
	  Name			  "Section 3: KINARM data. KINARM data consists of segment \nposition, velocity and acceleration, as well as"
	  " subject pointer / \nfingertip position, motor torque, and force sensor data for all arms.\nKINARM data is currentl"
	  "y required in all tasks."
	  Position		  [17, 419]
	  HorizontalAlignment	  "left"
	  ZOrder		  -3
	}
	Annotation {
	  SID			  "3:474"
	  Name			  "Section 2: User event codes."
