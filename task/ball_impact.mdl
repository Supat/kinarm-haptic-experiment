  chart {
    id			    44
    name		    "Ball_Engine"
    windowPosition	    [357.331 483.407 167 391]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1280 1024 1.041050272174191]
    treeNode		    [0 45 0 0]
    firstTransition	    65
    firstJunction	    64
    viewObj		    44
    machine		    1
    toolbarMode		    LIBRARY_TOOLBAR
    subviewS {
    }
    ssIdHighWaterMark	    21
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    firstData		    46
    chartFileNumber	    2
    disableImplicitCasting  1
    eml {
      name		      "ball_engine"
    }
  }
  state {
    id			    45
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    44
    treeNode		    [44 0 0 0]
    superState		    SUBCHART
    subviewer		    44
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [vcodes, hand_forces, ball_log, pen_out, speed_out, delay_ms, timeout_ms] = ball_engine("
      "phase, home_row, ball_row, load_row, KINdata, Load_Table, Target_Table, Task_Wide, TP_Table, tp_row, seed) %#cod"
      "egen\n%BALL_ENGINE Ball physics, penalty contact force, and ball/slope VCODEs.\n%\n% Runs every 1 ms. The Trial_"
      "Control chart sequences the trial and sets:\n%   phase 0 = no ball (reset), 1 = ball parked at slope top, 2 = ph"
      "ysics live.\n% The ball is constrained to the line from the slope top (Target Table row\n% ball_row) toward the "
      "home target (row home_row): gravity component\n% (5/7)*g*sin(theta) acts along it while the path distance s < Sl"
      "opeLength,\n% rolling resistance -RollRes*g*sign(v) always. Contact with the hand disk is\n% penalty-based: pen "
      "= BallRadius + HandRadius - |p_hand - p_ball|, force\n% clamp(Kc*pen + Bc*dpen/dt, 0, Fmax) along the ball-to-ha"
      "nd normal, plus a\n% decaying TransientFreq sinusoid for the first 30 ms of each new contact.\n% The reaction de"
      "celerates the ball (bounce); HapticsOn=0 zeroes the commanded\n% force but keeps the visual bounce. Fmax is hard"
      "-clamped at 45 N.\n%\n% Units: Target Table and lengths in the Load Table are cm (converted to m\n% here); KINda"
      "ta hand position/velocity are m, m/s, global frame; forces N.\n\npersistent s v prev_pen t_contact have_contact "
      "initd rngstate\nif isempty(initd)\n    s = 0; v = 0; prev_pen = 0; t_contact = 1e9; have_contact = 0; initd = 1;"
      "\n    rngstate = mod(abs(seed), 4294967296);\n    if rngstate <= 0; rngstate = 12345; end\nend\n\ndt = 0.001;\ng"
      "  = 9.81;\n\n% ---- per-trial timing for the chart (sampled by Stateflow at state entry).\n% R2013a chart codege"
      "n cannot lower rand()/boolean arithmetic, so the random\n% release delay and the zero-timeout guard are computed"
      " here instead. LCG\n% seeded from Dexterit-E's 'seed' tag, so the protocol seed option holds.\nrngstate = mod(16"
      "64525 * rngstate + 1013904223, 4294967296);\nu = rngstate / 4294967296;\ntr = max(1, min(100, round(tp_row)));\n"
      "dmin = TP_Table(tr, 5);\ndmax = TP_Table(tr, 6);\nif dmax > dmin\n    delay_ms = dmin + (dmax - dmin) * u;\nelse"
      "\n    delay_ms = dmin;\nend\nif delay_ms < 0; delay_ms = 0; end\ntimeout_ms = TP_Table(tr, 7);\nif timeout_ms <="
      " 0; timeout_ms = 10000; end\n\nvcodes      = zeros(2, 70);\nhand_forces = zeros(4, 1);\n\n% ---- parameters ----"
      "--------------------------------------------------------\nhr = max(1, min(32, round(home_row)));\nbr = max(1, mi"
      "n(32, round(ball_row)));\nlr = max(1, min(20, round(load_row)));\n\nm_b    = Load_Table(lr, 1);\nr_b    = Load_T"
      "able(lr, 2) * 0.01;\ntheta  = Load_Table(lr, 3) * pi / 180;\nLslope = Load_Table(lr, 4) * 0.01;\ncrr    = Load_T"
      "able(lr, 6);\nkc     = Load_Table(lr, 7);\nbc     = Load_Table(lr, 8);\nFmax   = Load_Table(lr, 9);\nhapt   = Lo"
      "ad_Table(lr, 10);\ntamp   = Load_Table(lr, 11);\ntfreq  = Load_Table(lr, 12);\n\n% Defaults so an all-zero Load "
      "row stays safe and visible\nif m_b <= 0;    m_b = 0.2;     end\nif r_b <= 0;    r_b = 0.03;    end\nif Lslope <="
      " 0; Lslope = 0.20; end\nif kc <= 0;     kc = 2000;     end\nif Fmax <= 0;   Fmax = 20;     end\nif Fmax > 45;   "
      "Fmax = 45;     end   % hardware envelope hard clamp\nif tfreq < 50;  tfreq = 150;   end\n\nr_h = Task_Wide(1) * "
      "0.01;\nif r_h <= 0; r_h = 0.02; end\n\n% ---- geometry (global metres; Target_Table is global cm on the target) "
      "-----\ntx  = Target_Table(br, 1) * 0.01;\nty  = Target_Table(br, 2) * 0.01;\nhx0 = Target_Table(hr, 1) * 0.01;\n"
      "hy0 = Target_Table(hr, 2) * 0.01;\ndx = hx0 - tx; dy = hy0 - ty;\ndd = sqrt(dx*dx + dy*dy);\nif dd < 1e-6; dd = "
      "1; end\nux = dx / dd; uy = dy / dd;\n\n% ---- hand state (active = dominant arm; row 1 = right on bilateral) ---"
      "-----\narm = KINdata(3, 1);\nif arm ~= 2; arm = 1; end\nphx = KINdata(arm, 23);\nphy = KINdata(arm, 24);\n\n% --"
      "-- physics ----------------------------------------------------------------\nFx = 0; Fy = 0; pen = 0;\nif phase "
      "< 1.5\n    % phase 0: hidden/reset. phase 1: parked at slope top.\n    s = 0; v = 0; prev_pen = 0; have_contact "
      "= 0; t_contact = 1e9;\nelse\n    a = 0;\n    if s < Lslope\n        a = a + (5/7) * g * sin(theta);   % downhill"
      " along +u while on the slope\n    end\n    if v > 1e-4\n        a = a - crr * g;\n    elseif v < -1e-4\n        "
      "a = a + crr * g;\n    end\n\n    bxp = tx + ux * s; byp = ty + uy * s;\n    rx = phx - bxp; ry = phy - byp;\n   "
      " dist = sqrt(rx*rx + ry*ry);\n    if dist < 1e-6; dist = 1e-6; end\n    pen = (r_b + r_h) - dist;\n\n    if pen "
      "> 0\n        dpen = (pen - prev_pen) / dt;\n        fmag = kc * pen + bc * dpen;\n        if fmag < 0; fmag = 0;"
      " end\n        if have_contact == 0\n            have_contact = 1;\n            t_contact = 0;    % new contact: "
      "restart transient\n        end\n        if t_contact < 0.03 && tamp > 0\n            fmag = fmag + tamp * exp(-t"
      "_contact / 0.01) * sin(2 * pi * tfreq * t_contact);\n            if fmag < 0; fmag = 0; end\n        end\n      "
      "  if fmag > Fmax; fmag = Fmax; end\n        nx = rx / dist; ny = ry / dist;\n        Fx = fmag * nx; Fy = fmag *"
      " ny;\n        % equal and opposite on the ball, projected on the rail\n        a = a - (Fx * ux + Fy * uy) / m_b"
      ";\n    else\n        have_contact = 0;\n    end\n    t_contact = t_contact + dt;\n    prev_pen = pen;\n\n    v ="
      " v + a * dt;\n    s = s + v * dt;\n    if s < 0\n        s = 0; v = -0.2 * v;   % cannot leave the top of the sl"
      "ope\n    end\nend\n\n% ---- haptics gate (visual bounce unaffected) --------------------------------\nif hapt < "
      "0.5\n    Fx = 0; Fy = 0;\nend\nif arm == 1\n    hand_forces(1) = Fx; hand_forces(2) = Fy;\nelse\n    hand_forces"
      "(3) = Fx; hand_forces(4) = Fy;\nend\n\n% ---- VCODEs: row 1 slope line, row 2 ball circle ----------------------"
      "------\nshow = 0;\nif phase > 0.5; show = 1; end\n\nvcodes(1, 1)  = 4;                 % line\nvcodes(1, 2)  = s"
      "how;\nvcodes(1, 3)  = tx;\nvcodes(1, 4)  = ty;\nvcodes(1, 5)  = 5921370;           % 0x5A5A5A grey\nvcodes(1, 6)"
      "  = 5921370;\nvcodes(1, 7)  = 0.004;             % 4 mm stroke\nvcodes(1, 9)  = 100;\nvcodes(1, 10) = ux * Lslop"
      "e;       % endpoint relative to start (m)\nvcodes(1, 11) = uy * Lslope;\n\nbx = tx + ux * s; by = ty + uy * s;\n"
      "vcodes(2, 1)  = 1;                 % circle\nvcodes(2, 2)  = show;\nvcodes(2, 3)  = bx;\nvcodes(2, 4)  = by;\nvc"
      "odes(2, 5)  = 16777215;          % 0xFFFFFF white fill\nvcodes(2, 6)  = -2147483648;       % no stroke colour\nv"
      "codes(2, 7)  = 0;\nvcodes(2, 9)  = 100;\nvcodes(2, 10) = r_b;\nif s > dd + 0.6\n    vcodes(2, 2) = 0;           "
      "   % rolled far out of the scene\nend\n\nball_log  = [bx; by; v; pen; Fx; Fy; phase; s];\npen_out   = pen;\nspee"
      "d_out = v;\nif speed_out < 0; speed_out = -speed_out; end\n"
      editorLayout	      "100 M4x1[205 227 1080 733]"
    }
  }
