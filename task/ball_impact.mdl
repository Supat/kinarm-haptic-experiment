    Block {
      BlockType		      SubSystem
      Name		      "Parameter Table Defn"
      SID		      "4"
      Ports		      []
      Position		      [50, 320, 230, 380]
      ZOrder		      4
      BackgroundColor	      "green"
      UserDataPersistent      on
      UserData		      "DataTag1"
      CopyFcn		      "CreateParameterTableGUI('copy')"
      LoadFcn		      "CreateParameterTableGUI('load')                                                        \n% only "
      "put a pattern on the icon for R2013a and later, because prior versions of MATALB\n% do not properly support tran"
      "sparency for mask icons                                  \ncurrent_ver = ver('MATLAB');                         "
      "                                  \ncurrent_ver_parts = sscanf(current_ver.Version, '%d.%d.%d')';               "
      "           \nif length(current_ver_parts) < 3                                                       \n    curren"
      "t_ver_parts(3) = 0;                                                          \nend                              "
      "                                                      \ndesired_ver = '8.1.0';		% This is the base version for M"
      "ATLAB                          \ndesired_ver_parts = sscanf(desired_ver, '%d.%d.%d')';                          "
      "        \nif length(desired_ver_parts) < 3                                                       \n    desired_v"
      "er_parts(3) = 0;                                                          \nend                                 "
      "                                                   \nshow_icon = (sign(current_ver_parts - desired_ver_parts) * "
      "[1; 0.1; 0.01]) >= 0;       \nif show_icon                                                                      "
      "     \n	set_param(gcb, 'MaskDisplay', 'image(''ParameterTableDefnIcon.png'')' );              \nelse            "
      "                                                                       \n  set_param(gcb, 'MaskDisplay', '' );  "
      "                                                \nend                                                           "
      "                         "
      InitFcn		      "CreateParameterTableGUI('init')"
      OpenFcn		      "CreateParameterTableGUI('open')"
      MinAlgLoopOccurrences   off
      PropExecContextOutsideSubsystem off
      RTWSystemCode	      "Auto"
      FunctionWithSeparateData off
      Opaque		      off
      RequestExecContextInheritance off
      MaskHideContents	      off
      Object {
	$PropName		"MaskObject"
	$ObjectID		20
	$ClassName		"Simulink.Mask"
	Initialization		"% NOTE: the ShowInLibBrowser Parameter for this mask is required by Simulink in order\n% for this bl"
	"ock to appear in the Library Browser because the OpenFcn callback is defined\n% for this block.  For some reason, whe"
	"n the OpenFcn callback is defined, Simulink does NOT \n% show the block in the Library Browser.  The requirement of t"
	"he \"ShowInLibBrowser appears \n% to be some sort of hack solution provided by Mathworks, but it works.\n\nedit_param"
	"eters_blockpath = gcb;\n\n%%% Handle background colours if link status changes.  \ncheckBackgroundColour(edit_paramet"
	"ers_blockpath, 'General');\n\n% all data used by the mask is passed to it through the UserData parameter\n% the UserD"
	"ata is only available because we set UserDataPersistent to 'on' in the m-file\nall_tab_data = get_param(edit_paramete"
	"rs_blockpath, 'UserData');\n\n% only make the changes if required.  The update/build process is not compatible with d"
	"eleting of blocks, etc.\n% so the apply flag is only set if the dialog has been opened and changes need to be applied"
	" OR if the model \n% has just been loaded\nif all_tab_data(1).apply\n	% delete all sub-blocks to ensure a clean empty"
	" block\n	Simulink.SubSystem.deleteContents(edit_parameters_blockpath);\n\n	number_tabs = length(all_tab_data);\n\n	fo"
	"r tab = 1:number_tabs\n		% Add one sub-block per tab, to contain the various constants blocks\n		block_pos = [100, -4"
	"0, 240, 0] + tab * [0 60 0 60];\n		sub_block_name = all_tab_data(tab).sub_block_name;\n		block_path = [edit_parameter"
	"s_blockpath '/' sub_block_name];\n\n		add_block('built-in/Subsystem', block_path,  'Position', mat2str(block_pos) );\n"
	"\n		% Add new constant blocks for each row to the \"tab\" block (i.e. each parameter gets its own constant block)\n		"
	"for row_index = 1:all_tab_data(tab).num_param\n			% Add a constant sub-block to the Parameter Table block, for use by"
	" Dex\n			curr_param = all_tab_data(tab).params(row_index);\n			current_path = [edit_parameters_blockpath '/' sub_bloc"
	"k_name];\n			block_pos = [200, -40, 240, 0] + row_index * [0 60 0 60];\n			blockname = curr_param.blockname;\n			bloc"
	"k_path = [current_path '/' blockname];\n			add_block('built-in/Constant', block_path, 'Value', curr_param.paramindex,"
	" 'Position', mat2str(block_pos) );\n			% Add a terminator\n			block_pos = block_pos + [100 10 100 -10];\n			terminato"
	"r_name = ['Terminator' num2str(row_index)];\n			terminator_path = [current_path '/' terminator_name];\n			add_block('"
	"built-in/Terminator', terminator_path, 'Position', mat2str(block_pos));\n			% connect the constant and terminator blo"
	"cks\n			add_line(current_path, [blockname '/1'], [terminator_name '/1']);\n		end\n	end\n	all_tab_data(1).apply = fals"
	"e;\n	set_param(edit_parameters_blockpath, 'UserData', all_tab_data);\nend\n	\n\n% % % % only put a pattern on the ico"
	"n for R2013a and later, because prior versions of MATALB\n% % % % do not properly support transparency for mask icons"
	"\n% % % \n% % % current_ver = ver('MATLAB');\n% % % current_ver_parts = sscanf(current_ver.Version, '%d.%d.%d')';\n% "
	"% % if length(current_ver_parts) < 3\n% % %     current_ver_parts(3) = 0;\n% % % end\n% % % \n% % % desired_ver = '8."
	"1.0';		% This is the base version for MATLAB\n% % % desired_ver_parts = sscanf(desired_ver, '%d.%d.%d')';\n% % % if l"
	"ength(desired_ver_parts) < 3\n% % %     desired_ver_parts(3) = 0;\n% % % end\n% % % \n% % % show_icon = (sign(current"
	"_ver_parts - desired_ver_parts) * [1; 0.1; 0.01]) >= 0;\n% % % \n% % % if show_icon\n% % % 	set_param(edit_parameters"
	"_blockpath, 'MaskDisplay', 'image(''test3.png'')' );\n% % % else\n% % % 	set_param(edit_parameters_blockpath, 'MaskDi"
	"splay', '' );\n% % % end\n"
	SelfModifiable		"on"
	Display			"image('ParameterTableDefnIcon.png')"
	Object {
	  $PropName		  "Parameters"
	  $ObjectID		  21
	  $ClassName		  "Simulink.MaskParameter"
	  Type			  "edit"
	  Name			  "ShowInLibBrowser"
	  Prompt		  "Mask Parameter 1:"
	  Value			  "0"
	  Visible		  "off"
	}
      }
