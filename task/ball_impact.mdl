  chart {
    id			    171
    name		    "DataLogging/Poll KINARM/Create KINARM Data Array"
    windowPosition	    [1421.25 368.75 213 385]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1920 1080 1.333333333333333]
    treeNode		    [0 172 0 0]
    firstTransition	    188
    firstJunction	    187
    viewObj		    171
    machine		    1
    ssIdHighWaterMark	    17
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    firstData		    173
    chartFileNumber	    11
    disableImplicitCasting  1
    eml {
      name		      "create_KINARM_data_array"
    }
    noDebugging		    1
    supportVariableSizing   0
  }
  state {
    id			    172
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    171
    treeNode		    [171 0 0 0]
    superState		    SUBCHART
    subviewer		    171
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "% This function constructs a matrix of KINARM-related data called \"KINdata\". This matrix consis"
      "ts of three rows: the first two are each\n% for data related to the respective robot (i.e. row 1 is for robot 1 "
      "data, row 2 for robot 2 data, etc.), and the third row is for data\n% not specific to either arm. Each row of th"
      "e matrix is currently of length 50, though not all elements in each row are used.\nfunction [kinarm_data, primar"
      "y_encoder_data_out]= create_KINARM_data_array(robot_calibrations, robot_hardware_settings, force_sensor_data, .."
      ".\n                                                      robot_data, servo_update_count, delay_estimates, primar"
      "y_encoder_data, ...\n                                                      ep_calibration_button_bitfield, torqu"
      "e_command, hand_feedback_settings, dominant_arm, gaze_data)\n\nkinarm_data = zeros(3,50);\nprimary_encoder_data_"
      "out = zeros(2,6);\n\n% Create the rows of robot-specific data. The utility function create_robot_row is used to "
      "assemble the values for each row. \n% The last section of that function (in which the row elements are assigned "
      "individually) documents the row contents.\nkinarm_data(1,:) = create_robot_row(robot_calibrations(1:8), robot_ha"
      "rdware_settings(1:12), ...\n                                    force_sensor_data(1:7), robot_data(1:10), torque"
      "_command(1:2));\n\nkinarm_data(2,:) = create_robot_row(robot_calibrations(9:16), robot_hardware_settings(13:24),"
      " ...\n                                    force_sensor_data(8:14), robot_data(11:20), torque_command(3:4));\n			"
      "					\n% Create the last row of KINdata, which contains information not specific to any single arm.\nkinarm_data"
      "(3,1) = dominant_arm;                     % dominant KINARM for the experiment (1: arm 1, 2: arm 2)\nkinarm_data"
      "(3,2) = hand_feedback_settings(5);        % duration of feed forward for position of hand feedback (s)\nkinarm_d"
      "ata(3,3) = hand_feedback_settings(1);        % hand feedback arm (0: none, 1: dominant, 2: non-dominant, 3: both"
      ", 4: controlled by task program)\nkinarm_data(3,4) = hand_feedback_settings(2);        % hand feedback settings "
      "source (0: GUI, 1: from task program)\nkinarm_data(3,5) = hand_feedback_settings(4);        % feedback colour (R"
      "RRGGGBBB string converted to integer)\nkinarm_data(3,6) = hand_feedback_settings(3);        % feedback radius (m"
      ")\nkinarm_data(3,7) = 1;                                % global load enable set by BKIN client software (no lon"
      "ger an option; thus always on)\nkinarm_data(3,8) = delay_estimates(1);               % primary encoders velocity"
      " delay estimate (s)\nkinarm_data(3,9) = delay_estimates(2);               % primary encoders acceleration delay "
      "estimate (s)\nkinarm_data(3,10) = delay_estimates(3);              % secondary encoders velocity delay estimate "
      "(s)\nkinarm_data(3,11) = delay_estimates(4);              % secondary encoders acceleration delay estimate (s)\n"
      "kinarm_data(3,12) = servo_update_count;              % servo update count\nkinarm_data(3,13) = ep_calibration_bu"
      "tton_bitfield;  % EP calibration button status bitfield\n\ngaze_available = gaze_data(1);\nkinarm_data(3,14) = g"
      "aze_available;              % is Gaze tracking hardware available\nkinarm_data(3,15) = hand_feedback_settings(6)"
      ";   % Gaze feedback (0: on, 1: controlled by task program)\n\nif gaze_available\n    kinarm_data(3,16) = gaze_da"
      "ta(2);            % Gaze X location in global coordinates\n    kinarm_data(3,17) = gaze_data(3);            % Ga"
      "ze Y location in global coordinates\n    kinarm_data(3,18) = gaze_data(4);            % Gaze Timestamp in second"
      "s\n    kinarm_data(3,19) = gaze_data(5);            % Gaze pupil area\n    kinarm_data(3,20) = gaze_data(6);    "
      "      % Gaze Event ID\n    kinarm_data(3,21) = gaze_data(7);          % Gaze Event start time in seconds\n    ki"
      "narm_data(3,22) = gaze_data(8);          % Gaze Event end time in seconds    \nelse\n    kinarm_data(3,16) = -10"
      "0;                    % Gaze X location in global coordinates\n    kinarm_data(3,17) = -100;                    "
      "% Gaze Y location in global coordinates\n    kinarm_data(3,18) = -100;                    % Gaze Timestamp in se"
      "conds\n    kinarm_data(3,19) = -100;                    % Gaze Timestamp in seconds\nend\n\n% Create the two row"
      "s of primary encoder data. These outputs are analogous to the L1/L2 outputs in kinarm_data, the difference being"
      " that\n% these are always derived from the primary encoders while the contents of kinarm_data is derived from th"
      "e primary or secondary encoders\n% (depending on the user's choice of whether or not to use the secondary encode"
      "rs in the GUI).\nfor i = 1:2\n	offset = (i-1)*6;\n    \n    relative_shoulder_angle = primary_encoder_data(1 + o"
      "ffset);\n    relative_elbow_angle = primary_encoder_data(2 + offset);\n    shoulder_velocity = primary_encoder_d"
      "ata(3 + offset);\n    elbow_velocity = primary_encoder_data(4 + offset);\n    shoulder_acceleration = primary_en"
      "coder_data(5 + offset);\n    elbow_acceleration = primary_encoder_data(6 + offset);\n\n    shoulder_angle_offset"
      " = robot_calibrations(1 + (i-1)*8);\n    elbow_angle_offset = robot_calibrations(2 + (i-1)*8);\n	L1 = robot_cali"
      "brations(5 + (i-1)*8);                               % L1 (upper arm segment) length (m)\n	L3_error = robot_cali"
      "brations(8 + (i-1)*8);                         % L3 error, the difference between lengths L3 and L5 (m)\n    \n "
      "   hwoffset = (i-1)*12;\n	robot_orientation = robot_hardware_settings(7 + hwoffset);          % robot orientatio"
      "n (1: right-handed from robot perspective, -1: left-handed from robot perspective)\n 	L5 = robot_hardware_settin"
      "gs(3 + hwoffset);                         % L5 segment length (m)\n	L2_L5_angle = robot_hardware_settings(4 + hw"
      "offset);                % angle of L2 relative to L5 (rad)\n    robot_type = robot_hardware_settings(1 + hwoffse"
      "t);\n    isExo = robot_type == 0 || robot_type == 2;\n    \n	% Before proceeding, the shoulder and elbow angles "
      "are shifted by the offsets determined by the calibration. If the calibration has been\n	% performed correctly, t"
      "his ensures that the angle of 0 corresponds to when the arm is aligned with the coronal plane. In the case of th"
      "e \n	% elbow angle for a KINARM EXO, an extra correction is performed (using a utility function, and according t"
      "o the current calibration) to \n	% account for small imperfections in the parallelogram of KINARM links caused b"
      "y differences in the lengths of L3 and L5 (which are \n	% theoretically equal).\n	shoulder_angle = relative_shou"
      "lder_angle + shoulder_angle_offset;\n\n	% If the robot is an Exoskeleton, use the correct_elbow_angle function t"
      "o account for imperfections on the KINARM robot parallelogram structure\n	if isExo  \n		[angle_corr, vel_corr, a"
      "cc_corr] = correct_elbow_angle(relative_elbow_angle + elbow_angle_offset, elbow_velocity, elbow_acceleration, L2"
      "_L5_angle, L1, L5, L3_error);				\n		elbow_angle = relative_elbow_angle + elbow_angle_offset + angle_corr;\n		el"
      "bow_velocity = elbow_velocity + vel_corr;\n		elbow_acceleration = elbow_acceleration + acc_corr;		\n	else\n		elb"
      "ow_angle = relative_elbow_angle + elbow_angle_offset;\n	end\n\n    L1_angle = shoulder_angle;\n    L2_angle = sh"
      "oulder_angle + elbow_angle;\n\n    L1_velocity = shoulder_velocity;\n    L2_velocity = shoulder_velocity + elbow"
      "_velocity;\n\n    L1_acceleration = shoulder_acceleration;\n    L2_acceleration = shoulder_acceleration + elbow_"
      "acceleration;\n\n	% a robot_orientation < 0 means that the robot is left-handed from its perspective (i.e. if yo"
      "u look at the robot structure, \n	% and pretend that it is a humanoid, the robot itself looks left-handed).  For"
      " an Exoskeleton robot, this is the\n	% robot that the left-hand of the subject grabs. For an EP robot, this is t"
      "he robot that the subjec'ts right-hand grabs.  \n	\n    if robot_orientation < 0\n        L1_angle = -L1_angle +"
      " pi;\n        L2_angle = -L2_angle + pi;\n\n        L1_velocity = -L1_velocity;\n        L2_velocity = -L2_veloc"
      "ity;\n\n        L1_acceleration = -L1_acceleration;\n        L2_acceleration = -L2_acceleration;\n    end\n\n   "
      " primary_encoder_data_out(i,1) = L1_angle;\n    primary_encoder_data_out(i,2) = L2_angle;\n    \n    primary_enc"
      "oder_data_out(i,3) = L1_velocity;\n    primary_encoder_data_out(i,4) = L2_velocity;\n    \n    primary_encoder_d"
      "ata_out(i,5) = L1_acceleration;\n    primary_encoder_data_out(i,6) = L2_acceleration;\nend\n\n\n%%%%%%%%%%%%%%%%"
      "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n%%%%%%"
      "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
      "%%\n% This function creates a row of arm-specific data for the KINARM data matrix. \nfunction robot_row = create"
      "_robot_row(calibration, hardware_settings, force_sensor_data, robot_data, torque_command)\n\n% Extract the relev"
      "ant information from each input array.\nshoulder_angle_offset = calibration(1);            % offset added to mot"
      "ion control card shoulder angle to get real angle (rad)\nelbow_angle_offset = calibration(2);               % of"
      "fset added to motion control card elbow angle to get real angle (rad)\nshoulder_position_x = calibration(3);    "
      "          % shoulder x position (m) (global coordinates)\nshoulder_position_y = calibration(4);              % s"
      "houlder y position (m) (global coordinates)\nL1 = calibration(5);                               % L1 (upper arm "
      "segment) length (m)\nL2 = calibration(6);                               % L2 (forearm segment) length (m); segme"
      "nt length puts distal end in line with subject pointer\npointer_offset = calibration(7);                   % per"
      "pendicular distance from L2 to subject pointer (m)\nL3_error = calibration(8);                         % L3 erro"
      "r, the difference between lengths L3 and L5 (m)\n\nrobot_type = hardware_settings(1);                 % robot ty"
      "pe (0: EXO, 1: EP, 2:NHP)\nisExo = robot_type == 0 || robot_type == 2;\nisEP = robot_type == 1;\nL5 = hardware_s"
      "ettings(3);                         % L5 segment length (m)\nL2_L5_angle = hardware_settings(4);                "
      "% angle of L2 relative to L5 (rad)\nforce_sensor_angle_offset = hardware_settings(5);  % offset of force sensor "
      "from forearm linkage (rad)\nrobot_orientation = hardware_settings(7);          % robot orientation (1: right-han"
      "ded from robot perspective, -1: left-handed from robot perspective)\n\nforce_sensor_force_u = force_sensor_data("
      "1);       % force sensor u force (N)\nforce_sensor_force_v = force_sensor_data(2);       % force sensor v force "
      "(N)\nforce_sensor_force_w = force_sensor_data(3);       % force sensor w force (N)\nforce_sensor_torque_u = forc"
      "e_sensor_data(4);      % force sensor u torque (Nm) \nforce_sensor_torque_v = force_sensor_data(5);      % force"
      " sensor v torque (Nm)\nforce_sensor_torque_w = force_sensor_data(6);      % force sensor w torque (Nm)\nforce_se"
      "nsor_timestamp = force_sensor_data(7);      % force sensor w torque (Nm)\n\nrelative_shoulder_angle = robot_data"
      "(1);        % current shoulder joint angle (rad)\nrelative_elbow_angle = robot_data(2);           % current elbo"
      "w joint angle (rad)\nshoulder_velocity = robot_data(3);                 % shoulder joint angular velocity (rad/s"
      ")\nelbow_velocity = robot_data(4);                    % elbow joint angular velocity (rad/s)\nshoulder_accelerat"
      "ion = robot_data(5);             % shoulder joint angular acceleration (rad/s^2)\nelbow_acceleration = robot_dat"
      "a(6);                % elbow joint angular acceleration (rad/s^2)\nfiltered_shoulder_velocity = robot_data(7);  "
      "      % filtered shoulder velocity (rad/s)\nfiltered_elbow_velocity = robot_data(8);           % filtered elbow "
      "velocity (rad/s)\nmotor1_status = robot_data(9);                     % motor 1 status\nmotor2_status = robot_dat"
      "a(10);                    % motor 2 status\n\nshoulder_torque_cmd = torque_command(1);	       % commanded should"
      "er torque (Nm)\nelbow_torque_cmd = torque_command(2);              % commanded elbow torque (Nm)\n\n\n\n% With t"
      "he inputs unpacked, start using them to compute other values that will be included in the data array. Some input"
      "s are included in the\n% array directly, but the kinematic data is also developed from the joint-based informati"
      "on supplied by the polling function into information \n% about the arm segments, the elbow, and the hand/fingert"
      "ip as described in the following sections.\n\n% Before proceeding, the shoulder and elbow angles are shifted by "
      "the offsets determined by the calibration. If the calibration has been\n% performed correctly, this ensures that"
      " the angle of 0 corresponds to when the arm is aligned with the coronal plane. In the case of the \n% elbow angl"
      "e for a KINARM EXO, an extra correction is performed (using a utility function, and according to the current cal"
      "ibration) to \n% account for small imperfections in the parallelogram of KINARM links caused by differences in t"
      "he lengths of L3 and L5 (which are \n% theoretically equal).\nshoulder_angle = relative_shoulder_angle + shoulde"
      "r_angle_offset;\n\n% If the robot is an Exoskeleton, use the correct_elbow_angle function to account for imperfe"
      "ctions on the KINARM robot parallelogram structure\nif isExo\n	[angle_corr, vel_corr, acc_corr] = correct_elbow_"
      "angle(relative_elbow_angle + elbow_angle_offset, elbow_velocity, elbow_acceleration, L2_L5_angle, L1, L5, L3_err"
      "or);\n	elbow_angle = relative_elbow_angle + elbow_angle_offset + angle_corr;\n	elbow_velocity = elbow_velocity +"
      " vel_corr;\n	elbow_acceleration = elbow_acceleration + acc_corr;\nelse\n	elbow_angle = relative_elbow_angle + el"
      "bow_angle_offset;\nend\n\n% Convert robot orientation as supplied in the hardware settings (a scaling factor use"
      "d to calculate robot data) to the number 1 or 2,\n% indicating which of the subject's arms will normally be usin"
      "g the robot: right or left, respectively. This is done to be consistent \n% with previous versions of the TDK. N"
      "ote that the robot orientations of KINARM EP robots are \"opposite\" those for KINARM EXOs when.\nif (isEP && ro"
      "bot_orientation < 0.0) || (isExo && robot_orientation > 0.0)\n    arm_orientation = 1;  % right arm orientation "
      "expected for subject\nelse\n    arm_orientation = 2;  % left arm orientation expected for subject\nend\n\n% Crea"
      "te a motor status variable for the robot that is consistent with previous versions of the TDK: the value forms a"
      " bitfield in\n% which non-zero bits indicate a motor is disabled or faulted. The least significant bit is motor "
      "1; the next is motor 2.\nmotor_status = motor2_status * 2 + motor1_status;\n\n% Calculate segment information, i"
      ".e. positions, velocities, and accelerations for L1 and L2. \"Segment-based\" values here differ from the\n% \"j"
      "oint-based\" values in a few ways, though they are still expressed in angles:\n%   i) elbow angles are no longer"
      " shoulder-relative (that is, L2 angles are not relative to L1)\n%  ii) positions are expressed with the correcti"
      "ons calculated above\n% iii) all angles are expressed in the same system, where 0 is the angular position of the"
      " exoskeleton right arm when aligned with the \n%      coronal plane and positive changes in angle correspond to "
      "counterclockwise movements.\n%\n% This section also determines the torque commands for motor 1 (shoulder) and mo"
      "tor 2 (elbow). When a positive torque is applied to the \n% forearm linkage by motor 2 it causes the same positi"
      "ve force on the upper arm linkage, so the torque applied to motor 1 is the desired\n% shoulder torque less any t"
      "orque commanded at the elbow.\n\nL1_angle = shoulder_angle;\nL2_angle = shoulder_angle + elbow_angle;\n\npointer"
      "_angle = shoulder_angle + elbow_angle + pi/2;\n    \nL1_velocity = shoulder_velocity;\nL2_velocity = shoulder_ve"
      "locity + elbow_velocity;\n	\nL1_acceleration = shoulder_acceleration;\nL2_acceleration = shoulder_acceleration +"
      " elbow_acceleration;\n    \nM1_torque_cmd = shoulder_torque_cmd - elbow_torque_cmd;\nM2_torque_cmd = elbow_torqu"
      "e_cmd;\n\n% a robot_orientation < 0 means that the robot is left-handed from its perspective (i.e. if you look a"
      "t the robot structure, \n% and pretend that it is a humanoid, the robot itself looks left-handed).  For an Exosk"
      "eleton robot, this is the\n% robot that the left-hand of the subject grabs. For an EP robot, this is the robot t"
      "hat the subjec'ts right-hand grabs.  \n\nif (robot_orientation == -1)\n    L1_angle = -L1_angle + pi;\n    L2_an"
      "gle = -L2_angle + pi;\n    \n    pointer_angle = -pointer_angle + pi;\n    \n    L1_velocity = -L1_velocity;\n  "
      "  L2_velocity = -L2_velocity;\n    \n    L1_acceleration = -L1_acceleration;\n    L2_acceleration = -L2_accelera"
      "tion;\n    \n    M1_torque_cmd = -M1_torque_cmd;\n    M2_torque_cmd = -M2_torque_cmd;\nend\n\n% Calculate elbow "
      "information, i.e. position, velocity, and acceleration, in X-Y space rather than joint angles.\nelbow_position_x"
      " = shoulder_position_x + (L1 * cos(L1_angle));\nelbow_position_y = shoulder_position_y + (L1 * sin(L1_angle));\n"
      "\nelbow_velocity_x = -L1 * sin(L1_angle) * L1_velocity;\nelbow_velocity_y =  L1 * cos(L1_angle) * L1_velocity;\n"
      "\nelbow_acceleration_x = -L1 * (( cos(L1_angle) * L1_velocity^2) + (sin(L1_angle) * L1_acceleration));\nelbow_ac"
      "celeration_y =  L1 * ((-sin(L1_angle) * L1_velocity^2) + (cos(L1_angle) * L1_acceleration));\n\n% Calculate fing"
      "ertip/subject pointer/hand feedback information, i.e. position, velocity, and acceleration, in X-Y space.\nhand_"
      "position_x = elbow_position_x + (L2 * cos(L2_angle)) + (pointer_offset * cos(pointer_angle));\nhand_position_y ="
      " elbow_position_y + (L2 * sin(L2_angle)) + (pointer_offset * sin(pointer_angle));\n\nhand_velocity_x = elbow_vel"
      "ocity_x - (L2 * sin(L2_angle) * L2_velocity) - (pointer_offset * sin(pointer_angle) * L2_velocity);\nhand_veloci"
      "ty_y = elbow_velocity_y + (L2 * cos(L2_angle) * L2_velocity) + (pointer_offset * cos(pointer_angle) * L2_velocit"
      "y);\n\nhand_acceleration_x = elbow_acceleration_x - (L2 * (( cos(L2_angle) * L2_velocity^2) + (sin(L2_angle) * L"
      "2_acceleration))) - ...\n    (pointer_offset * (( cos(pointer_angle) * L2_velocity^2) + (sin(pointer_angle) * L2"
      "_acceleration)));\nhand_acceleration_y = elbow_acceleration_y + (L2 * ((-sin(L2_angle) * L2_velocity^2) + (cos(L"
      "2_angle) * L2_acceleration))) + ...\n    (pointer_offset * ((-sin(pointer_angle) * L2_velocity^2) + (cos(pointer"
      "_angle) * L2_acceleration)));\n\n% Calculate force sensor data for EP robots, or zero it for EXO robots. On each"
      " EP robot the force sensor is mounted at known angle to \n% the forearm linkage, which is specified as an input "
      "to this block. Two variants of the data are calculated: i) scaled in the force \n% sensor's local coordinate sys"
      "tem (\"uvw\"), and ii) transformed to be in the global coordinate system (\"xyz\").\nif isEP\n    \n    force_se"
      "nsor_force_u = force_sensor_force_u / 1000000.0;  % scale values to SI using factors defined in force sensor con"
      "figurations\n    force_sensor_force_v = force_sensor_force_v / 1000000.0;\n    force_sensor_force_w = force_sens"
      "or_force_w / 1000000.0;\n\n    force_sensor_torque_u = force_sensor_torque_u / 1000000.0;\n    force_sensor_torq"
      "ue_v = force_sensor_torque_v / 1000000.0;\n    force_sensor_torque_w = force_sensor_torque_w / 1000000.0;\n\n   "
      " sensor_u_angle = L2_angle - force_sensor_angle_offset;\n    sensor_v_angle = L2_angle - force_sensor_angle_offs"
      "et - pi/2;\n    \n    force_sensor_force_x = force_sensor_force_u * cos(sensor_u_angle) + force_sensor_force_v *"
      " cos(sensor_v_angle);\n    force_sensor_force_y = force_sensor_force_u * sin(sensor_u_angle) + force_sensor_forc"
      "e_v * sin(sensor_v_angle);\n    force_sensor_force_z = -force_sensor_force_w;\n\n    force_sensor_torque_x = dou"
      "ble(force_sensor_torque_u * cos(sensor_u_angle) + force_sensor_torque_v * cos(sensor_v_angle));\n    force_senso"
      "r_torque_y = double(force_sensor_torque_u * sin(sensor_u_angle) + force_sensor_torque_v * sin(sensor_v_angle));\n"
      "    force_sensor_torque_z = double(-force_sensor_torque_w);\n    \nelse\n    force_sensor_force_u = 0.0;\n    fo"
      "rce_sensor_force_v = 0.0;\n    force_sensor_force_w = 0.0;\n\n    force_sensor_torque_u = 0.0;\n    force_sensor"
      "_torque_v = 0.0;\n    force_sensor_torque_w = 0.0;\n\n    force_sensor_force_x = 0.0;\n    force_sensor_force_y "
      "= 0.0;\n    force_sensor_force_z = 0.0;\n\n    force_sensor_torque_x = 0.0;\n    force_sensor_torque_y = 0.0;\n "
      "   force_sensor_torque_z = 0.0;\nend\n\n% Construct the arm data array. Its construction is laid out here explic"
      "itly to provide comments for each entry (some are repeats from above). \nrobot_row = zeros(1,50);\n\nrobot_row(1"
      ",1) = L1;                            % L1 (upper arm segment) length (m)\nrobot_row(1,2) = L2;                  "
      "          % L2 (forearm segment) length (m); segment length puts distal end in line with subject pointer\nrobot_"
      "row(1,3) = pointer_offset;                % perpendicular distance from L2 to subject pointer (m)\nrobot_row(1,4"
      ") = shoulder_position_x;           % shoulder x position (m) (global coordinates)\nrobot_row(1,5) = shoulder_pos"
      "ition_y;           % shoulder y position (m) (global coordinates)\nrobot_row(1,6) = arm_orientation;            "
      "   % subject's expected arm orientation (1: right, 2: left)\nrobot_row(1,7) = shoulder_angle;				% shoulder join"
      "t angle, with correction for offsets (see above) (rad)\nrobot_row(1,8) = elbow_angle;					% elbow joint angle, w"
      "ith correction for offsets (see above) (rad)\nrobot_row(1,9) = shoulder_velocity;             % shoulder joint a"
      "ngular velocity (rad/s)\nrobot_row(1,10) = elbow_velocity;               % elbow joint angular velocity (rad/s)\n"
      "robot_row(1,11) = shoulder_acceleration;        % shoulder joint angular acceleration (rad/s^2)\nrobot_row(1,12)"
      " = elbow_acceleration;           % elbow joint angular acceleration (rad/s^2)\nrobot_row(1,13) = shoulder_torque"
      "_cmd;          % commanded shoulder torque (Nm)\nrobot_row(1,14) = elbow_torque_cmd;             % commanded elb"
      "ow torque (Nm)\nrobot_row(1,15) = M1_torque_cmd;                % commanded motor 1 torque (shoulder torque less"
      " elbow torque) (Nm)\nrobot_row(1,16) = M2_torque_cmd;                % commanded motor 2 torque (Nm)\nrobot_row("
      "1,17) = L1_angle;                     % upper arm angle with corrections, orientation-independent (see above) (r"
      "ad)\nrobot_row(1,18) = L2_angle;                     % forearm angle with corrections, orientation and shoulder-"
      "independent (see above) (rad)\nrobot_row(1,19) = L1_velocity;                  % upper arm angular velocity, ori"
      "entation-independent (see above) (rad/s)\nrobot_row(1,20) = L2_velocity;                  % forearm angular velo"
      "city, orientation and shoulder-independent (see above) (rad/s)\nrobot_row(1,21) = L1_acceleration;              "
      "% upper arm angular acceleration, orientation-independent (see above) (rad/s^2)\nrobot_row(1,22) = L2_accelerati"
      "on;              % forearm angular acceleration, orientation and shoulder-independent (see above) (rad/s^2)\nrob"
      "ot_row(1,23) = hand_position_x;              % fingertip position in x (m)\nrobot_row(1,24) = hand_position_y;  "
      "            % fingertip position in y (m)\nrobot_row(1,25) = hand_velocity_x;              % fingertip velocity "
      "in x (m/s)\nrobot_row(1,26) = hand_velocity_y;              % fingertip velocity in y (m/s)\nrobot_row(1,27) = h"
      "and_acceleration_x;          % fingertip acceleration in x (m/s^2)\nrobot_row(1,28) = hand_acceleration_y;      "
      "    % fingertip acceleration in y (m/s^2)\nrobot_row(1,29) = elbow_position_x;             % elbow position in x"
      " (m)\nrobot_row(1,30) = elbow_position_y;             % elbow position in y (m)\nrobot_row(1,31) = elbow_velocit"
      "y_x;             % elbow velocity in x (m/s)\nrobot_row(1,32) = elbow_velocity_y;             % elbow velocity i"
      "n y (m/s)\nrobot_row(1,33) = elbow_acceleration_x;         % elbow acceleration in x (m/s^2)\nrobot_row(1,34) = "
      "elbow_acceleration_y;         % elbow acceleration in y (m/s^2)\nrobot_row(1,35) = filtered_shoulder_velocity;  "
      " % filtered shoulder velocity from motion control card (rad/s)\nrobot_row(1,36) = filtered_elbow_velocity;      "
      "% filtered elbow velocity from motion control card (rad/s)\nrobot_row(1,37) = motor_status;                 % mo"
      "tor status (bitfield; each 0: motor enabled, 1: motor disabled/faulted)\nrobot_row(1,38) = force_sensor_force_u;"
      "         % force measured by force sensor along u in its local coordinate system (N)\nrobot_row(1,39) = force_se"
      "nsor_force_v;         % force measured by force sensor along v in its local coordinate system (N)\nrobot_row(1,4"
      "0) = force_sensor_force_w;         % force measured by force sensor along w in its local coordinate system (N)\n"
      "robot_row(1,41) = force_sensor_torque_u;        % torque measured by force sensor along u in its local coordinat"
      "e system (Nm)\nrobot_row(1,42) = force_sensor_torque_v;        % torque measured by force sensor along v in its "
      "local coordinate system (Nm)\nrobot_row(1,43) = force_sensor_torque_w;        % torque measured by force sensor "
      "along w in its local coordinate system (Nm)\nrobot_row(1,44) = force_sensor_force_x;         % force measured by"
      " force sensor along x in the global coordinate system (N)\nrobot_row(1,45) = force_sensor_force_y;         % for"
      "ce measured by force sensor along y in its local coordinate system (N)\nrobot_row(1,46) = force_sensor_force_z; "
      "        % force measured by force sensor along z in its local coordinate system (N)\nrobot_row(1,47) = force_sen"
      "sor_torque_x;        % torque measured by force sensor along x in its local coordinate system (Nm)\nrobot_row(1,"
      "48) = force_sensor_torque_y;        % torque measured by force sensor along y in its local coordinate system (Nm"
      ")\nrobot_row(1,49) = force_sensor_torque_z;        % torque measured by force sensor along z in its local coordi"
      "nate system (Nm)\nrobot_row(1,50) = force_sensor_timestamp;       % The timestamp from the force sensor(s)\n\n\n"
      "\nfunction [angle_corr vel_corr acc_corr] = correct_elbow_angle(elbow_angle, elbow_vel, elbow_acc, theta2_5, L1,"
      " L5, L3_error)\n\n% this function corrects for errors in non-perfect parallelogram structure\n% It assumes that "
      "L5 is exact (because it is machined from one\n% piece of material) and that there is an error in L3.  Note: alth"
      "ough\n% there could also be an error in L4, this 'correction' factor can\n% effectively account for both errors "
      "by computing an equivalent L3_error\n\nL3 = L5 + L3_error;\n\ntheta1_3 = theta2_5 - elbow_angle;		%actual angle "
      "between links 1 and 3\ndtheta1_3dt = - elbow_vel;\nd2theta1_3d2t = - elbow_acc;\n\n% The following shifts theta1"
      "_3 to between -pi and pi and stores the shift.\n% Although theta1_3 should always be between 0 and pi, during in"
      "itial\n% calibration there might be some values outside of that range.\ntheta1_3_2pi_offset = floor( (theta1_3 +"
      " pi)/(2 *pi) );\ntheta1_3 = theta1_3 - theta1_3_2pi_offset * 2 * pi;\n\n%Option 1a\na = 4 * L3 * L5 - 4*L1*L5*co"
      "s(theta1_3);\nb = -4 * L1 * L5 * sin(theta1_3);\nc = L3^2 + L5^2 - 2 * L3 * L5 - 2 * L1 * L3_error * cos(theta1_"
      "3) ;\n\ndbdt = -4 * L1 * L5 * cos(theta1_3) * dtheta1_3dt;\ndcdt = 2 * L1 * L3_error * sin(theta1_3) * dtheta1_3"
      "dt;\n\nd2bdt2 = 4 * L1 * L5 * sin(theta1_3) * dtheta1_3dt^2 -4 * L1 * L5 * cos(theta1_3) * d2theta1_3d2t;\nd2cdt"
      "2 = 2 * L1 * L3_error * cos(theta1_3) * dtheta1_3dt^2 + 2 * L1 * L3_error * sin(theta1_3) * d2theta1_3d2t;\n\nsq"
      "root = sqrt( b^2 - 4 * a * c);\n\nif sqroot > 0\n	if b > 0\n		sinU = (-b + sqroot ) / (2 * a);\n		dsinUdt = (-db"
      "dt + 1/2 * 1/sqroot * (2*b*dbdt -4*a*dcdt) ) / (2 * a);\n		d2sinUdt2 = (-d2bdt2 - 1/4 * 1/sqroot^3 * (2*b*dbdt -"
      "4*a*dcdt)^2 + 1/2 * 1/sqroot * (2*dbdt^2 + 2*b*d2bdt2 -4*a*d2cdt2) ) / (2 * a); \n	else\n		sinU = (-b - sqroot )"
      " / (2 * a);\n		dsinUdt = (-dbdt - 1/2 * 1/sqroot * (2*b*dbdt -4*a*dcdt) ) / (2 * a);\n		d2sinUdt2 = (-d2bdt2 + 1"
      "/4 * 1/sqroot^3 * (2*b*dbdt -4*a*dcdt)^2 - 1/2 * 1/sqroot * (2*dbdt^2 + 2*b*d2bdt2 -4*a*d2cdt2) ) / (2 * a); \n	"
      "end\nelse\n	sinU = -b / (2 * a);\n	dsinUdt = -dbdt / (2 * a);\n	d2sinUdt2 = -d2bdt2 / (2 * a); \nend	\n\nif sinU"
      " > 1\n	sinU = 1;\nelseif sinU < -1\n	sinU = -1;\nend\n\nU = asin(sinU);\n\ntheta1_5_corr = 2 * U;\nvel1_5_corr ="
      " 2 / sqrt(1 - sinU^2) * dsinUdt;\nacc1_5_corr = 2 / (1 - sinU^2)^(3/2) * sinU * (dsinUdt)^2 + 2 / sqrt(1 - sinU^"
      "2) * d2sinUdt2;\n\nangle_corr = - theta1_5_corr;\nvel_corr = - vel1_5_corr;\nacc_corr = - acc1_5_corr;\n"
      editorLayout	      "100 M4x1[25 25 1673 858]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
