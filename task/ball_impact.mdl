		Annotation {
		  SID			  "3:121"
		  Name			  "This subsystem packs data frames to create the data portion of the UDP packets, and sets its strobe outp"
		  "ut high to indicate when a\nnew chunk of packed data is ready. The number of frames per packet is determined to be"
		  " the smaller of floor(300/width of signal)\nand 6, as i) we aim at a maximum size of around 1200 to keep it well b"
		  "elow the MTU (300x4 bytes per single), and ii) the hardwired \ndelay structure below stores at most 6 frames befor"
		  "e adding empty zeros. A size 300 output is always created, as having an undefined \nport width causes Simulink pro"
		  "blems."
		  Position		  [24, 57]
		  HorizontalAlignment	  "left"
		  ZOrder		  -1
		}
