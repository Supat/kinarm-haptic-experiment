		Annotation {
		  SID			  "3:288"
		  Name			  "This PMAC needs a 16-bit integer for the watchdog input, but writemem \nonly writes singles.  So we need"
		  " to typecast to single first "
		  Position		  [561, 388]
		  HorizontalAlignment	  "left"
		  ZOrder		  -1
		}
		Annotation {
		  SID			  "3:287"
		  Name			  "This subsystem provides BKIN client software with access to the DPRAM of the motion control card.\n\nTo "
		  "read a value from DPRAM: write the value's offset to DPRAMReadOffset, set the switch indicating \nwhether the addr"
		  "ess holds a floating or fixed point value, then set the read switch high and allow the\nresult to propagate. Read "
		  "the value, stored as a double, from DPRAMReadValue.\n\nTo write a value to DPRAM: write the value to DPRAMWriteVal"
		  "ue and its offset to DPRAMWriteOffset,\nset the write switch high, and then allow the result to propagate. There i"
		  "s currently no option to write\nvalues as UInt32s, akin to that for reading values.\n\nThe default value for the o"
		  "ffsets (0x216) is the lowest meaningful offset, the PLC switch variable."
		  Position		  [21, 88]
		  HorizontalAlignment	  "left"
		  ZOrder		  -2
		}
	      }
	    }
