  state {
    id			    365
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    364
    treeNode		    [364 0 0 0]
    superState		    SUBCHART
    subviewer		    364
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [gazeXYCalculated, pupil_area_GLOBAL] = fcn(input, pupil_area_PIXELS, tracking_status, t"
      "racking_available, camtheta,camera_GLOBAL, focal_length, target_distance_in)\n\n% The following are some details"
      " on the Eyelink camera\nEL_target_distance_scaling_factor = 10000;					%target distance is reported by Eyelink i"
      "n 1/10 of mm units\nEL_pix_per_mm = 200;										%there are 200 pixels/mm on the Eyelink 1000 camera sensor\n\n"
      "raw_pupil = [input(1) input(2)];\nhref = [input(3); input(4); 0];\ntarget_distance = target_distance_in / EL_tar"
      "get_distance_scaling_factor;		% distance of the target from the camera (m)\n\n%if there is a blink or other prob"
      "lem then send out errors. C3D file does not like NaN, so we output -100.\nif tracking_status == 4 || tracking_av"
      "ailable == 0 || (href(1) == 0 && href(2) == 0) || (raw_pupil(1) == -32768 && raw_pupil(2) == -32768)\n    gazeXY"
      "Calculated = [-100; -100];\n	pupil_area_GLOBAL = -100;\n% % % 	testing = [0 0 0 0 0 0];\n% % % 	testing2 = [0; 0"
      "; 0; 0; 0; 0];\n    return\nend\n\n[Rx Ry Rz] = calc_R_from_angles(camtheta(1), camtheta(2), 0);\nR_CMRA2GLBL = "
      "Rx * Ry;\n%R_GLBL2CMRA = R_CMRA2GLBL';\n\n%camera_GLOBAL_Trans = camera_GLOBAL';\npupil_XY_Sensor = convertPupil"
      "ToSensor(raw_pupil(1), raw_pupil(2), EL_pix_per_mm);\n[gaze_GLOBAL, pupil_GLOBAL] = calc_GAZE(pupil_XY_Sensor, t"
      "arget_distance, href, focal_length, camera_GLOBAL, R_CMRA2GLBL);\ngazeXYCalculated = gaze_GLOBAL(1:2);\n\n%%conv"
      "ert the pupil area from pixels on the sensor, to m^2, correcting for camera and gaze angle\n% pupil area on the "
      "camera sensor, in m^2\npupil_area_SENSOR = pupil_area_PIXELS / ( (EL_pix_per_mm * 1000 ) ^ 2);		\n\n% pupil area"
      " in the global workspace, projected onto a plane parallel to the camera sensor in m^2\npupil_area_GLOBAL_project"
      "ion = pupil_area_SENSOR * (target_distance / focal_length) ^ 2; \n\n% create a unit vector that is normal to the"
      " camera sensor, in GLOBAL coordinates\nsensor_unit_vector_GLOBAL = R_CMRA2GLBL * [0; 0; 1];\n\n% create a unit v"
      "ector for the subject's gaze\ngaze_vector_GLOBAL = pupil_GLOBAL - gaze_GLOBAL;\ngaze_unit_vector_GLOBAL = gaze_v"
      "ector_GLOBAL / norm(gaze_vector_GLOBAL);\n\n% calculate the cosine of the angle between the unit vectors for gaz"
      "e and the camera sensor\ncos_gaze_camera_angle = dot(sensor_unit_vector_GLOBAL, gaze_unit_vector_GLOBAL); \n\n% "
      "correct the pupil area to account for the angle of the eye relative to the camera sensor plane\n% We assume that"
      " the pupil is circular. In the plane formed by the two vectors, the distance needs \n% to be scaled by cos(theta"
      "). In the perpendicular plane, there is no scaling. Hence we do NOT \n% square the cos(theta) and the area is on"
      "ly corrected for by 1 / cos(theta). \npupil_area_GLOBAL = pupil_area_GLOBAL_projection / cos_gaze_camera_angle;\n"
      "\n% % % % For testing\n% % % gaze_camera_angle  = acos(cos_gaze_camera_angle) * 180/pi();\n% % % HREF_angle = at"
      "an2( norm(href), 15000) * 180 / pi();\n% % % testing = [pupil_area_SENSOR*1e6, pupil_area_GLOBAL_projection*1e6,"
      " pupil_area_GLOBAL*1e6, gaze_camera_angle, HREF_angle, cos_gaze_camera_angle];\n% % % testing2 = [sensor_unit_ve"
      "ctor_GLOBAL; gaze_unit_vector_GLOBAL];\n\n\n\n%% Functions\nfunction [gaze_est_GLOBAL, pupil_GLOBAL] = calc_GAZE"
      "(pupil_SENSOR, target_distance, HREF_HREF, focal_length, camera_GLOBAL, R_CMRA2GLBL)\n    % This function estima"
      "tes GAZE based on data from the Eyelink.  To be used\n    % during 'running' of a task. \n\n    % Convert pupil "
      "location from Eyelink sensor frame to camera reference\n    % frame with camera at origin and rotated to camera'"
      "s angle (W-axis along\n    % camera's point of view)  \n    pupil_CAMERA = [pupil_SENSOR * target_distance / foc"
      "al_length; target_distance];\n    pupil_distance = norm(pupil_CAMERA);\n\n    % Rotation matrix to convert from "
      "HREF coordinates to camera coordinates.\n    % HREF z-axis is defined as ray from camera to pupil.\n    R_HREF2C"
      "MRA = calc_R_from_vectors(pupil_CAMERA, [0; 0; 1]);\n\n    % Convert the HREF from HREF coordinates to canera co"
      "ordinates.  Scale,\n    % then rotate. \n    HREF_CAMERA = R_HREF2CMRA * (HREF_HREF * pupil_distance / 15000);\n"
      "\n    % Then convert pupil and HREF locations from camera frame to global frame\n    % by rotating and then shif"
      "ting origins. \n    pupil_GLOBAL = R_CMRA2GLBL * pupil_CAMERA + camera_GLOBAL';\n    HREF_GLOBAL = R_CMRA2GLBL *"
      " HREF_CAMERA + camera_GLOBAL';\n\n    % Find intersection of gaze_ray (from pupil to HREF) with the subject_disp"
      "lay plane\n    norm_vector = [0; 0; 1];		% In the KINARM VR setup, the Z-axis is defined as normal to the subjec"
      "t display\n    point_on_plane = [0; 0; 0];		% In the KINARM VR setup, the origin is defined as on the subject di"
      "splay plane\n\n    % display([pupil_GLOBAL HREF_GLOBAL])\n    gaze_est_GLOBAL = plane_line_intersect(norm_vector"
      ", point_on_plane, pupil_GLOBAL, HREF_GLOBAL);\n\nfunction pupil_XY_Sensor = convertPupilToSensor(pupilX, pupilY,"
      " pix_per_mm)\n%         Returns the projection of the pupil on the camera sensor in meters, based on inputs in s"
      "ome raw unit (not pixels)\n\n    % the following constants are from Jiye, email Nov 7, 2011\n    LEFTDROP = 32;	"
      "			%pixels dropped at left of sensor\n    TOPDROP = 48;				%lines dropped at top of sensor\n    const_x = 7*176;"
      "			%no idea what this is.  Maybe number of pixels???\n    const_y = 4*184 + 188;		%no idea what this is.  Maybe "
      "number of pixels???\n\n    % from Jiye. Not sure excatly what they are (probably camera center in pixels)\n    c"
      "am_rot_cx = const_x / 2 + LEFTDROP;			\n    cam_rot_cy = const_y / 2 +TOPDROP;\n\n    hor = 30000;\n    lor = -3"
      "0000;\n    hr = 0.9;\n    lr = 0.1;\n    ld = 50;\n    hdx = 1200;		%hmmm almost same as const_x, which is 1232\n"
      "    hdy = 920;		%hmmm almost same as const_y, which is 924\n\n    scx = (hor-lor) / (hdx - ld) / (hr-lr);\n    o"
      "fx = lor - (ld + (hdx - ld) * lr )* scx;\n\n    scy = (hor-lor) / (hdy - ld) / (hr-lr);\n    ofy = lor - (ld + ("
      "hdy - ld) * lr )* scy;\n\n    % calculate the pupil in camera sensor coordinates (pixels)\n    px = (pupilX - of"
      "x) / scx;\n    py = (pupilY - ofy) / scy;\n\n    ppl_mmX = - ( (cam_rot_cx - px) / pix_per_mm );\n    ppl_mmY = "
      "  ( (cam_rot_cy - py) / pix_per_mm );\n\n    pupil_XY_Sensor = [ppl_mmX / 1000; ppl_mmY / 1000];\n    \nfunction"
      " [Rx Ry Rz] = calc_R_from_angles(xrot, yrot, zrot)\n    % This function creates the three rotation matrices for "
      "rotations about the\n    % x, y and z axes.  Input rotations are in degrees.\n\n    xrot = xrot/180*pi;		%conver"
      "t to radians\n    yrot = yrot/180*pi;		%convert to radians\n    zrot = zrot/180*pi;		%convert to radians\n    Rx"
      " = [1 0 0; 0 cos(xrot) -sin(xrot); 0 sin(xrot) cos(xrot)]; \n    Ry = [cos(yrot) 0 sin(yrot); 0 1 0; -sin(yrot) "
      "0 cos(yrot)]; \n    Rz = [cos(zrot) -sin(zrot) 0; sin(zrot) cos(zrot) 0 ; 0 0 1]; \n\n    \nfunction R = calc_R_"
      "from_vectors(v1, v2)\n    % This function calculates a rotation matrix, given two vectors, such that\n    % the "
      "rotation matrix will rotate from v1 to v2.\n\n    rot_axis = cross(v2, v1);			%axis that is perpendicular to the"
      " two vectors\n\n    % If either of the vectors v1 or v2 is = [0 0 0], or if they are parallel\n    % (i.e. norm("
      "rot_axis) == 0), then there is no rotation.  But math errors\n    % will occur, so we need to check for these ca"
      "ses.   \n    if (norm(v1) == 0) || (norm(v2) == 0)	|| (norm(rot_axis) == 0)\n        R = eye(3);																"
      "%identity matrix results in no rotation\n    else\n        rot_angle = asin( norm(rot_axis) / norm(v1) / norm(v2"
      ") );				%angle of rotation about rot_axis\n        n = rot_axis / norm(rot_axis);											%normalize to get a "
      "unit vector for the rotation\n        n_cross_product_matrix = [ 0 -n(3) n(2); n(3) 0 -n(1); -n(2) n(1) 0];	%def"
      "'n of cross product matrix\n        cosA = cos(rot_angle);\n        sinA = sin(rot_angle);\n        R = eye(3) *"
      " cosA + sinA * n_cross_product_matrix + (1 - cosA) * (n * n');\n    % 	display(rot_angle);\n    end\n\n\nfunctio"
      "n I = plane_line_intersect(n,V0,P0,P1)\n    %plane_line_intersect computes the intersection of a plane and a seg"
      "ment(or\n    %a straight line)\n    % Inputs: \n    %       n: normal vector of the Plane \n    %       V0: any "
      "point that belongs to the Plane \n    %       P0: end point 1 of the segment P0P1\n    %       P1:  end point 2 "
      "of the segment P0P1\n    %\n    %Outputs:\n    %      I    is the point of interection \n    %     Check is (DEL"
      "ETED AND NOT USED HERE) an indicator:\n    %      0 => disjoint (no intersection)\n    %      1 => the plane int"
      "ersects P0P1 in the unique point I\n    %      2 => the segment lies in the plane\n    %      3=>the intersectio"
      "n lies outside the segment P0P1\n    %\n    % Example:\n    % Determine the intersection of following the plane "
      "x+y+z+3=0 with the segment P0P1:\n    % The plane is represented by the normal vector n=[1 1 1]\n    % and an ar"
      "bitrary point that lies on the plane, ex: V0=[1 1 -5]\n    % The segment is represented by the following two poi"
      "nts\n    % P0=[-5 1 -1]\n    %P1=[1 2 3]   \n    % [I,check]=plane_line_intersect([1 1 1],[1 1 -5],[-5 1 -1],[1 "
      "2 3]);\n\n    %This function is written by :\n    %                             Nassim Khaled\n    %            "
      "                 Wayne State University\n    %                             Research Assistant and Phd candidate\n"
      "    %If you have any comments or face any problems, please feel free to leave\n    %your comments and i will try"
      " to reply to you as fast as possible.\n\n    I=[0; 0; 0];\n    u = P1-P0;\n    w = P0 - V0;\n    D = dot(n,u);\n"
      "    N = -dot(n,w);\n    check=0;\n    if abs(D) < 10^-7        % The segment is parallel to plane\n            i"
      "f N == 0           % The segment lies in plane\n                check=2;\n                return\n            el"
      "se\n                check=0;       %no intersection\n                return\n            end\n    end\n\n    %co"
      "mpute the intersection parameter\n    sI = N / D;\n    I = P0+ sI.*u;\n	"
      editorLayout	      "100 M4x1[336 250 1508 927]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
