	  HorizontalAlignment	  "left"
	  ZOrder		  -6
	}
	Annotation {
	  SID			  "3:471"
	  Name			  "This block assembles individual data frames, which are collected into packets and sent out by the network"
	  " transfer subsystem.\n\nData frames may consist of up to 300 floating point values, that is, the network transfer s"
	  "ubsystem can accept an input of up \nto 300 values wide. However, the number of values available to the user of thi"
	  "s block is less than 300, as each data frame \nmust include information about task state common to all tasks. The f"
	  "rame can be considered as consisting of a number of \n\"sections\" of data shown below, with section one containing"
	  " the common state information."
	  Position		  [14, 55]
	  HorizontalAlignment	  "left"
	  ZOrder		  -7
	}
      }
    }
