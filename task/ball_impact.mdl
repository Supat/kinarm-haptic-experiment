  state {
    id			    150
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    149
    treeNode		    [149 0 0 0]
    superState		    SUBCHART
    subviewer		    149
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function y = fcn(u)\n\n% EML determines output class and size based on first usage\n% for some re"
      "ason the typecast is not setting it correctly, so we \n% explicitly define it first.\ny = single(0);\n\n% in ord"
      "er for the typecast to work, both temp and y must be 32 bit\ntemp = cast(u, 'uint32');\ny = typecast(temp, 'sing"
      "le');"
      editorLayout	      "100 M4x1[321 196 686 340]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
