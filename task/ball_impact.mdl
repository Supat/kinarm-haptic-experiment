  state {
    id			    69
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    68
    treeNode		    [68 0 0 0]
    superState		    SUBCHART
    subviewer		    68
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [target_vector, target_vector_length]= create_target_vector(target_table, target_type, x"
      "y_column_indices, attrib_column_indices)\n\n% Assemble the target vector for reading by the GUI. The vector cons"
      "ists of n entries back-to-back,\n% where n is the number of rows in the target table, and each entry consists of"
      "\n%\n%   target type, x position, y position, visual attribute values, logical attribute values\n%\n% for a targ"
      "et, where all values are taken out of the target table and processed so that they are ready\n% to be used by the"
      " GUI. This is kind of a compressed version of the process of creating a target using\n% Show_Target block -> VCO"
      "DE -> Process_Video_CMD block.\n%\n% The visual and logical attributes are the target type-specific information "
      "corresponding to the visual\n% and logical versions of that target. Distances and rotations are converted from c"
      "m and degrees, as they\n% are specified in the GUI, to um and and urads. For more information on how these are d"
      "efined for each \n% target type, refer to the mask help for this block or for the Show_Target block.\n\n% Note t"
      "he number of attribute columns based on the target type.\nnum_attributes = 1;\n\nif target_type == 1\n    num_at"
      "tributes = 1;\nelseif target_type == 2 || target_type == 3 || target_type == 4\n    num_attributes = 3;\nelseif "
      "target_type == 5\n    num_attributes = 4;\nend\n\ntarget_entry_size = num_attributes * 2 + 3;  % size of type, x"
      ",y position, and all attributes\ntable_size = size(target_table);\n\n% Set the vector length to the maximum that"
      " might be required, as it has to be constant at build time.\ntarget_vector_length = table_size(1) * 11;\ntarget_"
      "vector = zeros(1, target_vector_length);\n\nindices = attrib_column_indices;\n\n% For each target, set...\nfor i"
      " = 1:table_size(1)\n    start_index = (i-1) * target_entry_size + 1;\n    \n    target_vector(start_index) = tar"
      "get_type;  % target type\n    \n    target_vector(start_index+1) = target_table(i, xy_column_indices(1)) * 0.01;"
      "  % x position (m)\n    target_vector(start_index+2) = target_table(i, xy_column_indices(2)) * 0.01;  % y positi"
      "on (m)\n    \n    % For each vector of visual and logical column indices...\n    for j = 1:2\n        attrib_sta"
      "rt = start_index + 3 + (j-1) * num_attributes;\n        \n        % Copy circle attributes: radius (m).\n       "
      " if target_type == 1\n            target_vector(attrib_start) = target_table(i, indices(j, 1)) * 0.01;\n    \n  "
      "      % Copy ellipse attributes: major radius (m), minor radius (m), rotation (degrees).\n        elseif target_"
      "type == 2\n            if indices(j, 1) == 0 || indices(j, 2) == 0\n                target_vector(attrib_start) "
      "= 0.0;\n                target_vector(attrib_start+1) = 0.0;\n            else\n                target_vector(at"
      "trib_start) = target_table(i, indices(j, 1)) * 0.01;\n                target_vector(attrib_start+1) = target_tab"
      "le(i, indices(j, 2)) * 0.01;\n            end\n    \n            if indices(j, 3) == 0\n                target_v"
      "ector(attrib_start+2) = 0.0;\n            else\n                target_vector(attrib_start+2) = mod(target_table"
      "(i, indices(j, 3)), 360) * pi / 180.0;\n            end\n        \n        % Copy rectangle attributes: length ("
      "m), height (m), rotation (degrees).\n        % This amounts to the same procedure as for an ellipse.\n        el"
      "seif target_type == 3\n            if indices(j, 1) == 0 || indices(j, 2) == 0\n                target_vector(at"
      "trib_start) = 0.0;\n                target_vector(attrib_start+1) = 0.0;\n            else\n                targ"
      "et_vector(attrib_start) = target_table(i, indices(j, 1)) * 0.01;\n                target_vector(attrib_start+1) "
      "= target_table(i, indices(j, 2)) * 0.01;\n            end\n            \n            if indices(j, 3) == 0\n    "
      "            target_vector(attrib_start+2) = 0.0;\n            else\n                target_vector(attrib_start+2"
      ") = mod(target_table(i, indices(j, 3)), 360) * pi / 180.0;\n            end\n            \n    	% Copy line attr"
      "ibutes: relative endpoint x coordinate (m), relative endpoint y coordinate (m), width\n        elseif target_typ"
      "e == 4\n            if (indices(j, 1) == 0 && indices(j, 2) == 0) || indices(j, 3) == 0\n                target_"
      "vector(attrib_start) = 0.0;\n                target_vector(attrib_start+1) = 0.0;\n                target_vector"
      "(attrib_start+2) = 0.0;\n            else\n                target_vector(attrib_start) = target_table(i, indices"
      "(j, 1)) * 0.01;\n                target_vector(attrib_start+1) = target_table(i, indices(j, 2)) * 0.01;\n       "
      "         \n                if indices(j, 3) < 0\n                    target_vector(attrib_start+2) = 0.001;\n   "
      "             else\n                    target_vector(attrib_start+2) = target_table(i, indices(j, 3)) * 0.01;\n "
      "               end\n            end\n            \n        % Copy triangle attributes: length (m), height (m), p"
      "eak offset (m), rotation (degrees).\n        elseif target_type == 5\n            if indices(j, 1) == 0\n       "
      "         target_vector(attrib_start) = 0.0;\n            else\n                target_vector(attrib_start) = tar"
      "get_table(i, indices(j, 1)) * 0.01;\n            end\n    \n            if indices(j, 2) == 0  % create an equil"
      "ateral triangle if no height column is specified\n                target_vector(attrib_start+1) = target_table(i"
      ", indices(j, 1)) * sin(pi/3.0) * 0.01;\n                target_vector(attrib_start+2) = 0.0;\n            else\n"
      "                target_vector(attrib_start+1) = target_table(i, indices(j, 2)) * 0.01;\n                target_v"
      "ector(attrib_start+2) = target_table(i, indices(j, 3)) * 0.01;\n            end\n            \n            if in"
      "dices(j, 4) == 0\n                target_vector(attrib_start+3) = 0.0;\n            else\n                target"
      "_vector(attrib_start+3) = mod(target_table(i, indices(j, 4)), 360) * pi / 180.0;\n            end\n        end\n"
      "    end\nend\n\n"
      editorLayout	      "100 M4x1[638 205 1160 800]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
