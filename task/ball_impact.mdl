  chart {
    id			    346
    name		    "DataLogging/Poll KINARM/Monitor_status"
    windowPosition	    [1421.25 368.75 213 385]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1920 1080 1.333333333333333]
    treeNode		    [0 347 0 0]
    firstTransition	    354
    firstJunction	    353
    viewObj		    346
    machine		    1
    ssIdHighWaterMark	    8
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    firstData		    348
    chartFileNumber	    16
    disableImplicitCasting  1
    eml {
      name		      "monitor_system_status"
    }
    noDebugging		    1
    supportVariableSizing   0
  }
  state {
    id			    347
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    346
    treeNode		    [346 0 0 0]
    superState		    SUBCHART
    subviewer		    346
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function force_scale = monitor_system_status(status_data, servo_counter, robotCount, plcc_version"
      ")\n\n%This function must run at 1kHz so that the counter from the PMAC can be properly checked.\n% i.e. this mus"
      "t run slower than the PMAC\n\npersistent no_update_count;\npersistent last_servo_counter;\n\nif isempty(no_updat"
      "e_count)\n   no_update_count = 0;\nend\n\nif isempty(last_servo_counter)\n    last_servo_counter = uint32(0);\ne"
      "nd\n\npmac_fault_state = uint32(status_data(2));\nplcc_switch = status_data(3);\nforce_scale = 1;\n\n%plcc versi"
      "ons >1000 are custom\nif plcc_version >= 6.0 && plcc_version < 1000\n    %if the task is running and the servo a"
      "mp counter is not\n    if plcc_switch == 4.0 && last_servo_counter == servo_counter\n        no_update_count = n"
      "o_update_count + 1;    \n        %after 5 cycles with the counter not running we should kill forces.\n        if"
      " no_update_count >= 5\n            force_scale = 0;\n        end\n    else\n        no_update_count = 0;\n    en"
      "d\n    last_servo_counter = servo_counter; \nend\n\n%plcc versions >1000 are custom\nif plcc_version >= 7.0 && p"
      "lcc_version < 1000\n    %if it is unilateral and the robot state is faulted then kill the forces\n    if robotCo"
      "unt == 1 && bitand(pmac_fault_state, 1) == 1\n        force_scale = 0;\n    %if the system is bilateral and eith"
      "er robot is faulted, kill forces.\n    elseif robotCount == 2 && bitand(pmac_fault_state, 3) ~= 0\n        force"
      "_scale = 0;\n    end\nend\n\nif plcc_version == 0\n    force_scale = 0;\nend    \n    \n"
      editorLayout	      "100 M4x1[581 95 1339 1071]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', false)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
