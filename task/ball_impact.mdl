	Block {
	  BlockType		  SubSystem
	  Name			  "Poll KINARM"
	  SID			  "3:196"
	  Ports			  []
	  Position		  [675, 26, 750, 95]
	  ZOrder		  -15
	  MinAlgLoopOccurrences	  off
	  PropExecContextOutsideSubsystem off
	  RTWSystemCode		  "Auto"
	  FunctionWithSeparateData off
	  Opaque		  off
	  RequestExecContextInheritance	off
	  MaskHideContents	  off
	  Object {
	    $PropName		    "MaskObject"
	    $ObjectID		    23
	    $ClassName		    "Simulink.Mask"
	    Initialization	    "block_path = gcb;  % store block path, as gcb may change with block operations\n\n% Handle ba"
	    "ckground colours if link status changes.  If the link is resolved, \n% make the block back to the library colour."
	    "  If the link is not resolved, \n% change the colour to something other than the library block colour (but \n% on"
	    "ly change it if it is the library colour, that way end-users can choose\n% their own colour.\nlink_status = get_p"
	    "aram(block_path, 'LinkStatus');\nblock_parent = get_param(block_path, 'Parent');\nset_param(block_path, 'Backgrou"
	    "ndColor', '[1, 1, 1]');\n\n% Handle KINARM Exo Torques\n\n% Find out if the KINARMTorqueCMD Goto block exists els"
	    "ewhere in the Simulink model.\ngotoblock = find_system(bdroot, 'LookUnderMasks', 'all', 'FollowLinks', 'on', 'Blo"
	    "ckType', 'Goto');\ngoto_exists = 0;\n\nfor i = 1:length(gotoblock)\n    if strcmp(get_param(char(gotoblock(i)), '"
	    "GotoTag'), 'KINARMTorqueCMD')\n        goto_exists = 1;\n    end\nend\n\n% Check whether a From block with the na"
	    "me KINARMTorqueCMD exists in the current block.\nfromblock = find_system(gcb, 'LookUnderMasks', 'all', 'FollowLin"
	    "ks', 'on', 'SearchDepth', 1, 'BlockType', 'From');\nfrom_exists = 0;\n\nfor i = 1:length(fromblock)\n    if strcm"
	    "p(get_param(char(fromblock(i)), 'GotoTag'), 'KINARMTorqueCMD')\n        from_exists = 1;\n    end\nend\n\nif from"
	    "_exists == goto_exists\n    % Do nothing if either both the From and Goto exist or if neither exists.\n\nelseif g"
	    "oto_exists == 1 && from_exists == 0\n    % If a >From is not paired with an existing Goto, delete the Constant bl"
	    "ock and make the From block.\n    pos = get_param([gcb '/ZeroTorque'], 'position');\n\n    delete_line(gcb, 'Zero"
	    "Torque/1', 'AddTorques/1');\n    delete_block([gcb '/ZeroTorque']);\n\n    add_block('built-in/From', [gcb '/Torq"
	    "ueCMD']);\n    set_param([gcb '/TorqueCMD'], 'position', pos);\n    add_line(gcb, 'TorqueCMD/1', 'AddTorques/1');"
	    "\n    set_param([gcb '/TorqueCMD'], 'GotoTag', 'KINARMTorqueCMD');\n\nelse\n    % If a From block exists but the "
	    "Goto is missing, delete the From block and replace it with a Constant.\n    pos = get_param([gcb '/TorqueCMD'], '"
	    "position');\n\n    delete_line(gcb, 'TorqueCMD/1', 'AddTorques/1');\n    delete_block([gcb '/TorqueCMD']);\n\n   "
	    " add_block('built-in/Constant', [gcb '/ZeroTorque']);\n    set_param([gcb '/ZeroTorque'], 'position', pos);\n    "
	    "add_line(gcb, 'ZeroTorque/1', 'AddTorques/1');\n    set_param([gcb '/ZeroTorque'], 'Value', '[0 0 0 0]');\nend\n\n"
	    "\n% Handle KINARM EP Torques\n\n% Find out if the KINARMEPTorqueCMD Goto block exists elsewhere in the Simulink m"
	    "odel.\ngotoblock = find_system(bdroot, 'LookUnderMasks', 'all', 'FollowLinks', 'on', 'BlockType', 'Goto');\ngoto_"
	    "exists = 0;\n\nfor i = 1:length(gotoblock)\n    if strcmp(get_param(char(gotoblock(i)), 'GotoTag'), 'KINARMEPTorq"
	    "ueCMD')\n        goto_exists = 1;\n    end\nend\n\n% Check whether a From block with the name KINARMTorqueCMD exi"
	    "sts in the current block.\nfromblock = find_system(gcb, 'LookUnderMasks', 'all', 'FollowLinks', 'on', 'SearchDept"
	    "h', 1, 'BlockType', 'From');\nfrom_exists = 0;\n\nfor i = 1:length(fromblock)\n    if strcmp(get_param(char(fromb"
	    "lock(i)), 'GotoTag'), 'KINARMEPTorqueCMD')\n        from_exists = 1;\n    end\nend\n\nif from_exists == goto_exis"
	    "ts\n    % Do nothing if either both the >From and Goto exist or if neither exists.\n\nelseif goto_exists == 1 && "
	    "from_exists == 0\n    % If a From is not paired with an existing Goto, delete the Constant block and make the Fro"
	    "m block.\n    pos = get_param([gcb '/ZeroEPTorque'], 'position');\n\n    delete_line(gcb, 'ZeroEPTorque/1', 'AddT"
	    "orques/2');\n    delete_block([gcb '/ZeroEPTorque']);\n\n    add_block('built-in/From', [gcb '/EPTorqueCMD']);\n "
	    "   set_param([gcb '/EPTorqueCMD'], 'position', pos);\n    add_line(gcb, 'EPTorqueCMD/1', 'AddTorques/2');\n    se"
	    "t_param([gcb '/EPTorqueCMD'], 'GotoTag', 'KINARMEPTorqueCMD');\n\nelse\n    % If a From block exists but the Goto"
	    " is missing, delete the From block and replace it with a Constant.\n    pos = get_param([gcb '/EPTorqueCMD'], 'po"
	    "sition');\n\n    delete_line(gcb, 'EPTorqueCMD/1', 'AddTorques/2');\n    delete_block([gcb '/EPTorqueCMD']);\n\n "
	    "   add_block('built-in/Constant', [gcb '/ZeroEPTorque']);\n    set_param([gcb '/ZeroEPTorque'], 'position', pos);"
	    "\n    add_line(gcb, 'ZeroEPTorque/1', 'AddTorques/2');\n    set_param([gcb '/ZeroEPTorque'], 'Value', '[0 0 0 0]'"
	    ");\nend\n"
	  }
	  System {
	    Name		    "Poll KINARM"
	    Location		    [16, 52, 2304, 1268]
	    Open		    off
