    "ify the packet version\npacket_queue[queue_head][1] = -10;\n\n// Copy the new packet into the packet_queue.\nCopyI"
    "nput();\n\n// Increment the head pointer of the packet_queue for the next packet.\nqueue_head = fmod(queue_head + "
    "1, packet_queue_sz);\n}"
