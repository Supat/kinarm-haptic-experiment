    Block {
      BlockType		      SubSystem
      Name		      "DataLogging"
      SID		      "3"
      Ports		      [3]
      Position		      [620, 60, 790, 120]
      ZOrder		      3
      BackgroundColor	      "green"
      MinAlgLoopOccurrences   off
      PropExecContextOutsideSubsystem off
      RTWSystemCode	      "Auto"
      FunctionWithSeparateData off
      Opaque		      off
      RequestExecContextInheritance off
      MaskHideContents	      off
      Object {
	$PropName		"MaskObject"
	$ObjectID		20
	$ClassName		"Simulink.Mask"
	Type			"DataLogging"
	Description		"<b>Do not rename this block, it must be called 'DataLogging'.</b>\n<p>\nThis block collects data and ev"
	"ent codes and transfers them to the GUI.\n<p>\nThis block must be present in all task programs."
	Help			"Sends data and event codes to the GUI.\n\n<H2>Library </H2>\nGeneral\n\n<H2>Description </H2>\n<b>Do not rena"
	"me this block, it must be called 'DataLogging'.</b>\n<p>\nThe DataLogging block collects data and event codes and sen"
	"ds it to the GUI for saving.  It also passes on Task Program information that is invisible to the user, and so must b"
	"e present even if no data is going to be saved.\n<P>\n<B><I>This block must be present in all Task Programs, even if "
	"no data is going to be saved.</I></B>\n\n\n<H2>Parameters and Dialog Box</H2>\n<B>Log event codes: </B> checking this"
	" parameter causes the GUI to log event codes specified by the event_codes input.\n<P>\n<B>Log analog inputs: </B> che"
	"cking this parameter causes the GUI to log analog data specified by the analog_inputs input.\n<P>\n<B>analog_inputs: "
	"</B> this vector input specifies the data from analog inputs and other arbitrary data to be logged by the GUI.\n<P>\n"
	"<B>event_codes: </B> this input should be a vector of 16 bit integers.  It is passed on to the GUI, which saves the i"
	"ntegers as event codes (i.e. they are timestamped so that events that occurred duing a task can be related to the oth"
	"er saved data).\n<P>\n<B>logging_enable: </B> this input is used by the GUI to indicate when to save data.  When logg"
	"ing_enable is 1, data is saved.  When logging_enable is 0, data is not saved.  (Note: data saving is also affected by"
	" the Run/Pause button in the GUI.  When the task is paused, data is no longer saved regardless of the value of this i"
	"nput)."
	Initialization		"%this stops us from running a simulation\nset_param(bdroot,'StartFcn',' warndlg(''Dexterit-E models "
	"cannot run under simulation. Please compile your model and run it from within Dexterit-E.'');set_param(bdroot,''Simul"
	"ationCommand'',''stop'')')\n\nblock_path = gcb;  % store block path, as gcb may change with block operations\n \nidxs"
	" = findstr(block_path, '/DataLogging');\n[idxCount, n] = size(idxs);\n[m, strlen] = size(block_path);\nbColorSet = 0;"
	"\n\ndexcheck();\nif idxCount == 0 || idxs(1) ~= strlen - 11\n    fprintf('=========ERROR====================\\n');\n "
	"   fprintf('%s should be called DataLogging, attempting to rename.\\n', block_path);\n    try\n        set_param(bloc"
	"k_path, 'Name', 'DataLogging');\n        block_path = gcb;  % store block path, as gcb may change with block operatio"
	"ns\n        fprintf('Rename successful\\n');\n    catch err\n        fprintf('Rename failed. You may have 2 DataLoggi"
	"ng blocks or another improperly named block.\\n');\n       	set_param(block_path, 'BackgroundColor', '[0.9, 0, 0]');\n"
	"        bColorSet = 1;\n    end\n    fprintf('=============================\\n');\nend\n\nlog_event_codes = strcmp(ge"
	"t_param(block_path, 'log_event_codes'), 'on');\nlog_analog_inputs = strcmp(get_param(block_path, 'log_analog_inputs')"
	", 'on');\n\n% Handle the event codes setting: swap the 'Event Codes' inport with a constant block or \n% vice versa, "
	"if necessary, so that it matches the setting.\nblock_type = get_param([block_path '/event_codes'], 'BlockType');\n \n"
	"if log_event_codes && ~strcmp(block_type, 'Inport') || ...  % if a change is required...\n   ~log_event_codes && strc"
	"mp(block_type, 'Inport')\n    \n    % ...delete the existing block, ...\n    pos = get_param([block_path '/event_code"
	"s'], 'Position');\n    delete_line(block_path, 'event_codes/1', 'Create Event Codes Subsystem/1');\n    delete_block("
	"[block_path '/event_codes']);\n    \n    % ...add an Inport or a 0-value Constant in place of the previous block (acc"
	"ording to\n    % the new setting), update the signal width flag, and then...\n    if log_event_codes && ~strcmp(block"
	"_type, 'Inport')\n        add_block('built-in/Inport', [block_path '/event_codes'], 'Name', 'event_codes');\n        "
	"set_param([block_path '/Create Event Codes Subsystem/Not Logging Event Codes'], 'Value', '0');\n    else\n        add"
	"_block('built-in/Constant', [block_path '/event_codes'], 'Name', 'event_codes');\n        set_param([block_path '/eve"
	"nt_codes'], 'Value', '0');\n        set_param([block_path '/Create Event Codes Subsystem/Not Logging Event Codes'], '"
	"Value', '1');\n    end\n    \n    % ...connect the new block.\n    set_param([block_path '/event_codes'], 'Position',"
	" pos);\n    add_line(block_path, 'event_codes/1', 'Create Event Codes Subsystem/1');\nend\n\n% Swap the 'analog_data'"
	" inport with a constant block or vice versa according to the corresponding setting.\nblock_type = get_param([block_pa"
	"th '/analog_inputs'], 'BlockType');\n\nif log_analog_inputs && ~strcmp(block_type, 'Inport') || ...  % if a change is"
	" required...\n   ~log_analog_inputs && strcmp(block_type, 'Inport')\n    \n    % ...delete the existing block, ...\n "
	"   pos = get_param([block_path '/analog_inputs'], 'Position');\n    delete_line(block_path, 'analog_inputs/1', 'Creat"
	"e Analog Inputs Subsystem/1');\n    delete_block([block_path '/analog_inputs']);\n    \n    % ...add an Inport or a 0"
	"-value Constant in place of the previous block (according to\n    % the new setting), update the signal width flag, a"
	"nd then...\n    if log_analog_inputs && ~strcmp(block_type, 'Inport')\n        add_block('built-in/Inport', [block_pa"
	"th '/analog_inputs'], 'Name', 'analog_inputs');\n        set_param([block_path '/Create Analog Inputs Subsystem/Not L"
	"ogging Analog Inputs'], 'Value', '0');\n    else\n        add_block('built-in/Constant', [block_path '/analog_inputs'"
	"], 'Name', 'analog_inputs');\n        set_param([block_path '/analog_inputs'], 'Value', '0');\n        set_param([blo"
	"ck_path '/Create Analog Inputs Subsystem/Not Logging Analog Inputs'], 'Value', '1');\n    end\n    \n    % ...connect"
	" the new block.\n    set_param([block_path '/analog_inputs'], 'Position', pos);\n    add_line(block_path, 'analog_inp"
	"uts/1', 'Create Analog Inputs Subsystem/1');\nend\n\n% Create the text label for the block, and use it to create the "
	"first in a \n% list of drawing commands that will be used to draw the mask icon.\nlabel = 'Logging:\\n ';\n \nif log_"
	"event_codes\n   label = [label 'Event codes\\n'];\nend\n \nlabel = [label 'KINARM data\\n'];\n    \nif log_analog_inp"
	"uts\n    label = [label 'Analog inputs\\n'];\nend\n\ndraw_commands = 'disp(label); ';\n\n% Ensure the inports appear "
	"in a fixed order, and for each inport found add\n% to the list of drawing commands a command to label it.\ninports = "
	"find_system(block_path, 'LookUnderMasks', 'all', 'FollowLinks', 'on', 'SearchDepth', 1, 'BlockType', 'Inport');\n\nfo"
	"r i = 1:length(inports)\n    inport_name = char(get_param(inports(i), 'Name'));\n    \n    if strcmp(inport_name, 'lo"
	"gging_enable')\n        port = '1';\n    elseif strcmp(inport_name, 'event_codes')\n        port = '2';\n    elseif s"
	"trcmp(inport_name, 'analog_inputs') && log_event_codes\n        port = '3';\n    elseif strcmp(inport_name, 'analog_i"
	"nputs')\n        port = '2';\n    end\n    \n    set_param([block_path '/' inport_name], 'Port', port);\n    draw_com"
	"mands = [draw_commands 'port_label(''input'', ' port ', ''' inport_name '''); '];\nend\n\n% Apply the drawing command"
	"s.\nset_param(block_path, 'MaskDisplay', draw_commands);\n\n%%% Handle background colours if link status changes.  \n"
	"checkBackgroundColour(block_path, 'General');\n\n% For gaze tracking, the packet length is variable, so we need to ch"
	"eck off that option the Receive UDP block.\n% But that option is only availabe starting in R2010a. The TDK is present"
	"ly created/maintained using R2007b so\n% if the MATLAB version is >= R2010a, then we need to check this option\ncurre"
	"nt_ver = ver('MATLAB');\ncurrent_ver_parts = sscanf(current_ver.Version, '%d.%d.%d')';\nif length(current_ver_parts) "
	"< 3\n    current_ver_parts(3) = 0;\nend\n\ndesired_ver = '7.10.0';\ndesired_ver_parts = sscanf(desired_ver, '%d.%d.%d"
	"')';\nif length(desired_ver_parts) < 3\n    desired_ver_parts(3) = 0;\nend\n\nif (sign(current_ver_parts - desired_ve"
	"r_parts) * [1; 0.1; 0.01]) >= 0\n	set_param([block_path '/Receive_Gaze/Receive'], 'vblLen', 'on')\nend\n\n"
	SelfModifiable		"on"
	Display			"disp(label); port_label('input', 1, 'logging_enable'); port_label('input', 2, 'event_codes'); port_label('"
	"input', 3, 'analog_inputs'); "
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  2
	  Object {
	    $ObjectID		    21
	    Type		    "checkbox"
	    Name		    "log_event_codes"
	    Prompt		    "Log event codes"
	    Value		    "on"
	  }
	  Object {
	    $ObjectID		    22
	    Type		    "checkbox"
	    Name		    "log_analog_inputs"
	    Prompt		    "Log analog inputs"
	    Value		    "on"
	  }
	  PropName		  "Parameters"
	}
      }
