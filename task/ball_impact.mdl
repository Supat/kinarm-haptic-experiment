  state {
    id			    191
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    190
    treeNode		    [190 0 0 0]
    superState		    SUBCHART
    subviewer		    190
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [y,z]= fcn(x)\n% This block determines the run_command input of the task execution contr"
      "ol\n% subsystem (y), as well as the value of the task control button Goto (z).\n\npersistent u\npersistent v\n\n"
      "if isempty(u)\n    u = 0;\nend\n\nif isempty(v)\n    v = 0;\nend\n\n% To the run_command input, only output a 1 "
      "or a 0 ('run' or 'pause')\n% according to the last received status for the Go/Pause button.\nif x < 2 && u ~= x\n"
      "    u = x;\nend\n\ny = u;\n\n% To the Goto block, only output a non-zero value on the first receipt of \n% a blo"
      "ck index > 1 (i.e. not the Go/Pause button).\nif x > 1 && x ~= v\n    v = x;\n    if v == 255\n        z = 0;\n "
      "   else     \n        z = v;\n    end\nelse\n    z = 0;\nend"
      editorLayout	      "100 M4x1[684 29 1213 1079]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
