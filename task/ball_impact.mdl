	    Annotation {
	      SID		      "3:428"
	      Name		      "This block provides access to KINARM data for both BKIN client software and task program authors. "
	      "Client software must provide \ncorrect hardware information and calibration parameters for each KINARM, and thi"
	      "s information is subsequently used to read\nand scale data from the motion control card. The KINARM data and ot"
	      "her attributes of the KINARM setup controlled by client\nsoftware, such as which arm is \"dominant\" for the KI"
	      "NARM EXO or EP, are combined into the KINdata structure. Arm kinematics \nare output for inclusion in the curre"
	      "nt data frame.\n\nThis block also offers client software access to the motion control card DPRAM via the DPRAM "
	      "access subsystem.\n\nNote: The mask replaces the ZeroTorque constant with a From block that includes the comman"
	      "ded torques providing the model\nincludes an instance of the load-applying block.\n\nNote: For each Goto block "
	      "created here, a corresponding From block is included in the Terminators for Gotos subsystem. This is\nsolely to"
	      " prevent unnecessary warnings at the Matlab prompt if such From blocks are not present."
	      Position		      [12, 94]
	      HorizontalAlignment     "left"
	      ZOrder		      -1
	    }
	    Annotation {
	      SID		      "3:427"
	      Name		      "The mcc_pollall s-function polls the motion control \ncard for the latest data from any and all KI"
	      "NARMs."
	      Position		      [1547, 324]
	      HorizontalAlignment     "left"
	      ZOrder		      -2
	    }
	    Annotation {
	      SID		      "3:426"
	      Name		      "The section below contains the parameters that define the calibrations for the robots."
