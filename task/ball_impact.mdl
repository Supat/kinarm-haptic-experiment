  chart {
    id			    156
    name		    "DataLogging/Poll Force Plates/plate1/parse packet 1"
    windowPosition	    [1421.25 368.75 213 385]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1920 1080 1.333333333333333]
    treeNode		    [0 157 0 0]
    firstTransition	    169
    firstJunction	    168
    viewObj		    156
    machine		    1
    ssIdHighWaterMark	    13
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    firstData		    158
    chartFileNumber	    10
    disableImplicitCasting  1
    eml {
      name		      "fcn"
    }
    supportVariableSizing   0
  }
  state {
    id			    157
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    156
    treeNode		    [156 0 0 0]
    superState		    SUBCHART
    subviewer		    156
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [forces, moments, timer] = fcn(packet, calibration, gain, ain_slope, ain_offset, orienta"
      "tion, zero_voltage)\n    %This pulls voltages and timer infomation from the packet we got back from\n    %the la"
      "b jack.\n    \n    voltages = zeros(1, 8);\n    timers = zeros(1, 3);\n    \n    for n = 1:8\n        bits = rea"
      "dUShort(packet, 13 + ((n - 1)*2));\n        voltages(n) = binaryToCalibratedAnalogVoltage(bits, ain_slope, ain_o"
      "ffset);\n    end\n    \n    for n = 1:3\n        timers(n) = readUInt(packet, 53 + ((n - 1)*4));\n    end\n    \n"
      "    %convert the time stamp to a time in seconds.\n    timer = timers(1) / 750000.0; \n    \n    %all voltages a"
      "re between -2.5 to 2.5, here we are normalizeing what we read to zero.\n    voltages = voltages - zero_voltage;\n"
      "    voltages = voltages(1:8); % only the first 8 channels matter.\n    \n    %using the calibration matrix we co"
      "nvert the to the forces and moments\n    values = calibration * (voltages / gain)';\n    forces = values(1:3);\n"
      "    moments = values(4:6);\n    \n	%reverse the Z force to get it into global coordinates.\n	forces(3) = -forces"
      "(3);\n	\n	%considering the positions of the cables push all measures into global coordinates\n    if orientation"
      " == 0\n        forces(2) = -forces(2);\n        moments(2) = -moments(2);\n    elseif orientation == 90\n       "
      " y = forces(2);\n        forces(2) = -forces(1);\n        forces(1) = -y;\n\n        y = moments(2);\n        mo"
      "ments(2) = -moments(1);\n        moments(1) = -y;\n	elseif orientation == 180\n        forces(1) = -forces(1);  "
      "      \n        moments(1) = -moments(1);        \n    elseif orientation == 270\n        y = forces(2);\n      "
      "  forces(2) = forces(1);\n        forces(1) = y;\n\n		y = moments(2);\n        moments(2) = moments(1);\n       "
      " moments(1) = y;\n    end\nend\n\nfunction val = readUShort(data, offset)\n    p1 = uint32(data(offset));\n    p"
      "2 = uint32(data(offset + 1));\n    val = double(p1 + (p2 * 256));\nend\n\nfunction val = readUInt(data, offset)\n"
      "    p1 = uint32(data(offset));\n    p2 = uint32(data(offset + 1));\n    p3 = uint32(data(offset + 2));\n    p4 ="
      " uint32(data(offset + 3));\n    val = double(p1 + (p2 * 256) + (p3 * 2^16) + (p4 * 2^24));\nend\n\nfunction volt"
      "age = binaryToCalibratedAnalogVoltage(bits, ain_slope, ain_offset)\n    voltage = (bits * ain_slope) + ain_offse"
      "t;\nend\n\n"
      editorLayout	      "100 M4x1[598 17 842 866]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
