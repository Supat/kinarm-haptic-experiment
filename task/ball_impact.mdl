  state {
    id			    380
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    379
    treeNode		    [379 0 0 0]
    superState		    SUBCHART
    subviewer		    379
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [pack_out, len_out] = clean_packet(pack_in, len_in)\n\n%for some reason, during calibrat"
      "ion we can get very large packets that \n%blow up the c code for parsing the packets. If we get a large packet\n"
      "%we can ignore it.\n\nif len_in < 512\n    pack_out = pack_in;\n    len_out = len_in;\nelse\n    pack_out = zero"
      "s(512, 1, 'uint8');\n    len_out = int32(0);\nend"
      editorLayout	      "100 M4x1[226 370 865 662]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
