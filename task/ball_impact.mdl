    eml {
      isEML		      1
      script		      "function [timestamp_out, start_time_out] = fcn(time_in)\n\npersistent start_time\npersistent last"
      "_time\n\nif isempty(start_time)\n   start_time = -1;\nend\n\nif isempty(last_time)\n    last_time = -1;\nend\n\n"
      "if start_time == -1 && time_in ~= 0\n    start_time = time_in;\nend\n\n%if the clock has flipped over then in or"
      "der to get the time\n%right this will add the time before the flip to the current time.\nif time_in < start_time"
      "\n    start_time = -(last_time - start_time);\nend\n\ntimestamp_out = (time_in - start_time) / 1000.0;\nlast_tim"
      "e = time_in;\nstart_time_out = start_time;"
      editorLayout	      "100 M4x1[226 370 865 662]"
      fimathString	      "fimath(...\n'RoundMode', 'floor',...\n'OverflowMode', 'wrap',...\n'ProductMode', 'KeepLSB', "
      "'ProductWordLength', 32,...\n'SumMode', 'KeepLSB', 'SumWordLength', 32,...\n'CastBeforeSum', true)"
      fimathForFiConstructors FimathMatlabFactoryDefault
      emlDefaultFimath	      FimathUserSpecified
    }
  }
