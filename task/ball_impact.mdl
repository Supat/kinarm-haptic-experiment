  chart {
    id			    44
    name		    "Ball_Engine"
    windowPosition	    [357.331 483.407 167 391]
    viewLimits		    [0 156.75 0 153.75]
    screen		    [1 1 1280 1024 1.041050272174191]
    treeNode		    [0 45 0 0]
    firstTransition	    66
    firstJunction	    65
    viewObj		    44
    machine		    1
    toolbarMode		    LIBRARY_TOOLBAR
    subviewS {
    }
    ssIdHighWaterMark	    22
    decomposition	    CLUSTER_CHART
    type		    EML_CHART
    firstData		    46
    chartFileNumber	    2
    disableImplicitCasting  1
    eml {
      name		      "ball_engine"
    }
  }
  state {
    id			    45
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    44
    treeNode		    [44 0 0 0]
    superState		    SUBCHART
    subviewer		    44
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [vcodes, hand_forces, ball_log, pen_out, speed_out, delay_ms, timeout_ms] = ball_engine("
      "phase, home_row, ball_row, load_row, KINdata, Load_Table, Target_Table, Task_Wide, TP_Table, tp_row, seed, hand_"
      "in) %#codegen\n%BALL_ENGINE Ball physics, penalty contact force, and ball/slope VCODEs.\n%\n% Runs every 1 ms. T"
      "he Trial_Control chart sequences the trial and sets:\n%   phase 0 = no ball (reset), 1 = ball parked at slope to"
      "p, 2 = physics live.\n% The ball is constrained to the line from the slope top (Target Table row\n% ball_row) to"
      "ward the home target (row home_row): gravity component\n% (5/7)*g*sin(theta) acts along it while the path distan"
      "ce s < SlopeLength,\n% rolling resistance -RollRes*g*sign(v) always. Contact with the hand disk is\n% penalty-ba"
      "sed: pen = BallRadius + HandRadius - |p_hand - p_ball|, force\n% clamp(Kc*pen + Bc*dpen/dt, 0, Fmax) along the b"
      "all-to-hand normal, plus a\n% decaying TransientFreq sinusoid for the first 30 ms of each new contact.\n% The re"
      "action decelerates the ball (bounce); HapticsOn=0 zeroes the commanded\n% force but keeps the visual bounce. Fma"
      "x is hard-clamped at 45 N.\n%\n% Units: Target Table and lengths in the Load Table are cm (converted to m\n% her"
      "e); KINdata hand position/velocity are m, m/s, global frame; forces N.\n\npersistent s v prev_pen t_contact have"
      "_contact initd rngstate\nif isempty(initd)\n    s = 0; v = 0; initd = 1;\n    prev_pen = [0 0]; t_contact = [1e9"
      " 1e9]; have_contact = [0 0];\n    rngstate = mod(abs(seed), 4294967296);\n    if rngstate <= 0; rngstate = 12345"
      "; end\nend\n\ndt = 0.001;\ng  = 9.81;\n\n% ---- per-trial timing for the chart (sampled by Stateflow at state en"
      "try).\n% R2013a chart codegen cannot lower rand()/boolean arithmetic, so the random\n% release delay and the zer"
      "o-timeout guard are computed here instead. LCG\n% seeded from Dexterit-E's 'seed' tag, so the protocol seed opti"
      "on holds.\nrngstate = mod(1664525 * rngstate + 1013904223, 4294967296);\nu = rngstate / 4294967296;\ntr = max(1,"
      " min(100, round(tp_row)));\ndmin = TP_Table(tr, 5);\ndmax = TP_Table(tr, 6);\nif dmax > dmin\n    delay_ms = dmi"
      "n + (dmax - dmin) * u;\nelse\n    delay_ms = dmin;\nend\nif delay_ms < 0; delay_ms = 0; end\ntimeout_ms = TP_Tab"
      "le(tr, 7);\nif timeout_ms <= 0; timeout_ms = 10000; end\n\nvcodes      = zeros(9, 70);\nhand_forces = zeros(4, 1"
      ");\n\n% ---- parameters ------------------------------------------------------------\nhr = max(1, min(32, round("
      "home_row)));\nbr = max(1, min(32, round(ball_row)));\nlr = max(1, min(20, round(load_row)));\n\nm_b    = Load_Ta"
      "ble(lr, 1);\nr_b    = Load_Table(lr, 2) * 0.01;\ntheta  = Load_Table(lr, 3) * pi / 180;\nLslope = Load_Table(lr,"
      " 4) * 0.01;\ncrr    = Load_Table(lr, 6);\nkc     = Load_Table(lr, 7);\nbc     = Load_Table(lr, 8);\nFmax   = Loa"
      "d_Table(lr, 9);\nhapt   = Load_Table(lr, 10);\ntamp   = Load_Table(lr, 11);\ntfreq  = Load_Table(lr, 12);\n\n% D"
      "efaults so an all-zero Load row stays safe and visible\nif m_b <= 0;    m_b = 0.2;     end\nif r_b <= 0;    r_b "
      "= 0.03;    end\nif Lslope <= 0; Lslope = 0.20; end\nif kc <= 0;     kc = 2000;     end\nif Fmax <= 0;   Fmax = 2"
      "0;     end\nif Fmax > 45;   Fmax = 45;     end   % hardware envelope hard clamp\nif tfreq < 50;  tfreq = 150;   "
      "end\n\nr_h = Task_Wide(1) * 0.01;\nif r_h <= 0; r_h = 0.02; end\n\n% ---- geometry (global metres; Target_Table "
      "is global cm on the target) -----\ntx  = Target_Table(br, 1) * 0.01;\nty  = Target_Table(br, 2) * 0.01;\nhx0 = T"
      "arget_Table(hr, 1) * 0.01;\nhy0 = Target_Table(hr, 2) * 0.01;\ndx = hx0 - tx; dy = hy0 - ty;\ndd = sqrt(dx*dx + "
      "dy*dy);\nif dd < 1e-6; dd = 1; end\nux = dx / dd; uy = dy / dd;\n\n% ---- hand state: BOTH hands can strike the "
      "ball (row 1 = robot 1, row 2 =\n% robot 2; an absent robot reads position (0,0), far from the track, so its\n% p"
      "enetration never goes positive) ---------------------------------------\nhpx = [KINdata(1, 23) KINdata(2, 23)];\n"
      "hpy = [KINdata(1, 24) KINdata(2, 24)];\n\n% ---- physics -------------------------------------------------------"
      "---------\nFxh = [0 0]; Fyh = [0 0]; pen = 0;\nif phase < 1.5\n    % phase 0: hidden/reset. phase 1: parked at s"
      "lope top.\n    s = 0; v = 0;\n    prev_pen = [0 0]; have_contact = [0 0]; t_contact = [1e9 1e9];\nelse\n    a = "
      "0;\n    if s < Lslope\n        a = a + (5/7) * g * sin(theta);   % downhill along +u while on the slope\n    end"
      "\n    if v > 1e-4\n        a = a - crr * g;\n    elseif v < -1e-4\n        a = a + crr * g;\n    end\n\n    bxp "
      "= tx + ux * s; byp = ty + uy * s;\n    for h = 1:2\n        rx = hpx(h) - bxp; ry = hpy(h) - byp;\n        dist "
      "= sqrt(rx*rx + ry*ry);\n        if dist < 1e-6; dist = 1e-6; end\n        penh = (r_b + r_h) - dist;\n\n        "
      "if penh > 0\n            dpen = (penh - prev_pen(h)) / dt;\n            fmag = kc * penh + bc * dpen;\n         "
      "   if fmag < 0; fmag = 0; end\n            if have_contact(h) == 0\n                have_contact(h) = 1;\n      "
      "          t_contact(h) = 0;    % new contact: restart transient\n            end\n            if t_contact(h) < "
      "0.03 && tamp > 0\n                fmag = fmag + tamp * exp(-t_contact(h) / 0.01) * sin(2 * pi * tfreq * t_contac"
      "t(h));\n                if fmag < 0; fmag = 0; end\n            end\n            if fmag > Fmax; fmag = Fmax; en"
      "d\n            nx = rx / dist; ny = ry / dist;\n            Fxh(h) = fmag * nx; Fyh(h) = fmag * ny;\n           "
      " % equal and opposite on the ball, projected on the rail\n            a = a - (Fxh(h) * ux + Fyh(h) * uy) / m_b;"
      "\n        else\n            have_contact(h) = 0;\n        end\n        t_contact(h) = t_contact(h) + dt;\n      "
      "  prev_pen(h) = penh;\n        if penh > pen; pen = penh; end\n    end\n\n    v = v + a * dt;\n    s = s + v * d"
      "t;\n    if s < 0\n        s = 0; v = -0.2 * v;   % cannot leave the top of the slope\n    end\nend\n\n% ---- hap"
      "tics gate (visual bounce unaffected) --------------------------------\nif hapt < 0.5\n    Fxh = [0 0]; Fyh = [0 "
      "0];\nend\nhand_forces(1) = Fxh(1); hand_forces(2) = Fyh(1);\nhand_forces(3) = Fxh(2); hand_forces(4) = Fyh(2);\n"
      "Fx = Fxh(1) + Fxh(2);               % total contact force, for the log\nFy = Fyh(1) + Fyh(2);\n\n% ---- VCODEs ("
      "subject display mock, lateral slope) ---------------------------\n% Rows: 1 flat run-out (darkest), 2-5 slope ba"
      "r (4 shaded segments, lightest\n% at the top), 6 slope-foot tick, 7 home ring (hollow; green when the hand is\n%"
      " inside the home target), 8 ball (yellow; flashes white during contact),\n% 9 ball highlight. Track and ring are"
      " always visible; the ball exists only\n% during RELEASE_WAIT/ROLLING (phase > 0). The home target's filled circl"
      "e is\n% suppressed in the protocol via VisRadius = 0 (LogRadius still defines the\n% logical zone and this ring'"
      "s radius).\nshow = 0;\nif phase > 0.5; show = 1; end\n\nringr = Target_Table(hr, 4) * 0.01;\nif ringr <= 0; ring"
      "r = 0.015; end\n\nfootx = tx + ux * Lslope;  footy = ty + uy * Lslope;\nflat_len = (dd - ringr - 0.005) - Lslope"
      ";\nif flat_len < 0; flat_len = 0; end\n\nbarw = 0.02;\n\nvcodes(1, 1)  = 4;                 % flat run-out: foot"
      " -> ring edge\nvcodes(1, 2)  = 1;\nvcodes(1, 3)  = footx;\nvcodes(1, 4)  = footy;\nvcodes(1, 5)  = 3158064;     "
      "      % 0x303030\nvcodes(1, 6)  = 3158064;\nvcodes(1, 7)  = barw;\nvcodes(1, 9)  = 100;\nvcodes(1, 10) = ux * fl"
      "at_len;\nvcodes(1, 11) = uy * flat_len;\n\nsegc = [5921370 5197647 4473924 3750201];   % 0x5A5A5A -> 0x393939\ns"
      "eg  = Lslope / 4;\nfor i = 1:4\n    vcodes(1+i, 1)  = 4;\n    vcodes(1+i, 2)  = 1;\n    vcodes(1+i, 3)  = tx + u"
      "x * seg * (i - 1);\n    vcodes(1+i, 4)  = ty + uy * seg * (i - 1);\n    vcodes(1+i, 5)  = segc(i);\n    vcodes(1"
      "+i, 6)  = segc(i);\n    vcodes(1+i, 7)  = barw;\n    vcodes(1+i, 9)  = 100;\n    vcodes(1+i, 10) = ux * seg;\n  "
      "  vcodes(1+i, 11) = uy * seg;\nend\n\npx = -uy; py = ux;                 % slope-foot tick, perpendicular to rai"
      "l\nvcodes(6, 1)  = 4;\nvcodes(6, 2)  = 1;\nvcodes(6, 3)  = footx - px * 0.014;\nvcodes(6, 4)  = footy - py * 0.0"
      "14;\nvcodes(6, 5)  = 13158600;          % 0xC8C8C8\nvcodes(6, 6)  = 13158600;\nvcodes(6, 7)  = 0.0025;\nvcodes(6"
      ", 9)  = 100;\nvcodes(6, 10) = px * 0.028;\nvcodes(6, 11) = py * 0.028;\n\nringc = 16777215;                  % w"
      "hite; green while the hand is at home\nif hand_in(hr) > 0.5\n    ringc = 3066993;               % 0x2ECC71\nend\n"
      "vcodes(7, 1)  = 1;                 % home ring (hollow circle)\nvcodes(7, 2)  = 1;\nvcodes(7, 3)  = hx0;\nvcodes"
      "(7, 4)  = hy0;\nvcodes(7, 5)  = 16777216;          % no fill\nvcodes(7, 6)  = ringc;\nvcodes(7, 7)  = 0.003;\nvc"
      "odes(7, 9)  = 100;\nvcodes(7, 10) = ringr;\n\nbx = tx + ux * s; by = ty + uy * s;\nballc = 16106818;            "
      "      % 0xF5C542 yellow\nhilc  = 16774080;                  % 0xFFF3C0 warm white highlight\nif pen > 0\n    bal"
      "lc = 16777215;              % contact flash: white ball,\n    hilc  = 16113824;              % 0xF5E0A0 pale yel"
      "low highlight\nend\nvcodes(8, 1)  = 1;                 % ball\nvcodes(8, 2)  = show;\nvcodes(8, 3)  = bx;\nvcode"
      "s(8, 4)  = by;\nvcodes(8, 5)  = ballc;\nvcodes(8, 6)  = -2147483648;       % no stroke colour\nvcodes(8, 7)  = 0"
      ";\nvcodes(8, 9)  = 100;\nvcodes(8, 10) = r_b;\n\nvcodes(9, 1)  = 1;                 % highlight, upper-left of t"
      "he ball centre\nvcodes(9, 2)  = show;\nvcodes(9, 3)  = bx - 0.35 * r_b;\nvcodes(9, 4)  = by + 0.35 * r_b;\nvcode"
      "s(9, 5)  = hilc;\nvcodes(9, 6)  = -2147483648;\nvcodes(9, 7)  = 0;\nvcodes(9, 9)  = 100;\nvcodes(9, 10) = 0.3 * "
      "r_b;\n\nif s > dd + 0.6\n    vcodes(8, 2) = 0;              % rolled far out of the scene\n    vcodes(9, 2) = 0;"
      "\nend\n\nball_log  = [bx; by; v; pen; Fx; Fy; phase; s];\npen_out   = pen;\nspeed_out = v;\nif speed_out < 0; sp"
      "eed_out = -speed_out; end\n"
      editorLayout	      "100 M4x1[205 227 1080 733]"
    }
  }
